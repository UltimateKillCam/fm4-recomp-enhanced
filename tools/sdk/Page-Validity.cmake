# Page-valid publication overlay. Modified 2026-10-24. GPL-3.0-only.
# Serialize publication with bitmap writers because the staged validity copy,
# active-buffer exchange, and dirty reset form one shared-memory transaction.
# The pinned SDK source is read and overlaid only in CMake's build directory.
if(NOT WIN32 OR NOT TARGET rexgpu-xenos)
  return()
endif()
set(fm4_page_valid_source "${CMAKE_SOURCE_DIR}/src/graphics/shared_memory.cpp")
if(NOT EXISTS "${fm4_page_valid_source}")
  message(FATAL_ERROR "Pinned shared_memory.cpp is missing")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${fm4_page_valid_source}")
file(READ "${fm4_page_valid_source}" fm4_page_valid_text)
string(REPLACE "\r\n" "\n" fm4_page_valid_text "${fm4_page_valid_text}")
string(SHA256 fm4_page_valid_source_sha "${fm4_page_valid_text}")
if(NOT fm4_page_valid_source_sha STREQUAL "d1d04b95c172cc1a8a1b2c1216a62e27e6cd60193f46a38f1ee57ebbf233146f")
  message(FATAL_ERROR "Page-valid overlay source hash does not match reviewed pinned SDK source")
endif()
set(fm4_page_valid_anchor "void SharedMemory::SetSystemPageBlocksValidWithGpuDataWritten() {")
string(FIND "${fm4_page_valid_text}" "${fm4_page_valid_anchor}" fm4_page_valid_at)
if(fm4_page_valid_at LESS 0)
  message(FATAL_ERROR "Page-valid publication method anchor not found")
endif()
string(LENGTH "${fm4_page_valid_text}" fm4_page_valid_text_length)
string(LENGTH "${fm4_page_valid_anchor}" fm4_page_valid_anchor_length)
math(EXPR fm4_page_valid_tail_start "${fm4_page_valid_at}+${fm4_page_valid_anchor_length}")
math(EXPR fm4_page_valid_tail_length "${fm4_page_valid_text_length}-${fm4_page_valid_tail_start}")
string(SUBSTRING "${fm4_page_valid_text}" 0 ${fm4_page_valid_at} fm4_page_valid_head)
string(SUBSTRING "${fm4_page_valid_text}" ${fm4_page_valid_tail_start} ${fm4_page_valid_tail_length} fm4_page_valid_tail)
string(FIND "${fm4_page_valid_tail}" "${fm4_page_valid_anchor}" fm4_page_valid_duplicate_anchor)
if(NOT fm4_page_valid_duplicate_anchor LESS 0)
  message(FATAL_ERROR "Page-valid publication method anchor is ambiguous")
endif()
set(fm4_page_valid_replaced "${fm4_page_valid_head}${fm4_page_valid_anchor}
  auto global_lock = global_critical_region_.Acquire();${fm4_page_valid_tail}")
set(fm4_page_valid_overlay "${CMAKE_BINARY_DIR}/fm4-page-valid/shared_memory.cpp")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/fm4-page-valid")
if(EXISTS "${fm4_page_valid_overlay}")
  file(READ "${fm4_page_valid_overlay}" fm4_page_valid_old)
else()
  set(fm4_page_valid_old "")
endif()
if(NOT fm4_page_valid_old STREQUAL fm4_page_valid_replaced)
  file(WRITE "${fm4_page_valid_overlay}" "${fm4_page_valid_replaced}")
endif()
get_target_property(fm4_page_valid_target_source_dir rexgpu-xenos SOURCE_DIR)
get_target_property(fm4_page_valid_sources rexgpu-xenos SOURCES)
set(fm4_page_valid_result)
set(fm4_page_valid_replaced_count 0)
foreach(fm4_entry IN LISTS fm4_page_valid_sources)
  if(IS_ABSOLUTE "${fm4_entry}")
    get_filename_component(fm4_entry_abs "${fm4_entry}" ABSOLUTE)
  else()
    get_filename_component(fm4_entry_abs "${fm4_page_valid_target_source_dir}/${fm4_entry}" ABSOLUTE)
  endif()
  get_filename_component(fm4_target_abs "${fm4_page_valid_source}" ABSOLUTE)
  if(fm4_entry_abs STREQUAL fm4_target_abs)
    math(EXPR fm4_page_valid_replaced_count "${fm4_page_valid_replaced_count}+1")
  else()
    list(APPEND fm4_page_valid_result "${fm4_entry}")
  endif()
endforeach()
if(NOT fm4_page_valid_replaced_count EQUAL 1)
  message(FATAL_ERROR "Expected exactly one rexgpu-xenos shared_memory.cpp source; found ${fm4_page_valid_replaced_count}")
endif()
list(APPEND fm4_page_valid_result "${fm4_page_valid_overlay}")
set_property(TARGET rexgpu-xenos PROPERTY SOURCES "${fm4_page_valid_result}")


