# Direct original-content mounts; the default build is unchanged.
if(NOT WIN32 OR NOT TARGET rexruntime)
  return()
endif()
find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(dlc_input "${CMAKE_SOURCE_DIR}/src/system/xam/content_manager.cpp")
set(dlc_output "${CMAKE_BINARY_DIR}/fm4-dlc/content_manager.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${dlc_input}" "${CMAKE_CURRENT_LIST_DIR}/prepare_dlc_runtime.py")
execute_process(COMMAND "${Python3_EXECUTABLE}"
  "${CMAKE_CURRENT_LIST_DIR}/prepare_dlc_runtime.py" "${dlc_input}" "${dlc_output}"
  COMMAND_ERROR_IS_FATAL ANY)
get_target_property(dlc_sources rexruntime SOURCES)
list(FIND dlc_sources "${dlc_input}" dlc_index)
if(dlc_index LESS 0)
  list(FIND dlc_sources "xam/content_manager.cpp" dlc_index)
endif()
if(dlc_index LESS 0)
  message(FATAL_ERROR "Expected the pinned content-manager source")
endif()
list(REMOVE_AT dlc_sources ${dlc_index})
list(APPEND dlc_sources "${dlc_output}")
set_property(TARGET rexruntime PROPERTY SOURCES "${dlc_sources}")
# STFS entries share host streams across independent guest file handles. Keep
# each seek/read sequence together across those handles.
set(dlc_read_input "${CMAKE_SOURCE_DIR}/src/filesystem/devices/stfs_container_file.cpp")
file(READ "${dlc_read_input}" dlc_read_source)
string(REPLACE "\r\n" "\n" dlc_read_source "${dlc_read_source}")
set(dlc_read_anchor "  if (byte_offset >= entry_->size()) {")
string(FIND "${dlc_read_source}" "${dlc_read_anchor}" dlc_read_at)
if(dlc_read_at LESS 0)
  message(FATAL_ERROR "Expected the pinned STFS read entry")
endif()
string(REPLACE "#include <cmath>" "#include <cmath>\n#include <mutex>" dlc_read_source "${dlc_read_source}")
string(REPLACE "${dlc_read_anchor}" "  static std::mutex container_reads;\n  std::lock_guard read_lock(container_reads);\n${dlc_read_anchor}" dlc_read_source "${dlc_read_source}")
set(dlc_read_output "${CMAKE_BINARY_DIR}/fm4-dlc/stfs_container_file.cpp")
set(dlc_read_previous "")
if(EXISTS "${dlc_read_output}")
  file(READ "${dlc_read_output}" dlc_read_previous)
endif()
if(NOT dlc_read_previous STREQUAL dlc_read_source)
  file(WRITE "${dlc_read_output}" "${dlc_read_source}")
endif()
get_target_property(dlc_fs_sources rexfilesystem SOURCES)
list(FIND dlc_fs_sources "devices/stfs_container_file.cpp" dlc_read_index)
if(dlc_read_index LESS 0)
  list(FIND dlc_fs_sources "${dlc_read_input}" dlc_read_index)
endif()
if(dlc_read_index LESS 0)
  message(FATAL_ERROR "Expected one STFS file source")
endif()
list(REMOVE_AT dlc_fs_sources ${dlc_read_index})
list(APPEND dlc_fs_sources "${dlc_read_output}")
set_property(TARGET rexfilesystem PROPERTY SOURCES "${dlc_fs_sources}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${dlc_read_input}")
