+      REXGPU_INFO("FM4 original texture dumped: {} native_mips={}", identity, dumped_mips);
+    if (identity == texture.override_identity_) return;
+    texture.override_identity_ = identity;
+    if (!bindless_resources_used_) return;
+    int selected = -1;
+    for (size_t i = 0; i < texture.overrides_.size(); ++i)
+      if (texture.overrides_[i]->identity == identity) selected = int(i);
+    if (selected < 0 && texture.overrides_.size() < 4 && override_loader_) {
+      auto resident = override_resident_.find(identity);
+      auto replacement = resident != override_resident_.end() ? resident->second.lock() : nullptr;
+      if (replacement) {
+        selected = int(texture.overrides_.size());
+        texture.overrides_.push_back(std::move(replacement));
+        texture.AccountOverrideMemory();
+      } else if (override_loader_->Contains(identity) && !override_failed_.contains(identity)) {
+        if (!texture.override_handle_) {
+          uint64_t handle = next_override_handle_++;
+          override_targets_.emplace(handle, &texture);
+          texture.override_handle_ = handle;
+        }
+        // One request serves every texture currently waiting for this identity.
+        auto [waiters, inserted] = override_waiters_.try_emplace(identity);
+        bool queued = true;
+        try {
+          auto& handles = waiters->second;
+          if (std::find(handles.begin(), handles.end(), texture.override_handle_) == handles.end())
+            handles.push_back(texture.override_handle_);
+          if (inserted)
+            queued = override_loader_->Queue(identity, width, height, format);
+        } catch (...) {
+          if (inserted) override_waiters_.erase(waiters);
+          throw;
+        }
+        if (!queued) {
+          override_waiters_.erase(waiters);
+          override_failed_.insert(identity);
+        } else {
+          // A reused texture shows its guest data, not an earlier image, until the load ends.
+          SelectTextureOverride(texture, -1);
+          return;
+        }
+      }
+    }
+    SelectTextureOverride(texture, selected);
+  } catch (...) { REXGPU_WARN("FM4 optional texture conversion skipped after an error"); }
+}
+
+void D3D12TextureCache::SelectTextureOverride(D3D12Texture& texture, int selected) {
+  if (selected == texture.override_index_) return;
+  texture.override_index_ = selected;
+  ++texture.override_generation_;
+  UpdateTextureBindingsImpl(UINT32_MAX);
+}
+
+void D3D12TextureCache::DrainTextureOverrides() {
+  if (!override_loader_) return;
+  try {
+    fm4::textures::Loader::Completed completed;
+    while (override_drain_remaining_ && override_loader_->TryPop(completed)) {
+      --override_drain_remaining_;
+      auto waiters = override_waiters_.find(completed.identity);
+      if (waiters == override_waiters_.end()) continue;
+      auto handles = std::move(waiters->second);
+      override_waiters_.erase(waiters);
+      if (!completed.replacement) {
+        override_failed_.insert(completed.identity);
+        for (uint64_t handle : handles) {
+          auto target = override_targets_.find(handle);
+          if (target != override_targets_.end() &&
+              target->second->override_identity_ == completed.identity)
+            SelectTextureOverride(*target->second, -1);
+        }
+        continue;
+      }
+      std::vector<D3D12Texture*> targets;
+      for (uint64_t handle : handles) {
+        auto target = override_targets_.find(handle);
+        if (target == override_targets_.end()) continue;
+        auto& texture = *target->second;
+        if (texture.override_identity_ != completed.identity || texture.overrides_.size() >= 4)
+          continue;
+        texture.overrides_.reserve(texture.overrides_.size() + 1);
+        targets.push_back(&texture);
+      }
+      if (targets.empty()) continue;
+      auto& replacement = completed.replacement;
+      override_resident_[completed.identity] = replacement;
+      auto& list = command_processor_.GetDeferredCommandList();
+      for (uint32_t mip = 0; mip < replacement->mip_count; ++mip) {
+        D3D12_TEXTURE_COPY_LOCATION src{}, dst{};
+        src.pResource = replacement->upload.Get(); src.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+        src.PlacedFootprint = replacement->layouts[mip];
+        dst.pResource = replacement->resource.Get(); dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        dst.SubresourceIndex = mip;
+        list.D3DCopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
+      }
+      command_processor_.PushTransitionBarrier(replacement->resource.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+          D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+      command_processor_.SubmitBarriers();
+      // Copies also use the texture, even when no draw currently binds it.
+      for (auto* texture : targets) {
+        texture->MarkAsUsed();
+        int selected = int(texture->overrides_.size());
+        texture->overrides_.push_back(replacement);
+        texture->AccountOverrideMemory();
+        SelectTextureOverride(*texture, selected);
+      }
+      const auto key = targets.front()->key();
+      const auto desc = replacement->resource->GetDesc();
+      REXGPU_INFO("FM4 texture replacement loaded: {} ({}x{} -> {}x{})", completed.identity,
+                  key.GetWidth(), key.GetHeight(), desc.Width, desc.Height);
+    }
+  } catch (...) { REXGPU_WARN("FM4 optional texture completion skipped after an error"); }
+}
