+  void* GetBacking(SurfaceId surface) const;
+  bool Find(const SurfaceKey& key, SurfaceId& surface_out) const;
+  bool Transition(SurfaceId surface, D3D12_RESOURCE_STATES state);
+  Result ApplyResolveClear(const draw_util::ResolveInfo& info,
+                           AliasCache& aliases, const TilingState& tiling);
