+// Each snapshot is immutable after its producer submission. Demand work uses
+// private command recording and a separate queue, including when the fault is
+// on the CP thread itself (for example WAIT_REG_MEM or a native memcpy).
+struct ResolveReadbackSnapshot {
+  Microsoft::WRL::ComPtr<ID3D12Device> device;
+  Microsoft::WRL::ComPtr<ID3D12Resource> source;
+  Microsoft::WRL::ComPtr<ID3D12Fence> producer_fence;
+  Microsoft::WRL::ComPtr<ID3D12RootSignature> root_signature;
+  Microsoft::WRL::ComPtr<ID3D12PipelineState> pipeline;
+  uint64_t producer_submission;
+  uint32_t length;
+  uint32_t source_length;
+  std::array<uint32_t, 5> constants;
+
+  std::vector<uint8_t> Download() const {
+    using Microsoft::WRL::ComPtr;
+    ComPtr<ID3D12CommandQueue> queue;
+    ComPtr<ID3D12CommandAllocator> allocator;
+    ComPtr<ID3D12GraphicsCommandList> list;
+    ComPtr<ID3D12Fence> fence;
+    ComPtr<ID3D12Resource> readback, downscale;
+    ComPtr<ID3D12DescriptorHeap> descriptors;
+    D3D12_COMMAND_QUEUE_DESC queue_desc = {};
+    queue_desc.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+    if (FAILED(device->CreateCommandQueue(&queue_desc, IID_PPV_ARGS(&queue))) ||
+        FAILED(device->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT,
+                                               IID_PPV_ARGS(&allocator))) ||
+        FAILED(device->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, allocator.Get(),
+                                          nullptr, IID_PPV_ARGS(&list))) ||
+        FAILED(device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&fence)))) {
+      return {};
+    }
+    D3D12_RESOURCE_DESC desc;
+    ui::d3d12::util::FillBufferResourceDesc(desc, length, D3D12_RESOURCE_FLAG_NONE);
+    if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesReadback,
+        D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+        IID_PPV_ARGS(&readback)))) {
+      return {};
+    }
+    ID3D12Resource* copy_source = source.Get();
+    if (pipeline) {
+      desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+      if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesDefault,
+          D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+          IID_PPV_ARGS(&downscale)))) {
+        return {};
+      }
+      D3D12_DESCRIPTOR_HEAP_DESC heap_desc = {};
+      heap_desc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+      heap_desc.NumDescriptors = 2;
+      heap_desc.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+      if (FAILED(device->CreateDescriptorHeap(&heap_desc, IID_PPV_ARGS(&descriptors)))) {
+        return {};
+      }
+      UINT stride = device->GetDescriptorHandleIncrementSize(heap_desc.Type);
+      auto cpu = descriptors->GetCPUDescriptorHandleForHeapStart();
+      auto gpu = descriptors->GetGPUDescriptorHandleForHeapStart();
+      ui::d3d12::util::CreateBufferRawSRV(device.Get(), cpu, source.Get(), source_length);
+      cpu.ptr += stride;
+      ui::d3d12::util::CreateBufferRawUAV(device.Get(), cpu, downscale.Get(), length);
+      ID3D12DescriptorHeap* heaps[] = {descriptors.Get()};
+      list->SetDescriptorHeaps(1, heaps);
+      list->SetPipelineState(pipeline.Get());
+      list->SetComputeRootSignature(root_signature.Get());
+      list->SetComputeRoot32BitConstants(0, UINT(constants.size()), constants.data(), 0);
+      list->SetComputeRootDescriptorTable(1, gpu);
+      gpu.ptr += stride;
+      list->SetComputeRootDescriptorTable(2, gpu);
+      list->Dispatch((length + 1023) / 1024, 1, 1);
+      D3D12_RESOURCE_BARRIER barrier = {};
+      barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+      barrier.Transition.pResource = downscale.Get();
+      barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+      barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+      barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+      list->ResourceBarrier(1, &barrier);
+      copy_source = downscale.Get();
+    }
+    list->CopyBufferRegion(readback.Get(), 0, copy_source, 0, length);
+    if (FAILED(list->Close()) ||
+        FAILED(queue->Wait(producer_fence.Get(), producer_submission))) {
+      return {};
+    }
+    HANDLE event = CreateEvent(nullptr, FALSE, FALSE, nullptr);
+    if (!event) {
+      return {};
+    }
+    ID3D12CommandList* lists[] = {list.Get()};
+    queue->ExecuteCommandLists(1, lists);
+    if (FAILED(queue->Signal(fence.Get(), 1)) ||
+        FAILED(fence->SetEventOnCompletion(1, event)) ||
+        WaitForSingleObject(event, INFINITE) != WAIT_OBJECT_0 ||
+        fence->GetCompletedValue() == UINT64_MAX) {
+      std::abort();
+    }
+    CloseHandle(event);
+    void* mapping = nullptr;
+    D3D12_RANGE read_range = {0, length};
+    if (FAILED(readback->Map(0, &read_range, &mapping))) {
+      return {};
+    }
+    std::vector<uint8_t> bytes(length);
+    std::memcpy(bytes.data(), mapping, length);
+    D3D12_RANGE written_range = {0, 0};
+    readback->Unmap(0, &written_range);
+    return bytes;
+  }
+};
