+#include <thread>
+
 #include <catch2/catch_test_macros.hpp>
 
 #include <rex/cvar.h>
@@ -761,3 +766,202 @@ TEST_CASE("LookupHeapByType selects correct heap", "[memory][heap]") {
     // Should be vC0000000 heap
   }
 }
+
+namespace {
+
+
+struct DeferredWriteTestRange {
+  rex::memory::Memory& memory = GetTestMemory();
+  rex::memory::BaseHeap* heap = MutableHeap(memory.LookupHeap(0xA0000000));
+  uint32_t guest = 0;
+  uint32_t physical = 0;
+  uint32_t page = uint32_t(rex::memory::page_size());
+
+  DeferredWriteTestRange() {
+    REQUIRE(heap->Alloc(0x10000, 0x10000,
+                        rex::memory::kMemoryAllocationReserve |
+                            rex::memory::kMemoryAllocationCommit,
+                        rex::memory::kMemoryProtectRead | rex::memory::kMemoryProtectWrite,
+                        true, &guest));
+    physical = memory.GetPhysicalAddress(guest);
+  }
+  ~DeferredWriteTestRange() {
+    memory.CompleteDeferredPhysicalWrites();
+    heap->Release(guest);
+  }
+  auto Provider(uint8_t byte, uint32_t pages, std::atomic<uint32_t>& calls) {
+    return [byte, length = pages * page, &calls] {
+      ++calls;
+      return std::vector<uint8_t>(length, byte);
+    };
+  }
+};
+
+}  // namespace
+
+TEST_CASE("Unrelated CPU writes leave deferred resolve guards intact", "[memory][deferred]") {
+  DeferredWriteTestRange range;
+  std::atomic<uint32_t> calls = 0;
+  range.memory.EnablePhysicalMemoryAccessCallbacks(range.physical, 3 * range.page, true, false);
+  REQUIRE(range.memory.DeferPhysicalWrite(range.physical, range.page, range.page,
+                                          range.Provider(0x47, 1, calls)));
+  auto unrelated = range.memory.TranslateVirtual<volatile uint8_t*>(range.guest + 2 * range.page);
+  *unrelated = 0x58;
+  CHECK(calls == 0);
+  CHECK(*range.memory.TranslateVirtual<volatile uint8_t*>(range.guest) == 0x47);
+  CHECK(calls == 1);
+}
+
+TEST_CASE("Deferred physical writes fault through physical and guest aliases",
+          "[memory][deferred]") {
+  DeferredWriteTestRange range;
+  std::atomic<uint32_t> calls = 0;
+  std::vector<uint8_t*> aliases = {
+      range.memory.TranslatePhysical(range.physical),
+      range.memory.TranslateVirtual(range.guest),
+      range.memory.TranslateVirtual(0xC0000000 + range.physical),
+      range.memory.TranslateVirtual(0xE0000000 + range.physical - 0x1000)};
+  for (auto alias : aliases) {
+    // Test each mapped host view independently, including views without a guest
+    // allocation in this test. Restore its original protection afterwards.
+    rex::memory::PageAccess original;
+    size_t length = range.page;
+    REQUIRE(rex::memory::QueryProtect(alias, length, original));
+    REQUIRE(rex::memory::Protect(alias, range.page, rex::memory::PageAccess::kReadWrite));
+    uint32_t before = calls;
+    REQUIRE(range.memory.DeferPhysicalWrite(range.physical, range.page, range.page,
+                                            range.Provider(0xA7, 1, calls)));
+    CHECK(calls == before);
+    CHECK(*reinterpret_cast<volatile uint8_t*>(alias) == 0xA7);
+    CHECK(calls == before + 1);
+    CHECK(range.memory.TranslatePhysical(range.physical)[range.page - 1] == 0xA7);
+    REQUIRE(rex::memory::Protect(alias, range.page, original));
+  }
+
+  SECTION("GPU writeback view at 7F aliases the low physical range") {
+    auto raw = range.memory.TranslatePhysical(0x8000);
+    std::vector<uint8_t> original(raw, raw + range.page);
+    REQUIRE(range.memory.DeferPhysicalWrite(0x8000, range.page, range.page,
+                                            range.Provider(0xB9, 1, calls)));
+    auto alias = range.memory.TranslateVirtual<volatile uint8_t*>(0x7F008000);
+    CHECK(*alias == 0xB9);
+    CHECK(range.memory.TranslatePhysical(0x8000)[range.page - 1] == 0xB9);
+    std::copy(original.begin(), original.end(), raw);
+  }
+}
+
+TEST_CASE("Unread resolve generations are replaced and partial overlaps are retained",
+          "[memory][deferred]") {
+  DeferredWriteTestRange range;
+  std::atomic<uint32_t> old_calls = 0, new_calls = 0;
+  REQUIRE(range.memory.DeferPhysicalWrite(range.physical, 2 * range.page, 2 * range.page,
+                                          range.Provider(0x11, 2, old_calls)));
+  REQUIRE(range.memory.DeferPhysicalWrite(range.physical, 2 * range.page, 2 * range.page,
+                                          range.Provider(0x22, 2, new_calls)));
+  CHECK(old_calls == 0);
+  CHECK(new_calls == 0);
+  REQUIRE(range.memory.DeferPhysicalWrite(range.physical + range.page, 2 * range.page,
+                                          2 * range.page, range.Provider(0x33, 2, old_calls)));
+  CHECK(new_calls == 1);
+  auto bytes = range.memory.TranslatePhysical(range.physical);
+  CHECK(bytes[0] == 0x22);
+  CHECK(*reinterpret_cast<volatile uint8_t*>(bytes + 2 * range.page) == 0x33);
+  CHECK(bytes[range.page] == 0x33);
+  CHECK(old_calls == 1);
+}
+
+TEST_CASE("CPU stores and allocation reuse drain deferred writes", "[memory][deferred]") {
+  DeferredWriteTestRange range;
+  std::atomic<uint32_t> calls = 0;
+  REQUIRE(range.memory.DeferPhysicalWrite(range.physical, range.page, range.page,
+                                          range.Provider(0x41, 1, calls)));
+  auto bytes = range.memory.TranslateVirtual<volatile uint8_t*>(range.guest);
+  bytes[0] = 0x52;
+  range.memory.CompleteDeferredPhysicalWrites();
+  CHECK(calls == 1);
+  CHECK(bytes[0] == 0x52);
+  CHECK(bytes[1] == 0x41);
+
+  REQUIRE(range.memory.DeferPhysicalWrite(range.physical, range.page, range.page,
+                                          range.Provider(0x63, 1, calls)));
+  REQUIRE(range.heap->Protect(range.guest, range.page,
+                              rex::memory::kMemoryProtectRead | rex::memory::kMemoryProtectWrite));
+  CHECK(calls == 2);
+  CHECK(bytes[0] == 0x63);
+}
+
+TEST_CASE("Deferred reads retain existing guest write invalidation", "[memory][deferred]") {
+  DeferredWriteTestRange range;
+  std::atomic<uint32_t> downloads = 0;
+  uint32_t invalidations = 0;
+  auto callback = [](void* context, uint32_t, uint32_t, bool) {
+    ++*static_cast<uint32_t*>(context);
+    return std::make_pair(0u, UINT32_MAX);
+  };
+  auto handle = range.memory.RegisterPhysicalMemoryInvalidationCallback(callback, &invalidations);
+  range.memory.EnablePhysicalMemoryAccessCallbacks(range.physical, range.page, true, false);
+  bool deferred = range.memory.DeferPhysicalWrite(range.physical, range.page, range.page,
+                                                 range.Provider(0x74, 1, downloads));
+  CHECK(deferred);
+  if (deferred) {
+    auto bytes = range.memory.TranslateVirtual<volatile uint8_t*>(range.guest);
+    CHECK(bytes[0] == 0x74);
+    CHECK(invalidations == 0);
+    bytes[0] = 0x85;
+    CHECK(invalidations != 0);
+    CHECK(bytes[0] == 0x85);
+  }
+  range.memory.UnregisterPhysicalMemoryInvalidationCallback(handle);
+}
+
+TEST_CASE("Late demand downloads cannot overwrite a newer generation or CPU store",
+          "[memory][deferred]") {
+  DeferredWriteTestRange range;
+  std::promise<void> entered, resume;
+  auto resumed = resume.get_future().share();
+  auto started = entered.get_future();
+  std::atomic<uint32_t> new_calls = 0;
+  REQUIRE(range.memory.DeferPhysicalWrite(range.physical, range.page, range.page, [&] {
+    entered.set_value();
+    resumed.wait();
+    return std::vector<uint8_t>(range.page, 0x96);
+  }));
+  uint8_t observed = 0;
+  std::thread reader([&] {
+    observed = *range.memory.TranslatePhysical<volatile uint8_t*>(range.physical);
+  });
+  started.wait();
+  bool replaced = range.memory.DeferPhysicalWrite(range.physical, range.page, range.page,
+                                                  range.Provider(0xA8, 1, new_calls));
+  // Always unblock and join, including if an expectation fails.
+  if (replaced) {
+    auto bytes = range.memory.TranslatePhysical<volatile uint8_t*>(range.physical);
+    CHECK(bytes[0] == 0xA8);
+    bytes[0] = 0xB9;
+  }
+  resume.set_value();
+  reader.join();
+  CHECK(replaced);
+  CHECK(new_calls == 1);
+  CHECK(observed == 0xB9);
+  CHECK(range.memory.TranslatePhysical(range.physical)[0] == 0xB9);
+}
+
+TEST_CASE("Native host access leases reject new read guards", "[memory][deferred]") {
+  DeferredWriteTestRange range;
+  std::atomic<uint32_t> calls = 0;
+  REQUIRE(range.memory.DeferPhysicalWrite(range.physical, range.page, range.page,
+                                          range.Provider(0xCA, 1, calls)));
+  {
+    auto lease = range.memory.BeginPhysicalMemoryHostAccess();
+    CHECK(calls == 1);
+    CHECK_FALSE(range.memory.DeferPhysicalWrite(range.physical, range.page, range.page,
+                                                range.Provider(0xDB, 1, calls)));
+  }
+  CHECK_FALSE(range.memory.DeferPhysicalWrite(range.physical + 1, range.page, range.page,
+                                              range.Provider(0xEC, 1, calls)));
+  REQUIRE(range.memory.DeferPhysicalWrite(range.physical, range.page, range.page,
+                                          range.Provider(0xFD, 1, calls)));
+  range.memory.CompleteDeferredPhysicalWrites();
+  CHECK(calls == 2);
+}
