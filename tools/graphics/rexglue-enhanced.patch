+bool PipelineCache::LoadShaderTranslation(D3D12Shader::D3D12Translation& translation) {
+  if (local_shader_cache_root_.empty()) {
+    return false;
+  }
+  auto data = ReadLocalCache(GetShaderTranslationPath(local_shader_cache_root_, translation));
+  // Binding metadata belongs to the shader, not an individual modification.
+  // Do not cache runtime UIDs or substitute bytecode without restoring bindings.
+  uint32_t header[3];
+  if (data.size() < sizeof(header)) {
+    return false;
+  }
+  std::memcpy(header, data.data(), sizeof(header));
+  if (header[0] > DxbcShader::kMaxTextureBindings || header[1] > DxbcShader::kMaxSamplerBindings ||
+      header[2] < 32) {
+    return false;
+  }
+  size_t texture_bytes = size_t(header[0]) * sizeof(DxbcShader::TextureBinding);
+  size_t sampler_bytes = size_t(header[1]) * sizeof(DxbcShader::SamplerBinding);
+  size_t binary_offset = sizeof(header) + texture_bytes + sampler_bytes;
+  if (binary_offset + uint64_t(header[2]) != data.size() ||
+      std::memcmp(data.data() + binary_offset, "DXBC", 4)) {
+    return false;
+  }
+  // Avoid constructing a bool from invalid bytes, even in a corrupt local file.
+  for (size_t i = 0; i < header[0]; ++i) {
+    if (data[sizeof(header) + i * sizeof(DxbcShader::TextureBinding) +
+             offsetof(DxbcShader::TextureBinding, is_signed)] > 1) {
+      return false;
+    }
+  }
+  std::vector<DxbcShader::TextureBinding> textures(header[0]);
+  std::vector<DxbcShader::SamplerBinding> samplers(header[1]);
+  if (texture_bytes) {
+    std::memcpy(textures.data(), data.data() + sizeof(header), texture_bytes);
+  }
+  if (sampler_bytes) {
+    std::memcpy(samplers.data(), data.data() + sizeof(header) + texture_bytes, sampler_bytes);
+  }
+  uint32_t texture_mask = 0;
+  for (const auto& binding : textures) {
+    if (binding.fetch_constant >= 32 || uint32_t(binding.dimension) > 3 ||
+        binding.bindless_descriptor_index >= header[0] + header[1]) {
+      return false;
+    }
+    texture_mask |= uint32_t(1) << binding.fetch_constant;
+  }
+  for (const auto& binding : samplers) {
+    if (binding.fetch_constant >= 32 ||
+        binding.bindless_descriptor_index >= header[0] + header[1] ||
+        uint32_t(binding.mag_filter) > 3 || uint32_t(binding.min_filter) > 3 ||
+        uint32_t(binding.mip_filter) > 3 || uint32_t(binding.aniso_filter) > 7) {
+      return false;
+    }
+  }
+  auto& shader = static_cast<D3D12Shader&>(translation.shader());
+  if (!shader.bindings_setup_entered_.test_and_set(std::memory_order_relaxed)) {
+    shader.texture_bindings_ = std::move(textures);
+    shader.sampler_bindings_ = std::move(samplers);
+    shader.used_texture_mask_ = texture_mask;
+  }
+  translation.translated_binary_.assign(data.begin() + binary_offset, data.end());
+  translation.is_valid_ = true;
+  translation.is_translated_ = true;
+  REXGPU_DEBUG("Restored shader {:016X} modification {:016X}", shader.ucode_data_hash(),
+               translation.modification());
+  return true;
+}
+
+void PipelineCache::StoreShaderTranslation(const D3D12Shader::D3D12Translation& translation) {
+  if (local_shader_cache_root_.empty()) {
+    return;
+  }
+  const auto& shader = static_cast<const D3D12Shader&>(translation.shader());
+  const auto& binary = translation.translated_binary();
+  const auto& textures = shader.GetTextureBindingsAfterTranslation();
+  const auto& samplers = shader.GetSamplerBindingsAfterTranslation();
+  size_t texture_bytes = textures.size() * sizeof(DxbcShader::TextureBinding);
+  size_t sampler_bytes = samplers.size() * sizeof(DxbcShader::SamplerBinding);
+  const uint32_t header[] = {uint32_t(textures.size()), uint32_t(samplers.size()),
+                             uint32_t(binary.size())};
+  size_t size = sizeof(header) + texture_bytes + sampler_bytes + binary.size();
+  if (size > kLocalCacheMaxBytes) {
+    return;
+  }
+  std::vector<uint8_t> data(size);
+  std::memcpy(data.data(), header, sizeof(header));
+  if (texture_bytes) {
+    std::memcpy(data.data() + sizeof(header), textures.data(), texture_bytes);
+  }
+  if (sampler_bytes) {
+    std::memcpy(data.data() + sizeof(header) + texture_bytes, samplers.data(), sampler_bytes);
+  }
+  std::memcpy(data.data() + sizeof(header) + texture_bytes + sampler_bytes, binary.data(),
+              binary.size());
+  QueueLocalCacheWrite(GetShaderTranslationPath(local_shader_cache_root_, translation),
+                       std::move(data));
+}
+
+void PipelineCache::QueueLocalCacheWrite(const std::filesystem::path& path,
+                                         std::vector<uint8_t> data) {
+  {
+    std::lock_guard<std::mutex> lock(storage_write_request_lock_);
+    // A cache miss must never build an unbounded backlog. Dropping a cache
+    // write is safe; a later run will translate/create it normally.
+    if (data.empty() || data.size() > kLocalCacheMaxBytes - storage_write_local_bytes_) {
+      return;
+    }
+    storage_write_local_bytes_ += data.size();
+    storage_write_local_queue_.push_back({path, std::move(data)});
+  }
+  storage_write_request_cond_.notify_one();
+}
