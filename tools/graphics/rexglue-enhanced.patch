+              "bridge_exports={} bridge_imports={} resolves={} fallbacks={} "
+              "prepare_read_calls={} prepare_read_us={} notify_write_calls={} notify_write_us={}",
+              native_render_targets_active_,
+              stats.converted_samples - native_last_alias_stats_.converted_samples,
+              stats.clear_converted_regions - native_last_alias_stats_.clear_converted_regions,
+              stats.bridge_exports - native_last_alias_stats_.bridge_exports,
+              stats.bridge_imports - native_last_alias_stats_.bridge_imports,
+              native_resolves_count_ - native_last_resolves_,
+              native_fallbacks_count_ - native_last_fallbacks_,
+              stats.prepare_read_calls - native_last_alias_stats_.prepare_read_calls,
+              stats.prepare_read_us - native_last_alias_stats_.prepare_read_us,
