+void D3D12TextureCache::D3D12Texture::AccountOverrideMemory() {
+  auto& cache = static_cast<D3D12TextureCache&>(texture_cache());
+  auto desc = resource_->GetDesc();
+  uint64_t total = cache.command_processor_.GetD3D12Provider().GetDevice()->GetResourceAllocationInfo(0, 1, &desc).SizeInBytes;
+  for (const auto& item : overrides_) total += item->accounted_bytes;
+  SetHostMemoryUsage(total);
+}
+
+void D3D12TextureCache::UpdateTextureOverride(D3D12Texture& texture) {
+  const auto key = texture.key();
+  DXGI_FORMAT format = DXGI_FORMAT_UNKNOWN;
+  switch (key.format) {
+    case xenos::TextureFormat::k_8_8_8_8:
+      if (key.mip_max_level > 0 && fm4::textures::RgbaEnabled()) format = DXGI_FORMAT_R8G8B8A8_UNORM;
+      break;
+    case xenos::TextureFormat::k_DXT1:
+    case xenos::TextureFormat::k_DXT1_AS_16_16_16_16: format = DXGI_FORMAT_BC1_UNORM; break;
+    case xenos::TextureFormat::k_DXT2_3:
+    case xenos::TextureFormat::k_DXT2_3_AS_16_16_16_16: format = DXGI_FORMAT_BC2_UNORM; break;
+    case xenos::TextureFormat::k_DXT4_5:
+    case xenos::TextureFormat::k_DXT4_5_AS_16_16_16_16: format = DXGI_FORMAT_BC3_UNORM; break;
+    default: break;
+  }
+  uint32_t block_bytes = fm4::textures::BlockBytes(format);
+  uint32_t block_width = fm4::textures::BlockWidth(format);
+  uint32_t width = key.GetWidth(), height = key.GetHeight();
+  // Only single-layer BC colour assets with an ordinary base level. Resolved
+  // surfaces, data formats, cubemaps and volume textures retain the guest path.
+  if (!block_bytes || key.scaled_resolve || !key.base_page ||
+      key.dimension != xenos::DataDimension::k2DOrStacked || key.GetDepthOrArraySize() != 1 ||
+      width < 64 || height < 64 || width > 2048 || height > 2048 ||
+      (width & 3) || (height & 3) || texture.guest_layout().packed_level == 0) return;
+  try {
+    uint32_t guest_size = texture.GetGuestBaseSize();
+    uint32_t address = key.base_page << 12;
+    if (!guest_size || uint64_t(address) + guest_size > SharedMemory::kBufferSize) return;
+    const uint8_t* guest = command_processor_.GuestMemoryForTextureMods().TranslatePhysical(address);
+    if (!guest) return;
+    const uint32_t row_pitch = texture.guest_layout().base.row_pitch_bytes;
+    const uint32_t endian_xor = key.endianness == xenos::Endian::k8in16 ? 1 :
+        key.endianness == xenos::Endian::k8in32 ? 3 : key.endianness == xenos::Endian::k16in32 ? 2 : 0;
+    std::vector<uint8_t> base(size_t(width / block_width) * (height / block_width) * block_bytes);
+    uint32_t b = block_bytes == 4 ? 2 : block_bytes == 8 ? 3 : 4;
+    for (uint32_t y = 0; y < height / block_width; ++y) for (uint32_t x = 0; x < width / block_width; ++x) {
+      uint32_t offset = key.tiled ? uint32_t(texture_util::GetTiledOffset2D(x, y, row_pitch / block_bytes, b)) : y * row_pitch + x * block_bytes;
+      if (uint64_t(offset) + block_bytes > guest_size) return;
+      size_t dest = (size_t(y) * (width / block_width) + x) * block_bytes;
+      for (uint32_t c = 0; c < block_bytes; ++c) base[dest + c] = guest[(offset + c) ^ endian_xor];
+    }
+    auto identity = fm4::textures::Identity(width, height, format, base);
+    const uint32_t dumped_mips = fm4::textures::Dump(identity, width, height, format, base,
+        [&](std::vector<uint8_t>& data) -> uint32_t {
+      if (!key.mip_max_level) return 1;
+      const auto& layout = texture.guest_layout();
+      const uint32_t mip_address = key.mip_page << 12;
+      const uint32_t mip_bytes = layout.mips_total_extent_bytes;
+      if (!mip_address || !mip_bytes || uint64_t(mip_address) + mip_bytes > SharedMemory::kBufferSize)
+        return 0;
+      const uint8_t* mip_guest = command_processor_.GuestMemoryForTextureMods().TranslatePhysical(mip_address);
+      if (!mip_guest) return 0;
+      for (uint32_t level = 1; level <= key.mip_max_level; ++level) {
+        const uint32_t stored_level = std::min(level, layout.packed_level);
+        const auto& stored = layout.mips[stored_level];
+        uint32_t ox = 0, oy = 0, oz = 0;
+        if (key.packed_mips && level >= layout.packed_level)
+          texture_util::GetPackedMipOffset(width, height, 1, key.format, level, ox, oy, oz);
+        if (oz || !stored.row_pitch_bytes) return 0;
+        const uint32_t bw = (std::max(width >> level, 1u) + block_width - 1) / block_width;
+        const uint32_t bh = (std::max(height >> level, 1u) + block_width - 1) / block_width;
+        const size_t begin = data.size();
+        data.resize(begin + size_t(bw) * bh * block_bytes);
+        for (uint32_t y = 0; y < bh; ++y) for (uint32_t x = 0; x < bw; ++x) {
+          const uint32_t local = key.tiled ? uint32_t(texture_util::GetTiledOffset2D(
+              x + ox, y + oy, stored.row_pitch_bytes / block_bytes, b)) :
+              (y + oy) * stored.row_pitch_bytes + (x + ox) * block_bytes;
+          const uint64_t offset = uint64_t(layout.mip_offsets_bytes[stored_level]) + local;
+          if (offset + block_bytes > mip_bytes) return 0;
+          for (uint32_t c = 0; c < block_bytes; ++c)
+            data[begin + (size_t(y) * bw + x) * block_bytes + c] = mip_guest[(offset + c) ^ endian_xor];
+        }
+      }
+      return key.mip_max_level + 1;
+    });
+    if (dumped_mips)
+      REXGPU_INFO("FM4 original texture dumped: {} native_mips={}", identity, dumped_mips);
+    if (identity == texture.override_identity_) return;
+    texture.override_identity_ = identity;
+    if (!bindless_resources_used_) return;
+    int selected = -1;
+    for (size_t i = 0; i < texture.overrides_.size(); ++i)
+      if (texture.overrides_[i]->identity == identity) selected = int(i);
+    if (selected < 0 && texture.overrides_.size() < 4 && override_loader_) {
+      auto resident = override_resident_.find(identity);
+      auto replacement = resident != override_resident_.end() ? resident->second.lock() : nullptr;
+      if (replacement) {
+        selected = int(texture.overrides_.size());
+        texture.overrides_.push_back(std::move(replacement));
+        texture.AccountOverrideMemory();
+      } else if (override_loader_->Contains(identity) && !override_failed_.contains(identity)) {
+        if (!texture.override_handle_) {
+          uint64_t handle = next_override_handle_++;
+          override_targets_.emplace(handle, &texture);
+          texture.override_handle_ = handle;
+        }
+        // One request serves every texture currently waiting for this identity.
+        auto [waiters, inserted] = override_waiters_.try_emplace(identity);
+        bool queued = true;
+        try {
+          auto& handles = waiters->second;
+          if (std::find(handles.begin(), handles.end(), texture.override_handle_) == handles.end())
+            handles.push_back(texture.override_handle_);
+          if (inserted)
+            queued = override_loader_->Queue(identity, width, height, format);
+        } catch (...) {
+          if (inserted) override_waiters_.erase(waiters);
+          throw;
+        }
+        if (!queued) {
+          override_waiters_.erase(waiters);
+          override_failed_.insert(identity);
+        } else {
+          // A reused texture shows its guest data, not an earlier image, until the load ends.
+          SelectTextureOverride(texture, -1);
+          return;
+        }
+      }
+    }
+    SelectTextureOverride(texture, selected);
+  } catch (...) { REXGPU_WARN("FM4 optional texture conversion skipped after an error"); }
+}
+
+void D3D12TextureCache::SelectTextureOverride(D3D12Texture& texture, int selected) {
+  if (selected == texture.override_index_) return;
+  texture.override_index_ = selected;
+  ++texture.override_generation_;
+  UpdateTextureBindingsImpl(UINT32_MAX);
+}
+
+void D3D12TextureCache::DrainTextureOverrides() {
+  if (!override_loader_) return;
+  try {
+    fm4::textures::Loader::Completed completed;
+    while (override_drain_remaining_ && override_loader_->TryPop(completed)) {
+      --override_drain_remaining_;
+      auto waiters = override_waiters_.find(completed.identity);
+      if (waiters == override_waiters_.end()) continue;
+      auto handles = std::move(waiters->second);
+      override_waiters_.erase(waiters);
+      if (!completed.replacement) {
+        override_failed_.insert(completed.identity);
+        for (uint64_t handle : handles) {
+          auto target = override_targets_.find(handle);
+          if (target != override_targets_.end() &&
+              target->second->override_identity_ == completed.identity)
+            SelectTextureOverride(*target->second, -1);
+        }
+        continue;
+      }
+      std::vector<D3D12Texture*> targets;
+      for (uint64_t handle : handles) {
+        auto target = override_targets_.find(handle);
+        if (target == override_targets_.end()) continue;
+        auto& texture = *target->second;
+        if (texture.override_identity_ != completed.identity || texture.overrides_.size() >= 4)
+          continue;
+        texture.overrides_.reserve(texture.overrides_.size() + 1);
+        targets.push_back(&texture);
+      }
+      if (targets.empty()) continue;
+      auto& replacement = completed.replacement;
+      override_resident_[completed.identity] = replacement;
+      auto& list = command_processor_.GetDeferredCommandList();
+      for (uint32_t mip = 0; mip < replacement->mip_count; ++mip) {
+        D3D12_TEXTURE_COPY_LOCATION src{}, dst{};
+        src.pResource = replacement->upload.Get(); src.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+        src.PlacedFootprint = replacement->layouts[mip];
+        dst.pResource = replacement->resource.Get(); dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        dst.SubresourceIndex = mip;
+        list.D3DCopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
+      }
+      command_processor_.PushTransitionBarrier(replacement->resource.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+          D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+      command_processor_.SubmitBarriers();
+      // Copies also use the texture, even when no draw currently binds it.
+      for (auto* texture : targets) {
+        texture->MarkAsUsed();
+        int selected = int(texture->overrides_.size());
+        texture->overrides_.push_back(replacement);
+        texture->AccountOverrideMemory();
+        SelectTextureOverride(*texture, selected);
+      }
+      const auto key = targets.front()->key();
+      const auto desc = replacement->resource->GetDesc();
+      REXGPU_INFO("FM4 texture replacement loaded: {} ({}x{} -> {}x{})", completed.identity,
+                  key.GetWidth(), key.GetHeight(), desc.Width, desc.Height);
+    }
+  } catch (...) { REXGPU_WARN("FM4 optional texture completion skipped after an error"); }
+}
