--- /dev/null
+++ b/include/rex/graphics/d3d12/native_rt/tiling_markers.h
@@ -0,0 +1,47 @@
+// Ordered FM4 full-scene tiling markers. GPL-3.0-only.
+#pragma once
+#include <array>
+#include <cstdint>
+
+namespace rex::graphics::d3d12::native_rt {
+constexpr uint32_t kTilingMarkerCookie = 0x464D3454;  // FM4T
+constexpr uint32_t kTilingMarkerVersion = 1;
+constexpr uint32_t kTilingMarkerPayloadWords = 11;
+constexpr uint32_t kTilingMarkerPacketBytes = 48;
+// PM4_NOP, eleven payload dwords, explicitly unpredicated.
+constexpr uint32_t kTilingMarkerPacketHeader = 0xC00A1000;
+enum class TilingMarkerType : uint32_t { kBegin = 1, kEnd = 2 };
+struct TilingMarker {
+  TilingMarkerType type = TilingMarkerType::kBegin;
+  uint64_t identity = 0;
+  uint32_t full_width = 1280;
+  uint32_t full_height = 720;
+  uint32_t last_band_top = 512;
+  uint32_t last_band_height = 208;
+  uint32_t max_band_height = 256;
+  uint32_t band_count = 3;
+};
+inline bool IsVerifiedTilingMarker(const TilingMarker& marker) {
+  return (marker.type == TilingMarkerType::kBegin || marker.type == TilingMarkerType::kEnd) &&
+      marker.identity && marker.full_width == 1280 && marker.full_height == 720 &&
+      marker.last_band_top == 512 && marker.last_band_height == 208 &&
+      marker.max_band_height == 256 && marker.band_count == 3;
+}
+inline std::array<uint32_t, kTilingMarkerPayloadWords> EncodeTilingMarker(
+    const TilingMarker& marker) {
+  return {kTilingMarkerCookie, kTilingMarkerVersion, uint32_t(marker.type),
+          uint32_t(marker.identity), uint32_t(marker.identity >> 32),
+          marker.full_width, marker.full_height, marker.last_band_top,
+          marker.last_band_height, marker.max_band_height, marker.band_count};
+}
+inline bool DecodeTilingMarker(const uint32_t* words, uint32_t count, TilingMarker& marker) {
+  if (count != kTilingMarkerPayloadWords || words[0] != kTilingMarkerCookie ||
+      words[1] != kTilingMarkerVersion) return false;
+  marker.type = TilingMarkerType(words[2]);
+  marker.identity = uint64_t(words[3]) | (uint64_t(words[4]) << 32);
+  marker.full_width = words[5]; marker.full_height = words[6];
+  marker.last_band_top = words[7]; marker.last_band_height = words[8];
+  marker.max_band_height = words[9]; marker.band_count = words[10];
+  return IsVerifiedTilingMarker(marker);
+}
+}  // namespace rex::graphics::d3d12::native_rt
