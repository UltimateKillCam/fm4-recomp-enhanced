+// Local files are disposable. Bound allocations and reject partial/corrupt files
+// before exposing bytecode or binding metadata to the renderer.
+constexpr size_t kLocalCacheMaxBytes = 64 * 1024 * 1024;
+constexpr uint64_t kLocalCacheMagic = 0x3145484341435852;
+
+std::vector<uint8_t> ReadLocalCache(const std::filesystem::path& path) {
+  std::vector<uint8_t> data;
+  FILE* file = rex::filesystem::OpenFile(path, "rb");
+  if (!file) {
+    return data;
+  }
+  uint64_t header[3];
+  if (fread(header, sizeof(header), 1, file) && header[0] == kLocalCacheMagic && header[1] &&
+      header[1] <= kLocalCacheMaxBytes) {
+    data.resize(size_t(header[1]));
+    if (fread(data.data(), data.size(), 1, file) != 1 || fgetc(file) != EOF || ferror(file) ||
+        XXH3_64bits(data.data(), data.size()) != header[2]) {
+      data.clear();
+    }
+  }
+  fclose(file);
+  return data;
+}
+
+void WriteLocalCache(const std::filesystem::path& path, const std::vector<uint8_t>& data) {
+  std::error_code error;
+  std::filesystem::create_directories(path.parent_path(), error);
+  if (error) {
+    return;
+  }
+  // The sole writer in each process owns its temporary filename. Publish only
+  // complete files, also when two instances populate the same cache.
+  auto temporary = path;
+  temporary += fmt::format(".{}.tmp", GetCurrentProcessId());
+  FILE* file = rex::filesystem::OpenFile(temporary, "wb");
+  if (!file) {
+    return;
+  }
+  const uint64_t header[] = {kLocalCacheMagic, uint64_t(data.size()),
+                             XXH3_64bits(data.data(), data.size())};
+  bool written = fwrite(header, sizeof(header), 1, file) == 1 &&
+                 fwrite(data.data(), data.size(), 1, file) == 1;
+  written = fclose(file) == 0 && written;
+  if (!written || !MoveFileExW(temporary.c_str(), path.c_str(), MOVEFILE_REPLACE_EXISTING)) {
+    std::filesystem::remove(temporary, error);
+  }
+}
+
+// Hash the actual module containing this code, including uncommitted translator,
+// built-in shader and root-signature changes. A git revision alone is insufficient
+// for locally modified SDK builds. Failure disables the local caches.
+uint64_t GetPipelineCacheModuleHash() {
+  static const int module_anchor = 0;
+  HMODULE module;
+  if (!GetModuleHandleExW(
+          GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+          reinterpret_cast<LPCWSTR>(&module_anchor), &module)) {
+    return 0;
+  }
+  wchar_t module_path[32768];
+  DWORD length = GetModuleFileNameW(module, module_path, DWORD(std::size(module_path)));
+  if (!length || length >= std::size(module_path)) {
+    return 0;
+  }
+  FILE* file = rex::filesystem::OpenFile(module_path, "rb");
+  if (!file) {
+    return 0;
+  }
+  XXH3_state_t hash;
+  XXH3_64bits_reset(&hash);
+  std::vector<uint8_t> buffer(64 * 1024);
+  size_t count;
+  while ((count = fread(buffer.data(), 1, buffer.size(), file)) != 0) {
+    XXH3_64bits_update(&hash, buffer.data(), count);
+  }
+  bool valid = !ferror(file);
+  fclose(file);
+  return valid ? XXH3_64bits_digest(&hash) : 0;
+}
