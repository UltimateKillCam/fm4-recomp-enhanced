+                     AliasCache& aliases, const TilingState& tiling);
+  // Called after the actual draw has been recorded, including query draws.
+  void CommitDraw(AliasCache& aliases);
+  // Publish deferred versions before readers or resource/lifetime changes.
+  // Metadata only; detach the batch before invoking alias notifications.
+  void FlushPendingWrites(AliasCache& aliases);
