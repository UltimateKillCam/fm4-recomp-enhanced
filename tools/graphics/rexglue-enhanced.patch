+uint32_t Memory::DeferredWritePhysicalAddress(const void* host_address) const {
+  if (deferred_physical_writes_.empty()) {
+    return UINT32_MAX;
+  }
+  auto address = reinterpret_cast<uintptr_t>(host_address);
+  uint64_t mask = ~uint64_t(system_allocation_granularity_ - 1);
+  for (size_t i = 0; i < rex::countof(map_info); ++i) {
+    uint64_t target = map_info[i].target_address & mask;
+    if (target < 0x100000000ull) {
+      continue;
+    }
