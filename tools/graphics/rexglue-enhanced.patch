+class ScopedCpuCounter final {
+ public:
+  ScopedCpuCounter(bool enabled, uint64_t& calls, uint64_t& microseconds,
+                   uint64_t& remainder_nanoseconds)
+      : enabled_(enabled), microseconds_(microseconds), remainder_(remainder_nanoseconds) {
+    if (enabled_) {
+      ++calls;
+      start_ = Clock::now();
+    }
+  }
+  ~ScopedCpuCounter() {
+    if (enabled_) {
+      const uint64_t nanoseconds = uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+          Clock::now() - start_).count()) + remainder_;
+      microseconds_ += nanoseconds / 1000;
+      remainder_ = nanoseconds % 1000;
+    }
+  }
+
+ private:
+  using Clock = std::chrono::steady_clock;
+  bool enabled_;
+  uint64_t& microseconds_;
+  uint64_t& remainder_;
+  Clock::time_point start_{};
+};
+
