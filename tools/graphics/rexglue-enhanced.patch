+  struct Copy { SurfaceId source; D3D12_BOX box; uint32_t x, y; };
+  struct Clear { Transfer::Rectangle rectangle; uint64_t value; };
+  static void AppendClear(std::vector<Clear>& clears, const Clear& clear) {
+    if (!clears.empty() && clears.back().value == clear.value) {
+      auto& previous = clears.back().rectangle;
+      const auto& next = clear.rectangle;
+      if (previous.x_pixels == next.x_pixels && previous.width_pixels == next.width_pixels &&
+          previous.y_pixels + previous.height_pixels == next.y_pixels) {
+        previous.height_pixels += next.height_pixels;
+        return;
+      }
+      if (previous.y_pixels == next.y_pixels && previous.height_pixels == next.height_pixels &&
+          previous.x_pixels + previous.width_pixels == next.x_pixels) {
+        previous.width_pixels += next.width_pixels;
+        return;
+      }
+    }
+    clears.push_back(clear);
+  }
+  static void AppendCopy(std::vector<Copy>& copies, const Copy& copy) {
+    if (!copies.empty() && copies.back().source == copy.source) {
+      auto& previous = copies.back();
+      const uint32_t width = previous.box.right - previous.box.left;
+      const uint32_t height = previous.box.bottom - previous.box.top;
+      if (previous.x == copy.x && previous.y + height == copy.y &&
+          previous.box.left == copy.box.left && previous.box.right == copy.box.right &&
+          previous.box.bottom == copy.box.top) {
+        previous.box.bottom = copy.box.bottom;
+        return;
+      }
+      if (previous.x + width == copy.x && previous.y == copy.y &&
+          previous.box.right == copy.box.left && previous.box.top == copy.box.top &&
+          previous.box.bottom == copy.box.bottom) {
+        previous.box.right = copy.box.right;
+        return;
+      }
+    }
+    copies.push_back(copy);
+  }
+  bool PlanClears(const SurfaceView& source, const SurfaceView& dest,
+                  const Range& range, std::vector<Clear>& clears) const {
+    if (!range.known_clear || range.first < dest.key.base_tiles) return false;
+    // Known clears retain guest bits, independent of the source host encoding.
+    // The existing destination resolve-clear helper decodes every supported
+    // format, including integer views and the selected gamma storage layout.
+    // Only the repeating word width needs adaptation across 32/64-bit formats.
+    bool src64 = !source.key.is_depth && xenos::IsColorRenderTargetFormat64bpp(
+        xenos::ColorRenderTargetFormat(source.key.resource_format));
+    bool dst64 = !dest.key.is_depth && xenos::IsColorRenderTargetFormat64bpp(
+        xenos::ColorRenderTargetFormat(dest.key.resource_format));
+    uint64_t value = range.clear_value;
+    if (src64 && !dst64 && uint32_t(value) != uint32_t(value >> 32)) return false;
+    if (!src64 && dst64) value = uint32_t(value) | (uint64_t(uint32_t(value)) << 32);
+    uint64_t pitch = Backing(dest.id)->key().GetPitchTiles();
+    if (!pitch) return false;
+    uint32_t width = (dst64 ? 40 : 80) >> uint32_t(dest.key.msaa_samples_log2 >= 2);
+    uint32_t height = 16 >> uint32_t(dest.key.msaa_samples_log2 >= 1);
+    std::vector<Clear> planned;
+    for (uint64_t tile = range.first; tile < range.end;) {
+      uint64_t relative = tile - dest.key.base_tiles;
+      uint64_t count = std::min(range.end - tile, pitch - relative % pitch);
+      uint64_t x = relative % pitch * width, y = relative / pitch * height;
+      if (x >= dest.extent.width || y >= dest.extent.height) return false;
+      AppendClear(planned, {{uint32_t(x), uint32_t(y),
+          uint32_t(std::min(count * width, uint64_t(dest.extent.width) - x)),
+          uint32_t(std::min(uint64_t(height), uint64_t(dest.extent.height) - y))}, value});
+      tile += count;
+    }
+    for (const auto& clear : planned) AppendClear(clears, clear);
+    return true;
+  }
+  bool PlanCopies(const SurfaceView& source, const SurfaceView& dest,
+                  Span span, std::vector<Copy>& copies) const {
+    if (source.key.is_depth || dest.key.is_depth || source.host_sample_count != 1 ||
+        dest.host_sample_count != 1 || source.key.msaa_samples_log2 || dest.key.msaa_samples_log2 ||
+        source.key.resource_format != dest.key.resource_format ||
+        source.key.scale_x != dest.key.scale_x || source.key.scale_y != dest.key.scale_y ||
+        source.resource->GetDesc().Format != dest.resource->GetDesc().Format ||
+        span.first < source.key.base_tiles || span.first < dest.key.base_tiles) return false;
+    uint64_t src_pitch = Backing(source.id)->key().GetPitchTiles();
+    uint64_t dst_pitch = Backing(dest.id)->key().GetPitchTiles();
+    if (!src_pitch || !dst_pitch) return false;
+    uint32_t tile_width = xenos::IsColorRenderTargetFormat64bpp(
+        xenos::ColorRenderTargetFormat(source.key.resource_format)) ? 40 : 80;
+    std::vector<Copy> planned;
+    for (uint64_t tile = span.first; tile < span.end;) {
+      uint64_t sr = tile - source.key.base_tiles, dr = tile - dest.key.base_tiles;
+      uint64_t count = std::min({span.end - tile, src_pitch - sr % src_pitch, dst_pitch - dr % dst_pitch});
+      uint64_t sx = sr % src_pitch * tile_width, sy = sr / src_pitch * 16;
+      uint64_t dx = dr % dst_pitch * tile_width, dy = dr / dst_pitch * 16;
+      if (dx >= dest.extent.width || dy >= dest.extent.height) return false;
+      uint64_t width = std::min(count * tile_width, uint64_t(dest.extent.width) - dx);
+      uint64_t height = std::min(uint64_t(16), uint64_t(dest.extent.height) - dy);
+      if (sx + width > source.extent.width || sy + height > source.extent.height) return false;
+      uint32_t scale_x = dest.key.scale_x, scale_y = dest.key.scale_y;
+      AppendCopy(planned, {source.id,
+        {uint32_t(sx * scale_x), uint32_t(sy * scale_y), 0,
+         uint32_t((sx + width) * scale_x), uint32_t((sy + height) * scale_y), 1},
+        uint32_t(dx * scale_x), uint32_t(dy * scale_y)});
+      tile += count;
+    }
+    for (const auto& copy : planned) AppendCopy(copies, copy);
+    return true;
+  }
+  struct Transaction {
+    uint64_t serial = 0;
+    std::vector<LegacySpan> spans;
+    std::map<uint32_t, RenderTargetCache::OwnershipRange> ownership;
+    struct Redirect { Key key; RenderTargetCache::RenderTarget* previous; bool existed; };
+    std::vector<Redirect> redirects;
+  } transaction;
+  D3D12RenderTargetCache& host;
+  SurfaceCache& surfaces;
+  RangeMap ranges;
+  std::map<SurfaceId, RangeMap> materialized_versions;
+  uint64_t next_version = 1, next_transaction = 1;
+  uint64_t collapsed_identity = 0;
+  bool failed = false;
+  AliasCache::Counters counters;
+  uint64_t prepare_read_remainder_ns = 0, notify_write_remainder_ns = 0;
+
+  Impl(D3D12RenderTargetCache& h, SurfaceCache& s) : host(h), surfaces(s) {}
+  Target* Backing(SurfaceId id) const {
+    return static_cast<Target*>(surfaces.GetBacking(id));
+  }
+  // Native identities don't wrap at 2048 tiles. This arithmetic deliberately
+  // stays wide, even though the existing shader bridge is physically bounded.
+  bool Spans(const SurfaceView& view, Rect r, std::vector<Span>& out) const {
+    if (r.left > r.right || r.top > r.bottom || r.right > view.extent.width ||
+        r.bottom > view.extent.height || !view.key.pitch_pixels ||
+        view.key.msaa_samples_log2 > 2) return false;
+    if (r.left == r.right || r.top == r.bottom) return true;
+    uint64_t samples_x = view.key.msaa_samples_log2 >= 2 ? 2 : 1;
+    uint64_t samples_y = view.key.msaa_samples_log2 >= 1 ? 2 : 1;
+    uint64_t words = !view.key.is_depth && xenos::IsColorRenderTargetFormat64bpp(
+        xenos::ColorRenderTargetFormat(view.key.resource_format)) ? 2 : 1;
+    uint64_t pitch = ((uint64_t(view.key.pitch_pixels) * samples_x + 79) / 80) * words;
+    uint64_t left = uint64_t(r.left) * samples_x * words / 80;
+    uint64_t right = (uint64_t(r.right) * samples_x * words + 79) / 80;
+    if (right > pitch) return false;
+    uint64_t top = uint64_t(r.top) * samples_y / 16;
+    uint64_t bottom = (uint64_t(r.bottom) * samples_y + 15) / 16;
+    if (!left && right == pitch) {
+      Span span{view.key.base_tiles + top * pitch, view.key.base_tiles + bottom * pitch};
+      if (!out.empty() && out.back().end == span.first) out.back().end = span.end;
+      else out.push_back(span);
+      return true;
+    }
+    for (uint64_t y = top; y < bottom; ++y) {
+      Span span{view.key.base_tiles + y * pitch + left,
+                view.key.base_tiles + y * pitch + right};
+      if (!out.empty() && out.back().end == span.first) out.back().end = span.end;
+      else out.push_back(span);
+    }
+    return true;
+  }
+  static bool SameContent(const Range& a, const Range& b) {
+    return a.domain == b.domain && a.owner == b.owner && a.version == b.version &&
+           a.depth_unorm == b.depth_unorm && a.depth_float == b.depth_float &&
+           a.known_clear == b.known_clear && (!a.known_clear || a.clear_value == b.clear_value);
+  }
+  static RangeMap::const_iterator FirstOverlap(const RangeMap& ranges, uint64_t domain,
+                                               uint64_t first) {
+    auto it = ranges.lower_bound({domain, first});
+    if (it != ranges.begin()) {
+      auto previous = std::prev(it);
+      if (previous->second.domain == domain && previous->second.end > first) it = previous;
+    }
+    return it;
+  }
+  static void AssignIn(RangeMap& ranges, const Range& replacement) {
+    if (REXCVAR_GET(d3d12_native_alias_reuse_nodes)) {
+      AssignIntervalReusingNodes(ranges, replacement, SameContent);
+      return;
+    }
+    if (replacement.first >= replacement.end) return;
+    auto it = ranges.lower_bound({replacement.domain, replacement.first});
+    if (it != ranges.begin()) {
+      auto previous = std::prev(it);
+      if (previous->second.domain == replacement.domain &&
+          previous->second.end > replacement.first) it = previous;
+    }
+    if (it != ranges.end() && it->second.domain == replacement.domain &&
+        it->second.first <= replacement.first && it->second.end >= replacement.end &&
+        SameContent(it->second, replacement)) return;
+    Range left{}, right{};
+    bool has_left = false, has_right = false;
+    while (it != ranges.end() && it->second.domain == replacement.domain &&
+           it->second.first < replacement.end) {
+      const Range old = it->second;
+      if (old.end <= replacement.first) { ++it; continue; }
+      if (old.first < replacement.first) {
+        left = old; left.end = replacement.first; has_left = true;
+      }
+      if (old.end > replacement.end) {
+        right = old; right.first = replacement.end; has_right = true;
+      }
+      it = ranges.erase(it);
+    }
+    if (has_left) ranges.emplace(std::make_pair(left.domain, left.first), left);
+    if (has_right) ranges.emplace(std::make_pair(right.domain, right.first), right);
+    auto inserted = ranges.emplace(std::make_pair(replacement.domain, replacement.first),
+                                    replacement).first;
+    if (inserted != ranges.begin()) {
+      auto previous = std::prev(inserted);
+      if (previous->second.end == inserted->second.first &&
+          SameContent(previous->second, inserted->second)) {
+        previous->second.end = inserted->second.end;
+        ranges.erase(inserted);
+        inserted = previous;
+      }
+    }
+    auto next = std::next(inserted);
+    if (next != ranges.end() && inserted->second.end == next->second.first &&
+        SameContent(inserted->second, next->second)) {
+      inserted->second.end = next->second.end;
+      ranges.erase(next);
+    }
+  }
+  void Assign(const Range& replacement) { AssignIn(ranges, replacement); }
+  std::vector<Range> Missing(SurfaceId destination, Range wanted) const {
+    std::vector<Range> result;
+    auto cached = materialized_versions.find(destination);
+    uint64_t cursor = wanted.first;
+    if (cached != materialized_versions.end()) {
+      for (auto it = FirstOverlap(cached->second, wanted.domain, cursor);
+           it != cached->second.end(); ++it) {
+        const auto& present = it->second;
+        if (present.domain != wanted.domain || present.first >= wanted.end) break;
+        if (present.end <= cursor || present.version != wanted.version) continue;
+        if (present.first > cursor) {
+          Range gap = wanted; gap.first = cursor; gap.end = present.first; result.push_back(gap);
+        }
+        cursor = std::min(wanted.end, present.end);
+      }
+    }
+    if (cursor < wanted.end) { wanted.first = cursor; result.push_back(wanted); }
+    return result;
+  }
+  bool Representable(const SurfaceView& view, const Span& span) const {
+    Target* target = Backing(view.id);
+    if (!target || span.first < view.key.base_tiles || span.end > xenos::kEdramTileCount ||
+        !view.key.scale_x || !view.key.scale_y ||
+        view.key.scale_x != host.draw_resolution_scale_x() ||
+        view.key.scale_y != host.draw_resolution_scale_y()) return false;
+    Key key = target->key();
+    return key.base_tiles == view.key.base_tiles && !key.unscaled;
+  }
+  bool LogicalRepresentable(const SurfaceView& view, const Span& span) const {
+    const auto* target = view.backend_target ? static_cast<const Target*>(view.backend_target) :
+                                              Backing(view.id);
+    if (!target || !view.resource || !view.key.scale_x || !view.key.scale_y ||
+        view.key.scale_x != host.draw_resolution_scale_x() ||
+        view.key.scale_y != host.draw_resolution_scale_y() ||
+        span.first < view.key.base_tiles || span.first >= span.end || span.end > UINT32_MAX)
+      return false;
+    const Key key = target->key();
+    const uint64_t pitch = key.GetPitchTiles();
+    if (!pitch || key.unscaled || key.base_tiles != view.key.base_tiles) return false;
+    const uint64_t width = xenos::kEdramTileWidthSamples >>
+        (uint32_t(key.msaa_samples >= xenos::MsaaSamples::k4X) + uint32_t(key.Is64bpp()));
+    const uint64_t height = xenos::kEdramTileHeightSamples >>
+        uint32_t(key.msaa_samples >= xenos::MsaaSamples::k2X);
+    const auto desc = view.resource->GetDesc();
+    for (uint64_t tile = span.first; tile < span.end;) {
+      const uint64_t relative = tile - view.key.base_tiles;
+      const uint64_t count = std::min(span.end - tile, pitch - relative % pitch);
+      if ((relative % pitch + count) * width > view.extent.width ||
+          (relative / pitch + 1) * height > view.extent.height ||
+          (relative % pitch + count) * width * view.key.scale_x > desc.Width ||
+          (relative / pitch + 1) * height * view.key.scale_y > desc.Height) return false;
+      tile += count;
+    }
+    return true;
+  }
+  bool SelfDepthRepresentable(const SurfaceView& view, const Span& span) const {
+    if (!LogicalRepresentable(view, span) ||
+        span.end - view.key.base_tiles > xenos::kEdramTileCount) return false;
+    const auto key = Backing(view.id)->key();
+    const uint64_t rows = (span.end - view.key.base_tiles + key.GetPitchTiles() - 1) /
+                          key.GetPitchTiles();
+    return rows * (xenos::kEdramTileHeightSamples >>
+                      uint32_t(key.msaa_samples >= xenos::MsaaSamples::k2X)) <=
+           (1u << (xenos::kResolveSizeBits - 1));
+  }
+  Result Unsupported(const SurfaceView& source, const SurfaceView& dest, Span span,
+                     const char* reason) const {
+    static uint32_t logged = 0;
+    if (logged++ < 24) {
+      REXGPU_ERROR("Native alias conversion unsupported: reason={} tiles=[{},{}) "
+                   "src={}/{}:{} pitch={} samples={} depth={} extent={}x{} "
+                   "dst={}/{}:{} pitch={} samples={} depth={} extent={}x{}",
+                   reason, span.first, span.end, source.id, source.key.base_tiles,
+                   source.key.resource_format, source.key.pitch_pixels,
+                   source.key.msaa_samples_log2, source.key.is_depth,
+                   source.extent.width, source.extent.height,
+                   dest.id, dest.key.base_tiles, dest.key.resource_format,
+                   dest.key.pitch_pixels, dest.key.msaa_samples_log2, dest.key.is_depth,
+                   dest.extent.width, dest.extent.height);
+    }
+    return Result::kNeedsLegacy;
+  }
+  void Restore() {
+    if (!transaction.serial) return;
+    for (const auto& redirect : transaction.redirects) {
+      if (redirect.existed) host.render_targets_[redirect.key] = redirect.previous;
+      else host.render_targets_.erase(redirect.key);
+    }
+    host.ownership_ranges_ = std::move(transaction.ownership);
+    transaction = {};
+    host.are_current_command_list_render_targets_valid_ = false;
+    host.are_accumulated_render_targets_valid_ = false;
+    surfaces.InvalidateBindings();
+  }
+};
+
+AliasCache::AliasCache(D3D12RenderTargetCache& host, SurfaceCache& surfaces)
+    : impl_(std::make_unique<Impl>(host, surfaces)) {}
+AliasCache::~AliasCache() { Shutdown(); }
+bool AliasCache::Initialize() { return true; }
+bool AliasCache::BeginCollapsedPass(const TilingMarker& marker) {
+  impl_->surfaces.FlushPendingWrites(*this);
+  if (impl_->failed || impl_->transaction.serial || impl_->collapsed_identity ||
+      marker.type != TilingMarkerType::kBegin || !IsVerifiedTilingMarker(marker)) return false;
+  impl_->collapsed_identity = marker.identity;
+  return true;
+}
+
+bool AliasCache::EndCollapsedPass(const TilingMarker& marker) {
+  Impl& i = *impl_;
+  i.surfaces.FlushPendingWrites(*this);
+  if (i.failed || i.transaction.serial || !i.collapsed_identity ||
+      marker.type != TilingMarkerType::kEnd || !IsVerifiedTilingMarker(marker) ||
+      marker.identity != i.collapsed_identity) return false;
+  struct Projection {
+    Impl::Range original;
+    SurfaceId destination;
+    SurfaceId depth_unorm = 0, depth_float = 0;
+    uint32_t source_y;
+    Rect rectangle;
+    uint64_t first, end;
+  };
+  std::vector<Impl::Range> private_ranges;
+  for (const auto& entry : i.ranges) {
+    const auto& range = entry.second;
+    if (i.surfaces.IsCollapsedDomain(range.domain)) private_ranges.push_back(range);
+  }
+  // Every globally published resource is ordinary domain-zero storage. This
+  // bounds private resource lifetime and keeps later normal aliases band-local.
+  std::map<SurfaceId, SurfaceId> canonical;
+  auto canonical_target = [&](SurfaceId source, SurfaceId& destination) {
+    if (!source) { destination = 0; return true; }
+    auto found = canonical.find(source);
+    if (found != canonical.end()) { destination = found->second; return true; }
+    SurfaceView view;
+    if (!i.surfaces.GetView(source, view) ||
+        !i.surfaces.IsCollapsedDomain(view.key.native_domain)) return false;
+    SurfaceKey key = view.key;
+    key.native_domain = 0;
+    if (i.surfaces.GetOrCreateGlobal(key, {key.pitch_pixels, marker.max_band_height},
+                                     *this, destination) != Result::kHandled) return false;
+    canonical.emplace(source, destination);
+    return true;
+  };
+  std::vector<Projection> projections;
+  // The final short band leaves the preceding band's tail in physical EDRAM.
+  // Plan that tail first, then the final band. Only actual final private writer
+  // fragments are projected, never every format key seen during the pass.
+  struct Slice { uint32_t source_y, destination_y, height; };
+  const Slice slices[] = {
+      {marker.last_band_top - marker.max_band_height + marker.last_band_height,
+       marker.last_band_height, marker.max_band_height - marker.last_band_height},
+      {marker.last_band_top, 0, marker.last_band_height}};
+  for (const auto& slice : slices) {
+    if (!slice.height) continue;
+    for (const auto& range : private_ranges) {
+      SurfaceView source;
+      if (!i.surfaces.GetView(range.owner, source)) { i.failed = true; return false; }
+      auto* backing = i.Backing(range.owner);
+      if (!backing) { i.failed = true; return false; }
+      const auto key = backing->key();
+      uint32_t pitch = key.GetPitchTiles();
+      uint32_t width = 80 >> (uint32_t(key.msaa_samples >= xenos::MsaaSamples::k4X) +
+                              uint32_t(key.Is64bpp()));
+      uint32_t height = 16 >> uint32_t(key.msaa_samples >= xenos::MsaaSamples::k2X);
+      if (!pitch || slice.source_y % height || slice.destination_y % height ||
+          slice.height % height || source.key.pitch_pixels % width ||
+          uint64_t(slice.source_y) + slice.height > source.extent.height) {
+        i.failed = true; return false;
+      }
+      uint64_t first = uint64_t(key.base_tiles) + uint64_t(slice.source_y / height) * pitch;
+      uint64_t end = first + uint64_t(slice.height / height) * pitch;
+      first = std::max(first, range.first);
+      end = std::min(end, range.end);
+      if (first >= end) continue;
+      SurfaceId destination, depth_unorm, depth_float;
+      if (!canonical_target(range.owner, destination) ||
+          !canonical_target(range.depth_unorm, depth_unorm) ||
+          !canonical_target(range.depth_float, depth_float)) { i.failed = true; return false; }
+      for (uint64_t tile = first; tile < end;) {
+        uint64_t relative = tile - key.base_tiles;
+        uint64_t count = std::min(end - tile, uint64_t(pitch) - relative % pitch);
+        uint32_t x = uint32_t(relative % pitch) * width;
+        uint32_t source_y = uint32_t(relative / pitch) * height;
+        uint32_t destination_y = source_y - slice.source_y + slice.destination_y;
+        uint64_t physical_first = uint64_t(key.base_tiles) +
+                                   uint64_t(destination_y / height) * pitch + relative % pitch;
+        if (physical_first + count > xenos::kEdramTileCount) { i.failed = true; return false; }
+        projections.push_back({range, destination, depth_unorm, depth_float, source_y,
+            {x, destination_y, x + uint32_t(count) * width, destination_y + height},
+            physical_first, physical_first + count});
+        tile += count;
+      }
+    }
+  }
+  auto project = [&](SurfaceId source, SurfaceId destination, const Projection& projection) {
+    if (!source) return true;
+    SurfaceView source_view, destination_view;
+    return i.surfaces.GetView(source, source_view) &&
+           i.surfaces.GetView(destination, destination_view) &&
+           ProjectSurface(source_view, destination_view, projection.source_y,
+                           projection.rectangle) == Result::kHandled;
+  };
+  // Execute every projection before publishing any global producer metadata.
+  for (const auto& projection : projections) {
+    if (projection.original.known_clear) {
+      RenderTargetCache::RenderTarget* target = i.Backing(projection.destination);
+      const std::vector<Impl::Transfer> empty;
+      const Impl::Transfer::Rectangle rectangle{
+          projection.rectangle.left, projection.rectangle.top,
+          projection.rectangle.right - projection.rectangle.left,
+          projection.rectangle.bottom - projection.rectangle.top};
+      if (!i.host.PerformTransfersAndResolveClears(
+              1, &target, &empty, &projection.original.clear_value, &rectangle)) {
+        i.failed = true; return false;
+      }
+      ++i.counters.clear_converted_regions;
+    } else if (!project(projection.original.owner, projection.destination, projection)) {
+      i.failed = true; return false;
+    }
+    if (projection.original.depth_unorm &&
+        projection.original.depth_unorm != projection.original.owner &&
+        !project(projection.original.depth_unorm, projection.depth_unorm, projection)) {
+      i.failed = true; return false;
+    }
+    if (projection.original.depth_float &&
+        projection.original.depth_float != projection.original.owner &&
+        projection.original.depth_float != projection.original.depth_unorm &&
+        !project(projection.original.depth_float, projection.depth_float, projection)) {
+      i.failed = true; return false;
+    }
+  }
+  for (const auto& projection : projections) {
+    Impl::Range published = projection.original;
+    published.first = projection.first;
+    published.end = projection.end;
+    published.owner = projection.destination;
+    published.depth_unorm = projection.depth_unorm;
+    published.depth_float = projection.depth_float;
+    published.version = i.next_version++;
+    published.domain = 0;
+    i.Assign(published);
+    Impl::AssignIn(i.materialized_versions[published.owner], published);
+  }
+  for (auto it = i.ranges.begin(); it != i.ranges.end();) {
+    if (i.surfaces.IsCollapsedDomain(it->second.domain)) it = i.ranges.erase(it);
+    else ++it;
+  }
+  for (auto it = i.materialized_versions.begin(); it != i.materialized_versions.end();) {
+    SurfaceView view;
+    if (i.surfaces.GetView(it->first, view) &&
+        i.surfaces.IsCollapsedDomain(view.key.native_domain)) it = i.materialized_versions.erase(it);
+    else ++it;
+  }
+  i.collapsed_identity = 0;
+  i.surfaces.InvalidateBindings();
+  return true;
+}
+void AliasCache::Shutdown() {
+  impl_->surfaces.FlushPendingWrites(*this);
+  impl_->Restore();
+  impl_->ranges.clear();
+  impl_->materialized_versions.clear();
+  impl_->failed = false;
+  impl_->collapsed_identity = 0;
+}
+void AliasCache::CompletedSubmissionUpdated() {}
+
+Result AliasCache::PrepareRead(SurfaceId destination, Rect rectangle) {
+  Impl& i = *impl_;
+  // Publish earlier draws outside this read's timing scope. NotifyWrite owns
+  // its own counter, and must never call back into this flush boundary.
+  i.surfaces.FlushPendingWrites(*this);
+  ScopedCpuCounter timing(fm4::frame_metrics::Get().enabled, i.counters.prepare_read_calls,
+                          i.counters.prepare_read_us, i.prepare_read_remainder_ns);
+  if (i.failed || i.transaction.serial) return Result::kFailed;
+  SurfaceView dest;
+  std::vector<Impl::Span> spans;
+  if (!i.surfaces.GetView(destination, dest) || !i.Spans(dest, rectangle, spans))
+    return Result::kFailed;
+  std::vector<Impl::Range> materialized;
+  std::vector<Impl::Transfer> transfers;
+  std::vector<Impl::Copy> copies;
+  std::vector<Impl::Clear> clears;
+  uint64_t converted_samples = 0;
+  for (const auto& span : spans) {
+    for (auto it = Impl::FirstOverlap(i.ranges, dest.key.native_domain, span.first);
+         it != i.ranges.end(); ++it) {
+      const auto& range = it->second;
+      if (range.domain != dest.key.native_domain || range.first >= span.end) break;
+      if (range.owner == destination) continue;
+      Impl::Range wanted = range;
+      wanted.first = std::max(span.first, range.first);
+      wanted.end = std::min(span.end, range.end);
+      for (auto intersection : i.Missing(destination, wanted)) {
+      SurfaceView source;
+      if (!i.surfaces.GetView(range.owner, source)) return Result::kFailed;
+      Impl::Span clipped{intersection.first, intersection.end};
+      // Check the complete batch before any GPU work or ownership changes.
+      if (i.PlanClears(source, dest, intersection, clears)) {
+        intersection.owner = destination;
+        materialized.push_back(intersection);
+        continue;
+      }
+      uint64_t sample_words = !dest.key.is_depth && xenos::IsColorRenderTargetFormat64bpp(
+          xenos::ColorRenderTargetFormat(dest.key.resource_format)) ? 2 : 1;
+      converted_samples += (intersection.end - intersection.first) * 80 * 16 / sample_words *
+                           dest.key.scale_x * dest.key.scale_y;
+      if (i.PlanCopies(source, dest, clipped, copies)) {
+        intersection.owner = destination;
+        materialized.push_back(intersection);
+        continue;
+      }
+      if (!i.LogicalRepresentable(dest, clipped) || !i.LogicalRepresentable(source, clipped))
+        return i.Unsupported(source, dest, clipped, "resource bounds");
+      auto* source_target = i.Backing(range.owner);
+      Impl::Target* depth_target = nullptr;
+      if (dest.key.is_depth) {
+        SurfaceId depth = dest.key.resource_format == uint32_t(xenos::DepthRenderTargetFormat::kD24FS8)
+                              ? range.depth_float : range.depth_unorm;
+        if (depth && depth != range.owner) {
+          SurfaceView depth_view;
+          if (!i.surfaces.GetView(depth, depth_view)) return Result::kFailed;
+          if (!i.LogicalRepresentable(depth_view, clipped))
+            return i.Unsupported(depth_view, dest, clipped, "retained depth bounds");
+          if (depth == destination && !i.SelfDepthRepresentable(depth_view, clipped))
+            return i.Unsupported(depth_view, dest, clipped, "retained depth scratch");
+          depth_target = i.Backing(depth);
+        }
+      }
+      transfers.emplace_back(uint32_t(intersection.first), uint32_t(intersection.end),
+                             source_target, depth_target);
+      intersection.owner = destination;
+      if (dest.key.is_depth) {
+        if (dest.key.resource_format == uint32_t(xenos::DepthRenderTargetFormat::kD24FS8))
+          intersection.depth_float = destination;
+        else intersection.depth_unorm = destination;
+      }
+      materialized.push_back(intersection);
+      }
+    }
+  }
+  if (!transfers.empty()) {
+    RenderTargetCache::RenderTarget* target = i.Backing(destination);
+    if (!i.host.PerformTransfersAndResolveClears(1, &target, &transfers, nullptr, nullptr, true)) {
+      i.failed = true;
+      i.surfaces.InvalidateBindings();
+      return Result::kFailed;
+    }
+  }
+  auto& cp = i.host.command_processor_;
+  const bool batch_copy_barriers = REXCVAR_GET(m2_draw_core) && copies.size() > 1 &&
+      std::all_of(copies.begin(), copies.end(), [&](const Impl::Copy& copy) {
+        auto* source = i.Backing(copy.source);
+        return source && source->resource() != dest.resource;
+      });
+  if (batch_copy_barriers) {
+    // All copies read independent sources and write this destination. No copy
+    // consumes a preceding copy, so their transitions share one boundary.
+    for (const auto& copy : copies) {
+      if (!i.surfaces.Transition(copy.source, D3D12_RESOURCE_STATE_COPY_SOURCE)) {
+        i.failed = true; return Result::kFailed;
+      }
+    }
+    if (!i.surfaces.Transition(destination, D3D12_RESOURCE_STATE_COPY_DEST)) {
+      i.failed = true; return Result::kFailed;
+    }
+    cp.SubmitBarriers();
+  }
+  for (const auto& copy : copies) {
+    ID3D12Resource* source_resource;
+    if (batch_copy_barriers) {
+      source_resource = i.Backing(copy.source)->resource();
+    } else {
+      SurfaceView source;
+      i.surfaces.GetView(copy.source, source);
+      source_resource = source.resource;
+      if (!i.surfaces.Transition(copy.source, D3D12_RESOURCE_STATE_COPY_SOURCE) ||
+          !i.surfaces.Transition(destination, D3D12_RESOURCE_STATE_COPY_DEST)) {
+        i.failed = true; return Result::kFailed;
+      }
+      cp.SubmitBarriers();
+    }
+    D3D12_TEXTURE_COPY_LOCATION src{}, dst{};
+    src.Type = dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    src.pResource = source_resource; dst.pResource = dest.resource;
+    cp.GetDeferredCommandList().D3DCopyTextureRegion(&dst, copy.x, copy.y, 0, &src, &copy.box);
+  }
+  for (const auto& clear : clears) {
+    RenderTargetCache::RenderTarget* target = i.Backing(destination);
+    const std::vector<Impl::Transfer> empty;
+    if (!i.host.PerformTransfersAndResolveClears(1, &target, &empty, &clear.value, &clear.rectangle)) {
+      i.failed = true; i.surfaces.InvalidateBindings(); return Result::kFailed;
+    }
+  }
+  i.counters.converted_samples += converted_samples;
+  i.counters.clear_converted_regions += clears.size();
+  for (const auto& range : materialized) Impl::AssignIn(i.materialized_versions[destination], range);
+  if (!materialized.empty()) i.surfaces.InvalidateBindings();
+  return Result::kHandled;
+}
+
+void AliasCache::NotifyWrite(SurfaceId surface, Rect rectangle) {
+  Impl& i = *impl_;
+  ScopedCpuCounter timing(fm4::frame_metrics::Get().enabled, i.counters.notify_write_calls,
+                          i.counters.notify_write_us, i.notify_write_remainder_ns);
+  if (i.failed) return;
+  SurfaceView view;
+  std::vector<Impl::Span> spans;
+  if (!i.surfaces.GetView(surface, view) || !i.Spans(view, rectangle, spans)) {
+    i.failed = true; return;
+  }
+  uint64_t version = i.next_version++;
+  for (const auto& span : spans) {
+    auto first_overlap = Impl::FirstOverlap(i.ranges, view.key.native_domain, span.first);
+    if (REXCVAR_GET(m2_draw_core)) {
+      auto covered = first_overlap;
+      if (covered != i.ranges.end() && covered->second.domain == view.key.native_domain &&
+          covered->second.first <= span.first && covered->second.end >= span.end) {
+        // A single provenance range needs no temporary write vector. Still
+        // publish a fresh version and preserve the other depth representation.
+        Impl::Range write = covered->second;
+        write.first = span.first;
+        write.end = span.end;
+        write.owner = surface;
+        write.version = version;
+        write.known_clear = false;
+        if (view.key.is_depth) {
+          if (view.key.resource_format == uint32_t(xenos::DepthRenderTargetFormat::kD24FS8))
+            write.depth_float = surface;
+          else write.depth_unorm = surface;
+        }
+        i.Assign(write);
+        continue;
+      }
+    }
+    // Preserve retained float32 depth provenance across color reinterpretations.
+    // The existing transfer shaders compare the re-encoded depth before reuse.
+    std::vector<Impl::Range> writes;
+    uint64_t cursor = span.first;
+    for (auto it = first_overlap; it != i.ranges.end(); ++it) {
+      const auto& old = it->second;
+      if (old.domain != view.key.native_domain) break;
+      if (old.end <= cursor) continue;
+      if (old.first >= span.end) break;
+      if (old.first > cursor) writes.push_back({cursor, std::min(old.first, span.end), surface, version});
+      Impl::Range next = old;
+      next.first = std::max(cursor, old.first); next.end = std::min(span.end, old.end);
+      next.owner = surface; next.version = version; next.known_clear = false;
+      writes.push_back(next); cursor = next.end;
+    }
+    if (cursor < span.end) writes.push_back({cursor, span.end, surface, version});
+    for (auto& write : writes) {
+      write.domain = view.key.native_domain;
+      if (view.key.is_depth) {
+        if (view.key.resource_format == uint32_t(xenos::DepthRenderTargetFormat::kD24FS8))
+          write.depth_float = surface;
+        else write.depth_unorm = surface;
+      }
+      i.Assign(write);
+      // Current producers bypass Missing; future writers publish a fresh version.
+    }
+  }
+}
+
+void AliasCache::NotifyClear(SurfaceId surface, Rect rectangle, uint64_t packed_guest_value) {
+  impl_->surfaces.FlushPendingWrites(*this);
+  NotifyWrite(surface, rectangle);
+  Impl& i = *impl_;
+  SurfaceView view;
+  if (i.failed || !i.surfaces.GetView(surface, view)) return;
+  bool is64 = !view.key.is_depth && xenos::IsColorRenderTargetFormat64bpp(
+      xenos::ColorRenderTargetFormat(view.key.resource_format));
+  uint32_t width = (is64 ? 40 : 80) >> uint32_t(view.key.msaa_samples_log2 >= 2);
+  uint32_t height = 16 >> uint32_t(view.key.msaa_samples_log2 >= 1);
+  Rect interior{(rectangle.left + width - 1) / width * width,
+                (rectangle.top + height - 1) / height * height,
+                rectangle.right / width * width, rectangle.bottom / height * height};
+  if (interior.left >= interior.right || interior.top >= interior.bottom) return;
+  std::vector<Impl::Span> spans;
+  if (!i.Spans(view, interior, spans)) { i.failed = true; return; }
+  for (const auto& span : spans) {
+    Impl::Range known{span.first, span.end, surface, i.next_version - 1};
+    if (view.key.is_depth) {
+      if (view.key.resource_format == uint32_t(xenos::DepthRenderTargetFormat::kD24FS8))
+        known.depth_float = surface;
+      else known.depth_unorm = surface;
+    }
+    known.known_clear = true; known.clear_value = packed_guest_value;
+    known.domain = view.key.native_domain;
+    i.Assign(known);
+    Impl::AssignIn(i.materialized_versions[surface], known);
+  }
+}
+const AliasCache::Counters& AliasCache::counters() const { return impl_->counters; }
+
+Result AliasCache::ExportToLegacy(const LegacySpan* spans, size_t count,
+                                  LegacyTransaction& transaction_out) {
+  Impl& i = *impl_;
+  i.surfaces.FlushPendingWrites(*this);
+  transaction_out = {};
+  if (i.failed || i.transaction.serial || (!spans && count) || !count)
+    return Result::kFailed;
+  // Validate every mapping and collision before PrepareRead or legacy mutation.
+  std::vector<SurfaceView> views(count);
+  for (size_t n = 0; n < count; ++n) {
+    const LegacySpan& span = spans[n];
+    std::vector<Impl::Span> touched;
+    if (!i.surfaces.GetView(span.surface, views[n]) ||
+        !i.Spans(views[n], span.rectangle, touched)) return Result::kFailed;
+    if (views[n].key.native_domain) return Result::kNeedsLegacy;
+    auto* backing = i.Backing(span.surface);
+    if (!backing || touched.empty() || span.first_tile >= span.end_tile ||
+        span.end_tile > xenos::kEdramTileCount ||
+        span.legacy_base_tiles != views[n].key.base_tiles ||
+        span.legacy_pitch_tiles != backing->key().GetPitchTiles()) return Result::kNeedsLegacy;
+    for (const auto& interval : touched) {
+      if (!i.Representable(views[n], interval) || interval.first < span.first_tile ||
+          interval.end > span.end_tile) return Result::kNeedsLegacy;
+    }
+    // A bounding interval with holes must not claim unexported pixels.
+    if (touched.front().first != span.first_tile || touched.back().end != span.end_tile ||
+        touched.size() != 1) return Result::kNeedsLegacy;
+    for (size_t previous = 0; previous < n; ++previous) {
+      if (spans[previous].surface == span.surface) continue;
+      if (i.Backing(spans[previous].surface)->key() == backing->key() ||
+          (spans[previous].first_tile < span.end_tile &&
+           span.first_tile < spans[previous].end_tile)) return Result::kNeedsLegacy;
+    }
+  }
+  for (size_t n = 0; n < count; ++n) {
+    for (auto it = Impl::FirstOverlap(i.ranges, 0, spans[n].first_tile);
+         it != i.ranges.end(); ++it) {
+      const auto& range = it->second;
+      if (range.domain || range.first >= spans[n].end_tile) break;
+      if (range.owner == spans[n].surface) continue;
+      SurfaceView source;
+      Impl::Span clipped{std::max(range.first, uint64_t(spans[n].first_tile)),
+                         std::min(range.end, uint64_t(spans[n].end_tile))};
+      if (!i.surfaces.GetView(range.owner, source)) return Result::kFailed;
+      std::vector<Impl::Copy> copies;
+      std::vector<Impl::Clear> clears;
+      Impl::Range clear_range = range; clear_range.first = clipped.first; clear_range.end = clipped.end;
+      if (!i.PlanClears(source, views[n], clear_range, clears) &&
+          !i.PlanCopies(source, views[n], clipped, copies) &&
+          (!i.Representable(source, clipped) || !i.Representable(views[n], clipped)))
+        return Result::kNeedsLegacy;
+      if (views[n].key.is_depth) {
+        SurfaceId depth = views[n].key.resource_format == uint32_t(xenos::DepthRenderTargetFormat::kD24FS8)
+                             ? range.depth_float : range.depth_unorm;
+        SurfaceView depth_view;
+        if (depth && (!i.surfaces.GetView(depth, depth_view) || !i.Representable(depth_view, clipped)))
+          return Result::kNeedsLegacy;
+      }
+    }
+  }
+  for (size_t n = 0; n < count; ++n) {
+    Result result = PrepareRead(spans[n].surface, spans[n].rectangle);
+    if (result != Result::kHandled) return result == Result::kNeedsLegacy ? Result::kFailed : result;
+  }
+  i.transaction.serial = i.next_transaction++;
+  i.transaction.spans.assign(spans, spans + count);
+  i.transaction.ownership = i.host.ownership_ranges_;
+  for (size_t n = 0; n < count; ++n) {
+    auto* backing = i.Backing(spans[n].surface);
+    Impl::Key key = backing->key();
+    auto existing_redirect = std::find_if(i.transaction.redirects.begin(), i.transaction.redirects.end(),
+        [&](const auto& entry) { return entry.key == key; });
+    if (existing_redirect == i.transaction.redirects.end()) {
+      auto previous = i.host.render_targets_.find(key);
+      i.transaction.redirects.push_back({key, previous == i.host.render_targets_.end() ? nullptr : previous->second,
+                                        previous != i.host.render_targets_.end()});
+      i.host.render_targets_[key] = backing;
+    }
+    i.host.ChangeOwnership(key, spans[n].first_tile - key.base_tiles,
+                           spans[n].end_tile - spans[n].first_tile, nullptr);
+  }
+  for (size_t n = 0; n < count; ++n) {
+    const auto& span = spans[n];
+    if (!i.host.DumpRenderTargets(span.first_tile, span.end_tile - span.first_tile,
+                                  1, span.end_tile - span.first_tile)) {
+      i.Restore(); i.failed = true; return Result::kFailed;
+    }
+  }
+  transaction_out.serial = i.transaction.serial;
+  ++i.counters.bridge_exports;
+  i.surfaces.InvalidateBindings();
+  return Result::kHandled;
+}
+
+bool AliasCache::ImportFromLegacy(LegacyTransaction transaction) {
+  Impl& i = *impl_;
+  i.surfaces.FlushPendingWrites(*this);
+  if (!transaction.serial || transaction.serial != i.transaction.serial) return false;
+  bool success = !i.failed;
+  for (const auto& span : i.transaction.spans) {
+    if (!span.may_write) continue;
+    auto* backing = i.Backing(span.surface);
+    std::vector<Impl::Transfer> transfers;
+    i.host.ChangeOwnership(backing->key(), span.first_tile - backing->key().base_tiles,
+                           span.end_tile - span.first_tile, &transfers);
+    RenderTargetCache::RenderTarget* target = backing;
+    if (!transfers.empty() && !i.host.PerformTransfersAndResolveClears(1, &target, &transfers))
+      success = false;
+    if (success) NotifyWrite(span.surface, span.rectangle);
+  }
+  i.Restore();
+  ++i.counters.bridge_imports;
+  if (!success) i.failed = true;
+  return success;
+}
+
+Result AliasCache::ProjectSurface(const SurfaceView& source, const SurfaceView& destination,
+                                  uint32_t source_y, Rect rectangle) {
+  Impl& i = *impl_;
+  i.surfaces.FlushPendingWrites(*this);
+  if (i.failed || i.transaction.serial || !source.resource || !destination.resource)
+    return Result::kFailed;
+  if (source.key.pitch_pixels != destination.key.pitch_pixels ||
+      source.key.resource_format != destination.key.resource_format ||
+      source.key.msaa_samples_log2 != destination.key.msaa_samples_log2 ||
+      source.key.is_depth != destination.key.is_depth ||
+      source.key.scale_x != destination.key.scale_x ||
+      source.key.scale_y != destination.key.scale_y ||
+      rectangle.left > rectangle.right || rectangle.top > rectangle.bottom ||
+      rectangle.right > destination.extent.width || rectangle.bottom > destination.extent.height ||
+      rectangle.right > source.extent.width ||
+      uint64_t(source_y) + rectangle.bottom - rectangle.top > source.extent.height)
+    return Result::kNeedsLegacy;
+  if (rectangle.left == rectangle.right || rectangle.top == rectangle.bottom)
+    return Result::kHandled;
+  if (source.resource == destination.resource)
+    return source_y == rectangle.top ? Result::kHandled : Result::kNeedsLegacy;
+  const auto src_desc = source.resource->GetDesc();
+  const auto dst_desc = destination.resource->GetDesc();
+  if (src_desc.Format != dst_desc.Format || src_desc.SampleDesc.Count != dst_desc.SampleDesc.Count ||
+      !source.key.scale_x || !source.key.scale_y ||
+      source.key.scale_x != i.host.draw_resolution_scale_x() ||
+      source.key.scale_y != i.host.draw_resolution_scale_y() ||
+      uint64_t(rectangle.right) * source.key.scale_x > src_desc.Width ||
+      (uint64_t(source_y) + rectangle.bottom - rectangle.top) * source.key.scale_y > src_desc.Height ||
+      uint64_t(rectangle.right) * destination.key.scale_x > dst_desc.Width ||
+      uint64_t(rectangle.bottom) * destination.key.scale_y > dst_desc.Height)
+    return Result::kNeedsLegacy;
+
+  if (!source.key.is_depth && !source.key.msaa_samples_log2 && src_desc.SampleDesc.Count == 1) {
+    auto& cp = i.host.command_processor_;
+    cp.PushTransitionBarrier(source.resource, source.resource_state, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    cp.PushTransitionBarrier(destination.resource, destination.resource_state, D3D12_RESOURCE_STATE_COPY_DEST);
+    cp.SubmitBarriers();
+    D3D12_TEXTURE_COPY_LOCATION src{}, dst{};
+    src.Type = dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    src.pResource = source.resource;
+    dst.pResource = destination.resource;
+    const uint32_t scale_x = source.key.scale_x, scale_y = source.key.scale_y;
+    D3D12_BOX box{rectangle.left * scale_x, source_y * scale_y, 0,
+                  rectangle.right * scale_x,
+                  (source_y + rectangle.bottom - rectangle.top) * scale_y, 1};
+    cp.GetDeferredCommandList().D3DCopyTextureRegion(
+        &dst, rectangle.left * scale_x, rectangle.top * scale_y, 0, &src, &box);
+    cp.PushTransitionBarrier(source.resource, D3D12_RESOURCE_STATE_COPY_SOURCE, source.resource_state);
+    cp.PushTransitionBarrier(destination.resource, D3D12_RESOURCE_STATE_COPY_DEST,
+                              destination.resource_state);
+    cp.SubmitBarriers();
+  } else {
+    if (!source.backend_target || !destination.backend_target) return Result::kNeedsLegacy;
+    auto* source_target = static_cast<Impl::Target*>(source.backend_target);
+    auto* destination_target = static_cast<Impl::Target*>(destination.backend_target);
+    const auto source_key = source_target->key();
+    const auto destination_key = destination_target->key();
+    const uint32_t pitch = source_key.GetPitchTiles();
+    const uint32_t tile_width = xenos::kEdramTileWidthSamples >>
+        (uint32_t(source_key.msaa_samples >= xenos::MsaaSamples::k4X) + uint32_t(source_key.Is64bpp()));
+    const uint32_t tile_height = xenos::kEdramTileHeightSamples >>
+        uint32_t(source_key.msaa_samples >= xenos::MsaaSamples::k2X);
+    if (!pitch || pitch != destination_key.GetPitchTiles() ||
+        rectangle.left % tile_width || rectangle.right % tile_width ||
+        rectangle.top % tile_height || rectangle.bottom % tile_height || source_y % tile_height)
+      return Result::kNeedsLegacy;
+    const int64_t offset = int64_t(source_key.base_tiles) - destination_key.base_tiles +
+        (int64_t(source_y) - rectangle.top) / tile_height * pitch;
+    if (offset < INT32_MIN || offset > INT32_MAX) return Result::kNeedsLegacy;
+    std::vector<Impl::Transfer> transfers;
+    for (uint32_t row = rectangle.top / tile_height; row < rectangle.bottom / tile_height; ++row) {
+      const uint64_t first = uint64_t(destination_key.base_tiles) + uint64_t(row) * pitch +
+                             rectangle.left / tile_width;
+      const uint64_t end = first + (rectangle.right - rectangle.left) / tile_width;
+      const int64_t source_first = int64_t(first) + offset, source_end = int64_t(end) + offset;
+      if (end > UINT32_MAX || source_first < 0 || source_end > UINT32_MAX ||
+          !i.LogicalRepresentable(destination, {first, end}) ||
+          !i.LogicalRepresentable(source, {uint64_t(source_first), uint64_t(source_end)}))
+        return Result::kNeedsLegacy;
+      transfers.emplace_back(uint32_t(first), uint32_t(end), source_target,
+                             source.key.is_depth ? source_target : nullptr,
+                             int32_t(offset), source.key.is_depth ? int32_t(offset) : 0);
+    }
+    RenderTargetCache::RenderTarget* target = destination_target;
+    if (!i.host.PerformTransfersAndResolveClears(1, &target, &transfers, nullptr, nullptr, true)) {
+      i.failed = true;
+      i.surfaces.InvalidateBindings();
+      return Result::kFailed;
+    }
+  }
+  i.counters.converted_samples += uint64_t(rectangle.right - rectangle.left) *
+      (rectangle.bottom - rectangle.top) * source.key.scale_x * source.key.scale_y *
+      (uint64_t(1) << source.key.msaa_samples_log2);
+  i.surfaces.InvalidateBindings();
+  return Result::kHandled;
+}
+
+Result AliasCache::PreserveContents(const SurfaceView& source,
+                                    const SurfaceView& destination, Rect rectangle) {
+  Impl& i = *impl_;
+  i.surfaces.FlushPendingWrites(*this);
+  if (i.failed || i.transaction.serial || !source.resource || !destination.resource ||
+      !(source.key == destination.key) || rectangle.left > rectangle.right ||
+      rectangle.top > rectangle.bottom || rectangle.right > source.extent.width ||
+      rectangle.bottom > source.extent.height || rectangle.right > destination.extent.width ||
+      rectangle.bottom > destination.extent.height) return Result::kFailed;
+  auto src_desc = source.resource->GetDesc();
+  auto dst_desc = destination.resource->GetDesc();
+  if (src_desc.Format != dst_desc.Format || src_desc.SampleDesc.Count != dst_desc.SampleDesc.Count)
+    return Result::kNeedsLegacy;
+  bool whole = rectangle.left == 0 && rectangle.top == 0 &&
+      uint64_t(rectangle.right) * source.key.scale_x == src_desc.Width &&
+      uint64_t(rectangle.bottom) * source.key.scale_y == src_desc.Height &&
+      src_desc.Width == dst_desc.Width && src_desc.Height == dst_desc.Height;
+  if ((source.key.is_depth || src_desc.SampleDesc.Count != 1) && !whole) {
+    std::vector<Impl::Span> spans;
+    if (!source.backend_target || !destination.backend_target || !i.Spans(source, rectangle, spans))
+      return Result::kNeedsLegacy;
+    std::vector<Impl::Transfer> transfers;
+    auto* source_target = static_cast<Impl::Target*>(source.backend_target);
+    auto* dest_target = static_cast<Impl::Target*>(destination.backend_target);
+    for (const auto& span : spans) {
+      if (!i.LogicalRepresentable(source, span) || !i.LogicalRepresentable(destination, span))
+        return i.Unsupported(source, destination, span, "growth resource bounds");
+      transfers.emplace_back(uint32_t(span.first), uint32_t(span.end), source_target,
+                              source.key.is_depth ? source_target : nullptr);
+    }
+    RenderTargetCache::RenderTarget* target = dest_target;
+    if (!transfers.empty() &&
+        !i.host.PerformTransfersAndResolveClears(1, &target, &transfers, nullptr, nullptr, true)) {
+      i.failed = true; return Result::kFailed;
+    }
+    i.surfaces.InvalidateBindings();
+    return Result::kHandled;
+  }
+  if (rectangle.left == rectangle.right || rectangle.top == rectangle.bottom)
+    return Result::kHandled;
+  auto& cp = i.host.command_processor_;
+  cp.PushTransitionBarrier(source.resource, source.resource_state, D3D12_RESOURCE_STATE_COPY_SOURCE);
+  cp.PushTransitionBarrier(destination.resource, destination.resource_state, D3D12_RESOURCE_STATE_COPY_DEST);
+  cp.SubmitBarriers();
+  D3D12_TEXTURE_COPY_LOCATION src{}, dst{};
+  src.pResource = source.resource; dst.pResource = destination.resource;
+  src.Type = dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  D3D12_BOX box{rectangle.left * source.key.scale_x, rectangle.top * source.key.scale_y, 0,
+                rectangle.right * source.key.scale_x, rectangle.bottom * source.key.scale_y, 1};
+  uint32_t planes = source.key.is_depth ? 2 : 1;
+  for (uint32_t plane = 0; plane < planes; ++plane) {
+    src.SubresourceIndex = dst.SubresourceIndex = plane;
+    cp.GetDeferredCommandList().D3DCopyTextureRegion(&dst, box.left, box.top, 0, &src,
+                                                    whole ? nullptr : &box);
+  }
+  // Growth hasn't published destination in SurfaceCache yet; restore borrowed
+  // states rather than attempting to transition it through a surface ID.
+  cp.PushTransitionBarrier(source.resource, D3D12_RESOURCE_STATE_COPY_SOURCE, source.resource_state);
+  cp.PushTransitionBarrier(destination.resource, D3D12_RESOURCE_STATE_COPY_DEST, destination.resource_state);
+  cp.SubmitBarriers();
+  i.surfaces.InvalidateBindings();
+  return Result::kHandled;
+}
+}  // namespace rex::graphics::d3d12::native_rt
