+struct TilingPass {
+  uint64_t identity = 0;
+  Extent full_extent{};
+  uint32_t band_count = 0;
+  // Set only with a verified begin/end source and matching replay semantics.
+  bool verified = false;
+};
+
+class TilingState final {
+ public:
+  void Reset();
+  bool Begin(const TilingPass& pass);
+  bool SelectBand(uint32_t band_index, Rect band_rectangle);
+  void End();
+  bool merging() const;
+  Extent full_extent() const;
+  Rect band_rectangle() const;
+  // Copy-mode packet bin predicates always retain their original decision.
+  // Ordinary predicates change only inside a verified merge and only for
+  // identified tile replay packets; queries keep their original execution.
+  bool ShouldExecutePredicate(bool original_result, bool copy_mode,
+                              bool identified_tile_replay, bool query_active) const;
+  // Suppress tile window offsets only for verified full-scene rasterization.
+  bool OverrideRasterRectangle(Rect& rectangle, bool copy_mode) const;
+
+ private:
+  TilingPass pass_{};
+  Rect band_{};
+  uint32_t band_index_ = 0;
+  bool active_ = false;
+};
+
+}  // namespace rex::graphics::d3d12::native_rt
