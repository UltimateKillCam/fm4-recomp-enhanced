+    auto identity = fm4::textures::Identity(width, height, format, base);
+    const uint32_t dumped_mips = fm4::textures::Dump(identity, width, height, format, base,
+        [&](std::vector<uint8_t>& data) -> uint32_t {
+      if (!key.mip_max_level) return 1;
+      const auto& layout = texture.guest_layout();
+      const uint32_t mip_address = key.mip_page << 12;
+      const uint32_t mip_bytes = layout.mips_total_extent_bytes;
+      if (!mip_address || !mip_bytes || uint64_t(mip_address) + mip_bytes > SharedMemory::kBufferSize)
+        return 0;
+      const uint8_t* mip_guest = command_processor_.GuestMemoryForTextureMods().TranslatePhysical(mip_address);
+      if (!mip_guest) return 0;
+      for (uint32_t level = 1; level <= key.mip_max_level; ++level) {
+        const uint32_t stored_level = std::min(level, layout.packed_level);
+        const auto& stored = layout.mips[stored_level];
+        uint32_t ox = 0, oy = 0, oz = 0;
+        if (key.packed_mips && level >= layout.packed_level)
+          texture_util::GetPackedMipOffset(width, height, 1, key.format, level, ox, oy, oz);
+        if (oz || !stored.row_pitch_bytes) return 0;
+        const uint32_t bw = (std::max(width >> level, 1u) + block_width - 1) / block_width;
+        const uint32_t bh = (std::max(height >> level, 1u) + block_width - 1) / block_width;
+        const size_t begin = data.size();
+        data.resize(begin + size_t(bw) * bh * block_bytes);
+        for (uint32_t y = 0; y < bh; ++y) for (uint32_t x = 0; x < bw; ++x) {
+          const uint32_t local = key.tiled ? uint32_t(texture_util::GetTiledOffset2D(
+              x + ox, y + oy, stored.row_pitch_bytes / block_bytes, b)) :
+              (y + oy) * stored.row_pitch_bytes + (x + ox) * block_bytes;
+          const uint64_t offset = uint64_t(layout.mip_offsets_bytes[stored_level]) + local;
+          if (offset + block_bytes > mip_bytes) return 0;
+          for (uint32_t c = 0; c < block_bytes; ++c)
+            data[begin + (size_t(y) * bw + x) * block_bytes + c] = mip_guest[(offset + c) ^ endian_xor];
+        }
