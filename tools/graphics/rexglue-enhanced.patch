+bool D3D12TextureCache::PrepareScaledResolveNativePages(uint32_t start, uint32_t length,
+                                                       uint32_t pixel_size_log2) {
+  if (!length) {
+    return true;
+  }
+  if (pixel_size_log2 > 4 || start >= SharedMemory::kBufferSize ||
+      length > SharedMemory::kBufferSize - start) {
+    return false;
+  }
+  uint32_t end = rex::align(start + length, uint32_t(4096));
+  auto& native_memory = static_cast<D3D12SharedMemory&>(shared_memory());
+  for (uint32_t page = start & ~uint32_t(4095); page < end;) {
+    if (IsRangeScaledResolved(page, 4096)) {
+      page += 4096;
+      continue;
+    }
+    uint32_t first = page;
+    do { page += 4096; } while (page < end && !IsRangeScaledResolved(page, 4096));
+    uint32_t bytes = page - first;
+    if (!EnsureScaledResolveMemoryCommitted(first, bytes) ||
+        !native_memory.RequestRange(first, bytes, true) ||
+        !MakeScaledResolveRangeCurrent(first, bytes, 4)) {
+      return false;
+    }
+    native_memory.UseForReading();
+    TransitionCurrentScaledResolveRange(D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    command_processor_.PushUAVBarrier(GetCurrentScaledResolveBufferResource());
+    command_processor_.SubmitBarriers();
+    uint64_t offset = uint64_t(first) * draw_resolution_scale_x() * draw_resolution_scale_y() -
+                      (uint64_t(GetCurrentScaledResolveBufferIndexPublic()) << 30);
+    if (!native_mip_uploader_.Record(command_processor_, native_memory.GetBuffer(),
+                                     GetCurrentScaledResolveBufferResource(), first, offset, bytes,
+                                     draw_resolution_scale_x(), draw_resolution_scale_y(),
+                                     pixel_size_log2)) {
+      return false;
+    }
+    command_processor_.PushUAVBarrier(GetCurrentScaledResolveBufferResource());
+  }
+  return true;
+}
