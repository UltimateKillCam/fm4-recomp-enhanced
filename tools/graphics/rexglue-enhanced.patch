+
+bool Memory::CompleteDeferredPhysicalWrites(std::unique_lock<std::recursive_mutex>& lock,
+                                           uint32_t address, uint32_t length) {
+  bool completed = false;
+  while (HasDeferredPhysicalWrite(address, length)) {
+    auto it = std::find_if(deferred_physical_writes_.begin(), deferred_physical_writes_.end(),
+                          [address, length](const auto& write) {
+      return uint64_t(address) < uint64_t(write->address) + write->length &&
+             uint64_t(write->address) < uint64_t(address) + length;
+    });
+    auto write = *it;
+    // Two faults may download the same immutable generation concurrently. Check
+    // identity and generation again before publishing so a late download cannot
+    // overwrite a newer CPU store or a replacement resolve.
+    auto generation = write->generation;
+    auto provider = write->provider;
+    completed = true;
+    lock.unlock();
+    auto bytes = provider();
+    if (bytes.size() != write->length) {
+      std::abort();
+    }
+    lock.lock();
+    it = std::find(deferred_physical_writes_.begin(), deferred_physical_writes_.end(), write);
+    if (it == deferred_physical_writes_.end() || generation != write->generation) {
+      continue;
+    }
+    std::memcpy(deferred_physical_write_view_ + write->address, bytes.data(), bytes.size());
+    REXSYS_DEBUG("Deferred physical write materialized: {:08X}+{:X}",
+                 write->address, write->length);
+    RestoreDeferredWriteProtection(*write);
+    deferred_physical_write_bytes_ -= write->retained_bytes;
+    deferred_physical_writes_.erase(std::find(deferred_physical_writes_.begin(),
+                                             deferred_physical_writes_.end(), write));
+    completed = true;
+  }
+  return completed;
+}
+
+void Memory::CompleteDeferredPhysicalWrites() {
+  auto lock = global_critical_region_.Acquire();
+  CompleteDeferredPhysicalWrites(lock, 0, 0x20000000);
+}
+
+bool Memory::DeferPhysicalWrite(uint32_t address, uint32_t length, uint64_t retained_bytes,
+                                std::function<std::vector<uint8_t>()> provider) {
+  constexpr uint64_t kMaxRetainedBytes = 128 * 1024 * 1024;
+  if (!length || ((address | length) & (system_page_size_ - 1)) ||
+      uint64_t(address) + length > 0x20000000 || retained_bytes > kMaxRetainedBytes) {
+    return false;
+  }
+  auto lock = global_critical_region_.Acquire();
+  if (physical_memory_host_accesses_) {
+    return false;
+  }
+  if (!deferred_physical_write_view_) {
+    deferred_physical_write_view_ = static_cast<uint8_t*>(rex::memory::MapFileView(
+        mapping_, nullptr, 0x20000000, PageAccess::kReadWrite, 0x100000000ull));
+    if (!deferred_physical_write_view_) {
+      return false;
+    }
+  }
+  for (const auto& write : deferred_physical_writes_) {
+    if (write->address == address && write->length == length &&
+        deferred_physical_write_bytes_ - write->retained_bytes + retained_bytes <=
+            kMaxRetainedBytes) {
+      // Keep every alias guarded throughout replacement of an unread generation.
+      deferred_physical_write_bytes_ -= write->retained_bytes;
+      write->retained_bytes = retained_bytes;
+      ++write->generation;
+      write->provider = std::move(provider);
+      deferred_physical_write_bytes_ += retained_bytes;
+      REXSYS_DEBUG("Deferred physical write replaced unread generation: {:08X}+{:X}",
+                   address, length);
+      return true;
+    }
+  }
+  // Partial overlap must preserve the older bytes outside the new destination.
+  CompleteDeferredPhysicalWrites(lock, address, length);
+  if (deferred_physical_write_bytes_ + retained_bytes > kMaxRetainedBytes ||
+      deferred_physical_writes_.size() >= 64) {
+    CompleteDeferredPhysicalWrites(lock, 0, 0x20000000);
+  }
+  if (physical_memory_host_accesses_) {
+    return false;
+  }
+
+  auto write = std::make_shared<DeferredPhysicalWrite>();
+  write->address = address;
+  write->length = length;
+  write->retained_bytes = retained_bytes;
+  write->provider = std::move(provider);
+  uint64_t mask = ~uint64_t(system_allocation_granularity_ - 1);
+  for (size_t i = 0; i < rex::countof(map_info); ++i) {
+    uint64_t target = map_info[i].target_address & mask;
+    if (target < 0x100000000ull) {
+      continue;
+    }
+    uint64_t first = target - 0x100000000ull;
+    uint64_t last = first + map_info[i].virtual_address_end -
+                    map_info[i].virtual_address_start + 1;
+    uint64_t begin = std::max(uint64_t(address), first);
+    uint64_t end = std::min(uint64_t(address) + length, last);
+    while (begin < end) {
+      auto host = static_cast<uint8_t*>(views_.all_views[i]) + (begin - first);
+      size_t count = system_page_size_;
+      PageAccess access;
+      if (!rex::memory::QueryProtect(host, count, access)) {
+        return false;
+      }
+      count = std::min(size_t(system_page_size_), size_t(end - begin));
+      if (!write->protections.empty() &&
+          write->protections.back().address + write->protections.back().length == host &&
+          write->protections.back().access == access) {
+        write->protections.back().length += count;
+      } else {
+        write->protections.push_back({host, count, access});
+      }
+      begin += count;
+    }
+  }
+  for (const auto& protection : write->protections) {
+    if (!rex::memory::Protect(protection.address, protection.length, PageAccess::kNoAccess)) {
+      RestoreDeferredWriteProtection(*write);
+      return false;
+    }
+  }
+  deferred_physical_write_bytes_ += retained_bytes;
+  deferred_physical_writes_.push_back(std::move(write));
+  REXSYS_DEBUG("Deferred physical write retained: {:08X}+{:X} ({} GPU bytes)",
+               address, length, retained_bytes);
+  return true;
+}
