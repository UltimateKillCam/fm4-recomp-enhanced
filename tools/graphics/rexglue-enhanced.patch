+struct KeyHash {
+  size_t operator()(const SurfaceKey& key) const {
+    size_t value = size_t(key.native_domain ^ (key.native_domain >> 32));
+    value ^= key.base_tiles;
+    for (uint32_t part : {key.pitch_pixels, key.resource_format, key.msaa_samples_log2,
+                          key.scale_x, key.scale_y, uint32_t(key.is_depth)}) {
+      value ^= size_t(part) + size_t(0x9e3779b9) + (value << 6) + (value >> 2);
+    }
+    return value;
+  }
+};
+
+bool Empty(Rect rectangle) {
+  return rectangle.left >= rectangle.right || rectangle.top >= rectangle.bottom;
+}
+
+bool Contains(Rect outer, Rect inner) {
+  return Empty(inner) || (!Empty(outer) && outer.left <= inner.left && outer.top <= inner.top &&
+                          outer.right >= inner.right && outer.bottom >= inner.bottom);
+}
+
+uint64_t Area(Rect rectangle) {
+  return Empty(rectangle) ? 0 : uint64_t(rectangle.right - rectangle.left) *
+                                 (rectangle.bottom - rectangle.top);
+}
+
+// Merge only if the exact union is itself a rectangle. L-shaped unions and
+// separated scissors retain separate entries, so no unwritten hole is claimed.
+void AddExactRectangle(std::vector<Rect>& rectangles, Rect rectangle) {
+  if (Empty(rectangle)) return;
+  for (size_t index = 0; index < rectangles.size();) {
+    Rect previous = rectangles[index];
+    if (Contains(previous, rectangle)) return;
+    Rect intersection{std::max(previous.left, rectangle.left),
+                       std::max(previous.top, rectangle.top),
+                       std::min(previous.right, rectangle.right),
+                       std::min(previous.bottom, rectangle.bottom)};
+    Rect combined{std::min(previous.left, rectangle.left), std::min(previous.top, rectangle.top),
+                   std::max(previous.right, rectangle.right), std::max(previous.bottom, rectangle.bottom)};
+    if (Area(combined) == Area(previous) + Area(rectangle) - Area(intersection)) {
+      rectangle = combined;
+      rectangles.erase(rectangles.begin() + index);
+      index = 0;
+    } else {
+      ++index;
+    }
+  }
+  rectangles.push_back(rectangle);
+}
+
+bool AttachmentsMayOverlap(const std::array<SurfaceView, 5>& views, uint32_t mask, Rect rectangle) {
+  if (Empty(rectangle)) return false;
+  struct Span { uint64_t domain = 0, first = 0, end = 0; };
+  std::array<Span, 5> spans{};
+  for (size_t index = 0; index < views.size(); ++index) {
+    if (!(mask & (1u << index))) continue;
+    const auto& key = views[index].key;
+    uint64_t sx = key.msaa_samples_log2 >= 2 ? 2 : 1;
+    uint64_t sy = key.msaa_samples_log2 >= 1 ? 2 : 1;
+    uint64_t words = !key.is_depth && xenos::IsColorRenderTargetFormat64bpp(
+        xenos::ColorRenderTargetFormat(key.resource_format)) ? 2 : 1;
+    uint64_t pitch = ((uint64_t(key.pitch_pixels) * sx + 79) / 80) * words;
+    spans[index] = {key.native_domain,
+        key.base_tiles + uint64_t(rectangle.top) * sy / 16 * pitch +
+            uint64_t(rectangle.left) * sx * words / 80,
+        key.base_tiles + (uint64_t(rectangle.bottom - 1) * sy / 16) * pitch +
+            (uint64_t(rectangle.right) * sx * words + 79) / 80};
+    for (size_t previous = 0; previous < index; ++previous) {
+      if ((mask & (1u << previous)) && spans[index].domain == spans[previous].domain &&
+          spans[index].first < spans[previous].end && spans[previous].first < spans[index].end)
+        return true;
+    }
+  }
+  return false;
+}
+
+bool ValidExtent(const SurfaceKey& key, Extent extent) {
+  return key.pitch_pixels && key.pitch_pixels <= xenos::kTexture2DCubeMaxWidthHeight &&
+         key.base_tiles < xenos::kEdramTileCount && key.msaa_samples_log2 <= 2 &&
+         key.scale_x && key.scale_y && extent.width && extent.height &&
+         uint64_t(extent.width) * key.scale_x <= D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION &&
+         uint64_t(extent.height) * key.scale_y <= D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION;
+}
+
+// The allocation includes tile padding to preserve complete guest tiles during
+// partial clears and alias conversion. There is no physical EDRAM height cap.
+Extent PaddedExtent(const SurfaceKey& key, Extent minimum) {
+  uint32_t sample_x = uint32_t(key.msaa_samples_log2 >= 2);
+  uint32_t sample_y = uint32_t(key.msaa_samples_log2 >= 1);
+  uint32_t tile_width = xenos::kEdramTileWidthSamples >> sample_x;
+  uint32_t tile_height = xenos::kEdramTileHeightSamples >> sample_y;
+  return {(key.pitch_pixels + tile_width - 1) / tile_width * tile_width,
+          (std::max(minimum.height, 1u) + tile_height - 1) / tile_height * tile_height};
+}
+
+std::vector<Rect> ClearPreservationEdges(const SurfaceKey& key, Rect rectangle) {
+  uint32_t tile_width = xenos::kEdramTileWidthSamples >> uint32_t(key.msaa_samples_log2 >= 2);
+  uint32_t tile_height = xenos::kEdramTileHeightSamples >> uint32_t(key.msaa_samples_log2 >= 1);
+  uint32_t middle_top = rectangle.top;
+  uint32_t middle_bottom = rectangle.bottom;
+  std::vector<Rect> edges;
+  if (rectangle.top % tile_height) {
+    middle_top = std::min(rectangle.bottom,
+                          (rectangle.top / tile_height + 1) * tile_height);
+    edges.push_back({rectangle.left, rectangle.top, rectangle.right, middle_top});
+  }
+  if (rectangle.bottom % tile_height) {
+    middle_bottom = std::max(middle_top, rectangle.bottom / tile_height * tile_height);
+    if (middle_bottom < rectangle.bottom) {
+      edges.push_back({rectangle.left, middle_bottom, rectangle.right, rectangle.bottom});
+    }
+  }
+  if (middle_top >= middle_bottom) {
+    return edges;
+  }
+  uint32_t left_end = rectangle.left;
+  if (rectangle.left % tile_width) {
+    left_end = std::min(rectangle.right, (rectangle.left / tile_width + 1) * tile_width);
+    edges.push_back({rectangle.left, middle_top, left_end, middle_bottom});
+  }
+  if (rectangle.right % tile_width) {
+    uint32_t right_start = std::max(left_end, rectangle.right / tile_width * tile_width);
+    if (right_start < rectangle.right) {
+      edges.push_back({right_start, middle_top, rectangle.right, middle_bottom});
+    }
+  }
+  return edges;
+}
+
+std::array<uint32_t, 13> ClearSignature(const draw_util::ResolveInfo& info,
+                                       uint32_t surface_info) {
+  return {surface_info, info.source_x, info.source_y, info.coordinate_info.width_div_8,
+          info.height_div_8, info.rb_copy_control.value,
+          info.IsClearingDepth() ? info.depth_original_base : 0,
+          info.IsClearingColor() ? info.color_original_base : 0,
+          info.IsClearingDepth() ? uint32_t(info.depth_edram_info.format) : 0,
+          info.IsClearingColor() ? uint32_t(info.color_edram_info.format) : 0,
+          info.rb_depth_clear, info.rb_color_clear, info.rb_color_clear_lo};
+}
