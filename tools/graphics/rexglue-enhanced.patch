+// Only the timer consumer uses timed waits. Producers retain the ring buffer's
+// original spin strategy, so a single auto-reset notification cannot wake the
+// wrong waiter. Publication is checked again after every wake.
+class TimerQueueWaitStrategy : public dp::spin_wait_strategy {
+ public:
+  using dp::spin_wait_strategy::wait_until_published;
+
+#if REX_PLATFORM_WIN32
+  TimerQueueWaitStrategy()
+      : published_(CreateEventW(nullptr, FALSE, FALSE, nullptr)),
+        timer_(CreateWaitableTimerExW(nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                     TIMER_MODIFY_STATE | SYNCHRONIZE)) {}
+  ~TimerQueueWaitStrategy() {
+    if (timer_) CloseHandle(timer_);
+    if (published_) CloseHandle(published_);
+  }
+
+  void signal_all_when_blocking() {
+    if (published_) {
+      SetEvent(published_);
+    }
+  }
+
+  template <typename Clock, typename Duration>
+  dp::sequence_t wait_until_published(
+      dp::sequence_t sequence, size_t count,
+      const std::atomic<dp::sequence_t>* const sequences[],
+      const std::chrono::time_point<Clock, Duration>& deadline) {
+    if (!REXCVAR_GET(timer_queue_waitable_waits) || !published_ || !timer_) {
+      return dp::spin_wait_strategy::wait_until_published(sequence, count, sequences, deadline);
+    }
+    while (true) {
+      auto result = dp::minimum_sequence_after(sequence, count, sequences);
+      if (dp::difference(result, sequence) >= 0) return result;
+      DWORD waited;
+      if (deadline == std::chrono::time_point<Clock, Duration>::max()) {
+        waited = WaitForSingleObject(published_, INFINITE);
+      } else {
+        const auto remaining = deadline - Clock::now();
+        if (remaining <= Duration::zero()) return result;
+        // Round up to 100 ns so arming never advances the requested deadline.
+        using TimerTick = std::chrono::duration<int64_t, std::ratio<1, 10000000>>;
+        LARGE_INTEGER due;
+        due.QuadPart = -std::chrono::ceil<TimerTick>(remaining).count();
+        if (!SetWaitableTimer(timer_, &due, 0, nullptr, nullptr, FALSE)) {
+          return dp::spin_wait_strategy::wait_until_published(sequence, count, sequences, deadline);
+        }
+        HANDLE handles[] = {published_, timer_};
+        waited = WaitForMultipleObjects(2, handles, FALSE, INFINITE);
+        CancelWaitableTimer(timer_);
+      }
+      if (waited == WAIT_FAILED) {
+        return dp::spin_wait_strategy::wait_until_published(sequence, count, sequences, deadline);
+      }
+    }
+  }
