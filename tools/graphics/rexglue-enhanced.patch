+// Recognize the complete r14-r31/LR restore epilogue even without a symbol.
+// Requiring the exact body excludes general functions that merely restore LR.
+static bool IsAnonymousGpr14Restore(const FunctionNode& fn, const EmitContext& ctx) {
+  if (fn.size() != 84) return false;
+  const auto* data = static_cast<const uint8_t*>(ctx.binary.translate(fn.base()));
+  if (!data || ctx.binary.translate(fn.end() - 1) != data + 83) return false;
+  for (uint32_t reg = 14; reg <= 31; ++reg) {
+    const uint32_t displacement = uint32_t(-8 * int32_t(33 - reg)) & 0xFFFC;
+    const uint32_t expected = 0xE8000000 | (reg << 21) | (1 << 16) | displacement;
+    if (load_and_swap<uint32_t>(data + (reg - 14) * 4) != expected) return false;
+  }
+  return load_and_swap<uint32_t>(data + 72) == 0x8181FFF8 &&  // lwz r12,-8(r1)
+         load_and_swap<uint32_t>(data + 76) == 0x7D8803A6 &&  // mtlr r12
+         load_and_swap<uint32_t>(data + 80) == 0x4E800020;    // blr
+}
