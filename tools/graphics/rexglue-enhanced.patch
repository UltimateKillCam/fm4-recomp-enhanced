+// Predicated full-scene pass state. GPL-3.0-only.
+#include <rex/graphics/d3d12/native_rt/tiling.h>
+
+namespace rex::graphics::d3d12::native_rt {
+
+void TilingState::Reset() {
+  pass_ = {};
+  band_ = {};
+  band_index_ = 0;
+  active_ = false;
+}
+
+bool TilingState::Begin(const TilingPass& pass) {
+  Reset();
+  if (!pass.verified || !pass.identity || !pass.full_extent.width ||
+      !pass.full_extent.height || pass.band_count < 2 || pass.band_count > 64) {
+    return false;
+  }
+  pass_ = pass;
+  active_ = true;
+  return true;
+}
+
+bool TilingState::SelectBand(uint32_t band_index, Rect rectangle) {
+  if (!active_ || band_index >= pass_.band_count ||
+      rectangle.left >= rectangle.right || rectangle.top >= rectangle.bottom ||
+      rectangle.right > pass_.full_extent.width ||
+      rectangle.bottom > pass_.full_extent.height) {
+    Reset();
+    return false;
+  }
+  band_index_ = band_index;
+  band_ = rectangle;
+  return true;
+}
+
+void TilingState::End() { Reset(); }
+
+bool TilingState::merging() const {
+  return active_ && pass_.verified && band_.right > band_.left &&
+         band_.bottom > band_.top;
+}
+
+Extent TilingState::full_extent() const { return merging() ? pass_.full_extent : Extent{}; }
+Rect TilingState::band_rectangle() const { return merging() ? band_ : Rect{}; }
+
+bool TilingState::ShouldExecutePredicate(bool original_result, bool copy_mode,
+                                       bool identified_tile_replay,
+                                       bool query_active) const {
+  if (!merging() || copy_mode || query_active || !identified_tile_replay) {
+    return original_result;
+  }
+  // Replay geometry once over the full scene. Bin masks remain meaningful for
+  // queries and copies, which may have distinct destinations for every band.
+  return band_index_ == 0;
+}
+
+bool TilingState::OverrideRasterRectangle(Rect& rectangle, bool copy_mode) const {
+  if (!merging() || copy_mode || band_index_ != 0) return false;
+  // Only the known tiling window is replaceable. Inner object scissors must
+  // retain their clipping semantics even inside a merged pass.
+  if (rectangle.left != band_.left || rectangle.top != band_.top ||
+      rectangle.right != band_.right || rectangle.bottom != band_.bottom) {
+    return false;
+  }
+  rectangle = {0, 0, pass_.full_extent.width, pass_.full_extent.height};
+  return true;
+}
+
+}  // namespace rex::graphics::d3d12::native_rt
