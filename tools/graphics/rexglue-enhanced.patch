+bool D3D12CommandProcessor::TryDeferResolveReadback(uint32_t address, uint32_t length) {
+  const uint32_t page_mask = uint32_t(memory::page_size()) - 1;
+  if (!length || ((address | length) & page_mask) ||
+      uint64_t(address) + length > SharedMemory::kBufferSize) {
+    return false;
+  }
+  auto snapshot = std::make_shared<ResolveReadbackSnapshot>();
+  snapshot->device = GetD3D12Provider().GetDevice();
+  snapshot->producer_fence = submission_fence_;
+  snapshot->length = length;
+  snapshot->constants = {texture_cache_->draw_resolution_scale_x(),
+                         texture_cache_->draw_resolution_scale_y(), 0, length, 0};
+  const bool scaled = texture_cache_->IsDrawResolutionScaled();
+  uint64_t source_length = uint64_t(length) * snapshot->constants[0] * snapshot->constants[1];
+  if (source_length > 64 * 1024 * 1024) {
+    return false;
+  }
+  snapshot->source_length = uint32_t(source_length);
+  ID3D12Resource* source;
+  uint64_t source_offset;
+  if (scaled) {
+    if (!resolve_downscale_pipeline_ || !resolve_downscale_root_signature_) {
+      return false;
+    }
+    auto format = FormatInfo::Get(uint32_t(
+        register_file_->Get<reg::RB_COPY_DEST_INFO>().copy_dest_format));
+    uint32_t bpp = format->bits_per_pixel;
+    if ((bpp != 8 && bpp != 16 && bpp != 32 && bpp != 64 && bpp != 128) ||
+        !rex::bit_scan_forward(bpp >> 3, &snapshot->constants[2])) {
+      return false;
+    }
+    snapshot->constants[4] = REXCVAR_GET(readback_resolve_half_pixel_offset) ? 1u : 0u;
+    snapshot->root_signature = resolve_downscale_root_signature_;
+    snapshot->pipeline = resolve_downscale_pipeline_;
+    source = texture_cache_->GetCurrentScaledResolveBufferResource();
+    uint64_t base = uint64_t(texture_cache_->GetCurrentScaledResolveBufferIndexPublic()) << 30;
+    uint64_t scaled_address = uint64_t(address) * snapshot->constants[0] * snapshot->constants[1];
+    if (!source || scaled_address < base) {
+      return false;
+    }
+    source_offset = scaled_address - base;
+  } else {
+    source = shared_memory_->GetBuffer();
+    source_offset = address;
+  }
+  if (source_offset + source_length > source->GetDesc().Width) {
+    return false;
+  }
+  D3D12_RESOURCE_DESC desc;
+  ui::d3d12::util::FillBufferResourceDesc(desc, source_length, D3D12_RESOURCE_FLAG_NONE);
+  if (FAILED(snapshot->device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesDefault,
+      D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+      IID_PPV_ARGS(&snapshot->source)))) {
+    return false;
+  }
+  snapshot->source->SetName(L"Deferred Resolve Snapshot");
+  if (scaled) {
+    PushUAVBarrier(source);
+    texture_cache_->TransitionCurrentScaledResolveRange(D3D12_RESOURCE_STATE_COPY_SOURCE);
+  } else {
+    shared_memory_->UseAsCopySource();
+  }
+  SubmitBarriers();
+  deferred_command_list_.D3DCopyBufferRegion(snapshot->source.Get(), 0, source, source_offset,
+                                              source_length);
+  PushTransitionBarrier(snapshot->source.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+      scaled ? D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE : D3D12_RESOURCE_STATE_COPY_SOURCE);
+  if (scaled) {
+    texture_cache_->TransitionCurrentScaledResolveRange(D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  }
+  // Keep the copy destination alive even if its unread generation is replaced
+  // before the GPU reaches it, or publishing the memory guard fails.
+  snapshot->producer_submission = submission_current_;
+  snapshot->source->AddRef();
+  resources_for_deletion_.emplace_back(submission_current_, snapshot->source.Get());
+  if (!EndSubmission(false)) {
+    std::abort();
+  }
+  return memory_->DeferPhysicalWrite(address, length, source_length,
+                                     [snapshot] { return snapshot->Download(); });
+}
