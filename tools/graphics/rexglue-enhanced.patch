+std::filesystem::path GetShaderTranslationPath(const std::filesystem::path& root,
+                                               const D3D12Shader::D3D12Translation& translation) {
+  // These translator flags may be changed at runtime. Keep new variants apart
+  // even within one storage session (the remaining constructor options are fixed).
+  uint32_t options = uint32_t(REXCVAR_GET(dxbc_switch)) |
+                     (uint32_t(REXCVAR_GET(dxbc_source_map)) << 1) |
+                     (uint32_t(REXCVAR_GET(draw_resolution_scaled_texture_offsets)) << 2) |
+                     (uint32_t(REXCVAR_GET(use_fuzzy_alpha_epsilon)) << 3);
+  return root / fmt::format("{:016X}.{}.{}.{:016X}.dxbc", translation.shader().ucode_data_hash(),
+                            uint32_t(translation.shader().type()), options,
+                            translation.modification());
+}
+
