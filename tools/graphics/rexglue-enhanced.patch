diff --git a/include/rex/graphics/wait_notification.h b/include/rex/graphics/wait_notification.h
new file mode 100644
index 0000000..7f97786
--- /dev/null
+++ b/include/rex/graphics/wait_notification.h
@@ -0,0 +1,63 @@
+// Bounded producer notification for the command processor's guest waits.
+#pragma once
+#include <atomic>
+#include <cstdint>
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+namespace rex::graphics {
+class WaitNotification {
+ public:
+#ifdef _WIN32
+  WaitNotification()
+      : event_(CreateEventW(nullptr, FALSE, FALSE, nullptr)),
+        timer_(CreateWaitableTimerExW(nullptr, nullptr, 0x00000002, TIMER_ALL_ACCESS)) {}
+  ~WaitNotification() {
+    if (event_) CloseHandle(event_);
+    if (timer_) CloseHandle(timer_);
+  }
+#endif
+#ifndef _WIN32
+  WaitNotification() = default;
+#endif
+  WaitNotification(const WaitNotification&) = delete;
+  WaitNotification& operator=(const WaitNotification&) = delete;
+  uint64_t Snapshot() const { return sequence_.load(std::memory_order_acquire); }
+  void Notify() {
+    sequence_.fetch_add(1, std::memory_order_release);
+#ifdef _WIN32
+    if (event_) SetEvent(event_);
+#endif
+  }
+  // Snapshot before reading the predicate. An earlier notification changes the
+  // sequence; a later one leaves the auto-reset event signalled until consumed.
+  // Uninstrumented writers and shutdown still get a bounded predicate recheck.
+  bool Wait(uint64_t observed, uint32_t recheck_us = 100) {
+#ifdef _WIN32
+    if (Snapshot() != observed) return true;
+    if (!event_) { SwitchToThread(); return false; }
+    if (timer_) {
+      LARGE_INTEGER due; due.QuadPart = -LONGLONG(recheck_us) * 10;  // Relative, in 100 ns units.
+      if (SetWaitableTimer(timer_, &due, 0, nullptr, nullptr, FALSE)) {
+        if (Snapshot() != observed) { CancelWaitableTimer(timer_); return true; }
+        HANDLE handles[] = {event_, timer_};
+        const auto result = WaitForMultipleObjects(2, handles, FALSE, 1);
+        CancelWaitableTimer(timer_);
+        return result == WAIT_OBJECT_0 || Snapshot() != observed;
+      }
+    }
+    if (Snapshot() != observed) return true;
+    return WaitForSingleObject(event_, 1) == WAIT_OBJECT_0;
+#else
+    return false;
+#endif
+  }
+ private:
+  std::atomic<uint64_t> sequence_{0};
+#ifdef _WIN32
+  HANDLE event_ = nullptr;
+  HANDLE timer_ = nullptr;
+#endif
+};
+}  // namespace rex::graphics
