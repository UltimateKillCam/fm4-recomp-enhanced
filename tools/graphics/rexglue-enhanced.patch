+bool D3D12RenderTargetCache::HandleNativeTilingMarker(const native_rt::TilingMarker& marker) {
+  FlushNativePendingWrites();
+  if (!native_render_targets_active_ || !native_rt_) return true;
+  if (!native_rt::IsVerifiedTilingMarker(marker)) return false;
+  const bool success = marker.type == native_rt::TilingMarkerType::kBegin
+      ? native_rt_->surfaces.BeginCollapsedPass(marker, native_rt_->aliases)
+      : native_rt_->surfaces.EndCollapsedPass(marker, native_rt_->aliases);
+  if (!success) {
+    ++native_fallbacks_count_;
+    REXGPU_ERROR("Native collapsed tiling marker rejected: type={} identity={}",
+                  uint32_t(marker.type), marker.identity);
+  }
+  return success;
+}
