+// Rebase dispatch IDs, rather than rebasing the resolve's coordinates. In
+// particular, the half-pixel fill must run only at the original top edge, and
+// tiled destination addressing must remain relative to the original base.
+// Decode operands, including their immediate payloads, so an immediate with
+// the same bits as an input operand is never accidentally rewritten.
+bool CopyOperand(const std::vector<uint32_t>& source, size_t& position,
+                 size_t end, std::vector<uint32_t>& destination,
+                 uint32_t temporary, unsigned depth = 0) {
+  if (position >= end || depth > 4) return false;
+  uint32_t token = source[position++];
+  uint32_t type = (token >> 12) & 255;
+  uint32_t indices = (token >> 20) & 3;
+  bool thread_id = type == uint32_t(dxbc::OperandType::kInputThreadID);
+  if (thread_id && indices) return false;
+  destination.push_back(thread_id ? ((token & ~(255u << 12)) | (1u << 20)) : token);
+  uint32_t extended = token;
+  while (extended & (1u << 31)) {
+    if (position >= end) return false;
+    extended = source[position++];
+    destination.push_back(extended);
+  }
+  if (thread_id) {
+    destination.push_back(temporary);
+    return true;
+  }
+  if (type == 4 || type == 5) {
+    uint32_t components = token & 3;
+    if (components != 1 && components != 2) return false;
+    size_t count = (components == 1 ? 1 : 4) * (type == 5 ? 2 : 1);
+    if (count > end - position) return false;
+    destination.insert(destination.end(), source.begin() + position,
+                       source.begin() + position + count);
+    position += count;
+    return true;
+  }
+  for (uint32_t i = 0; i < indices; ++i) {
+    uint32_t representation = (token >> (22 + 3 * i)) & 7;
+    if (representation > 4) return false;
+    size_t immediate_count = representation == 0 || representation == 3 ? 1 :
+                             representation == 1 || representation == 4 ? 2 : 0;
+    if (immediate_count > end - position) return false;
+    destination.insert(destination.end(), source.begin() + position,
+                       source.begin() + position + immediate_count);
+    position += immediate_count;
+    if (representation >= 2 &&
+        !CopyOperand(source, position, end, destination, temporary, depth + 1)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool IsDeclaration(uint32_t opcode) {
+  return (opcode >= 88 && opcode <= 106) ||
+         (opcode >= 143 && opcode <= 162);
+}
+
+bool RebaseProgram(const std::vector<uint32_t>& source, uint32_t offset_y,
+                   std::vector<uint32_t>& destination, uint32_t& temporary_out) {
+  if (source.size() < 2 || source[1] != source.size()) return false;
+  uint32_t temporary = UINT32_MAX;
+  for (size_t position = 2; position < source.size();) {
+    uint32_t token = source[position];
+    uint32_t length = (token >> 24) & 127;
+    if (!length || length > source.size() - position) return false;
+    if ((token & 2047) == uint32_t(dxbc::Opcode::kDclTemps)) {
+      if (length != 2 || temporary != UINT32_MAX) return false;
+      temporary = source[position + 1];
+    }
+    position += length;
+  }
+  if (temporary == UINT32_MAX || temporary >= 4096) return false;
+  destination.assign(source.begin(), source.begin() + 2);
+  bool started = false;
+  for (size_t position = 2; position < source.size();) {
+    uint32_t token = source[position];
+    uint32_t opcode = token & 2047;
+    size_t end = position + ((token >> 24) & 127);
+    if (IsDeclaration(opcode)) {
+      if (started) return false;
+      destination.insert(destination.end(), source.begin() + position, source.begin() + end);
+      if (opcode == uint32_t(dxbc::Opcode::kDclTemps)) destination.back() = temporary + 1;
+    } else {
+      if (!started) {
+        dxbc::Statistics statistics{};
+        dxbc::Assembler assembler(destination, statistics);
+        assembler.OpIAdd(dxbc::Dest::R(temporary, 0b0011), dxbc::Src::VThreadID(),
+                         dxbc::Src::LU(0, offset_y, 0, 0));
+        started = true;
+      }
+      size_t instruction = destination.size();
+      destination.push_back(token);
+      size_t operand = position + 1;
+      uint32_t extended = token;
+      while (extended & (1u << 31)) {
+        if (operand >= end) return false;
+        extended = source[operand++];
+        destination.push_back(extended);
+      }
+      while (operand < end) {
+        if (!CopyOperand(source, operand, end, destination, temporary)) return false;
+      }
+      size_t length = destination.size() - instruction;
+      if (length > 127) return false;
+      destination[instruction] = (token & ~(127u << 24)) | (uint32_t(length) << 24);
+    }
+    position = end;
+  }
+  if (!started) return false;
+  destination[1] = uint32_t(destination.size());
+  temporary_out = temporary;
+  return true;
+}
+
+bool RebaseShader(const void* data, size_t size, uint32_t offset_y,
+                  std::vector<uint32_t>& destination) {
+  if (!data || size < sizeof(dxbc::ContainerHeader) || (size & 3)) return false;
+  std::vector<uint32_t> source(size / 4);
+  std::memcpy(source.data(), data, size);
+  dxbc::ContainerHeader header;
+  std::memcpy(&header, source.data(), sizeof(header));
+  if (header.fourcc != dxbc::ContainerHeader::kFourCC || header.size_bytes != size ||
+      header.blob_count > (source.size() - 8)) return false;
+  destination.assign(source.begin(), source.begin() + 8 + header.blob_count);
+  bool found_program = false;
+  uint32_t temporary = 0;
+  for (uint32_t i = 0; i < header.blob_count; ++i) {
+    uint32_t offset = source[8 + i];
+    if ((offset & 3) || offset / 4 > source.size() - 2) return false;
+    size_t position = offset / 4;
+    uint32_t fourcc = source[position];
+    uint32_t blob_size = source[position + 1];
+    if ((blob_size & 3) || blob_size / 4 > source.size() - position - 2) return false;
+    destination[8 + i] = uint32_t(destination.size() * 4);
+    destination.push_back(fourcc);
+    size_t size_position = destination.size();
+    destination.push_back(blob_size);
+    size_t start = destination.size();
+    if (fourcc == uint32_t(dxbc::BlobHeader::FourCC::kShaderEx)) {
+      if (found_program) return false;
+      std::vector<uint32_t> program(source.begin() + position + 2,
+                                    source.begin() + position + 2 + blob_size / 4);
+      std::vector<uint32_t> rebased;
+      if (!RebaseProgram(program, offset_y, rebased, temporary)) return false;
+      destination.insert(destination.end(), rebased.begin(), rebased.end());
+      destination[size_position] = uint32_t(rebased.size() * 4);
+      found_program = true;
+    } else {
+      destination.insert(destination.end(), source.begin() + position + 2,
+                         source.begin() + position + 2 + blob_size / 4);
+    }
+    if (fourcc == uint32_t(dxbc::BlobHeader::FourCC::kStatistics) && found_program &&
+        blob_size >= sizeof(dxbc::Statistics)) {
+      dxbc::Statistics statistics;
+      std::memcpy(&statistics, destination.data() + start, sizeof(statistics));
+      ++statistics.instruction_count;
+      ++statistics.int_instruction_count;
+      statistics.temp_register_count = temporary + 1;
+      std::memcpy(destination.data() + start, &statistics, sizeof(statistics));
+    }
+  }
+  if (!found_program || destination.size() > UINT32_MAX / 4) return false;
+  destination[6] = uint32_t(destination.size() * 4);
+  std::fill(destination.begin() + 1, destination.begin() + 5, 0);
+  CalculateDXBCChecksum(reinterpret_cast<unsigned char*>(destination.data()), destination[6],
+                        reinterpret_cast<unsigned int*>(destination.data() + 1));
+  return true;
+}
+
+struct Band {
+  uint32_t offset_y = 0;
+  uint32_t height = 0;
+  uint32_t first_tile = 0;
+  uint32_t width_tiles = 0;
+  uint32_t height_tiles = 0;
+  ID3D12PipelineState* copy_pipeline = nullptr;
+  ID3D12PipelineState* dump_pipeline = nullptr;
+};
+
+}  // namespace
+
+class ResolveCache::Impl {
+ public:
+  Impl(D3D12RenderTargetCache& host_arg, SurfaceCache& surfaces_arg, AliasCache& aliases_arg)
+      : host(host_arg), surfaces(surfaces_arg), aliases(aliases_arg) {}
+  D3D12RenderTargetCache& host;
+  SurfaceCache& surfaces;
+  AliasCache& aliases;
+  std::unordered_map<uint64_t, ID3D12PipelineState*> stream_pipelines;
+  std::unordered_map<uint32_t, std::vector<uint32_t>> dump_shaders;
+};
+
+ResolveCache::ResolveCache(D3D12RenderTargetCache& host, SurfaceCache& surfaces,
+                         AliasCache& aliases)
+    : impl_(std::make_unique<Impl>(host, surfaces, aliases)) {}
+ResolveCache::~ResolveCache() { Shutdown(); }
+bool ResolveCache::Initialize() { return true; }
+void ResolveCache::Shutdown() {
+  for (auto& entry : impl_->stream_pipelines) {
+    if (entry.second) entry.second->Release();
+  }
+  impl_->stream_pipelines.clear();
+  impl_->dump_shaders.clear();
+}
+void ResolveCache::CompletedSubmissionUpdated() {}
+
+Result ResolveCache::Resolve(const draw_util::ResolveInfo& info, const memory::Memory& memory,
+                             D3D12SharedMemory& shared_memory, D3D12TextureCache& texture_cache,
+                             const TilingState& tiling, uint32_t& written_address_out,
+                             uint32_t& written_length_out) {
+  written_address_out = written_length_out = 0;
+  (void)memory;
+  auto& host = impl_->host;
+  auto& surfaces = impl_->surfaces;
+  auto& aliases = impl_->aliases;
+  surfaces.FlushPendingWrites(aliases);
+  if (!info.coordinate_info.width_div_8 || !info.height_div_8) return Result::kHandled;
+  // Verified tiled merging also needs its explicit destination map. Never
+  // reinterpret a tile-local copy as a full-scene resolve by guessing its pitch.
+  if (tiling.merging()) return Result::kNeedsLegacy;
+  Result clear_preflight = surfaces.CanApplyResolveClear(info, tiling);
+  if (clear_preflight != Result::kHandled) return clear_preflight;
+  if (!info.copy_dest_extent_length) {
+    Result prepared = surfaces.PrepareResolveClear(info, aliases, tiling);
+    if (prepared != Result::kHandled) return prepared;
+    return surfaces.ApplyResolveClear(info, aliases, tiling);
+  }
+
+  const auto edram = info.IsCopyingDepth() ? info.depth_edram_info : info.color_edram_info;
+  uint32_t scale_x = host.draw_resolution_scale_x();
+  uint32_t scale_y = host.draw_resolution_scale_y();
+  uint32_t samples = uint32_t(edram.msaa_samples);
+  if (!scale_x || !scale_y || scale_x > 7 || scale_y > 7 || samples > 2 ||
+      host.IsHostRenderTargetMsaaCollapsed() || host.IsHostRenderTargetSampleGrid() ||
+      !edram.pitch_tiles) return Result::kNeedsLegacy;
+  uint32_t width = info.coordinate_info.width_div_8 * 8;
+  uint32_t height = info.height_div_8 * 8;
+  uint32_t sample_x = uint32_t(samples >= 2);
+  uint32_t sample_y = uint32_t(samples >= 1);
+  uint32_t tile_width = xenos::kEdramTileWidthSamples >> edram.format_is_64bpp;
+  uint32_t tile_height_pixels = xenos::kEdramTileHeightSamples >> sample_y;
+
+  SurfaceKey key;
+  key.base_tiles = info.IsCopyingDepth() ? info.depth_original_base : info.color_original_base;
+  key.pitch_pixels = host.register_file().Get<reg::RB_SURFACE_INFO>().surface_pitch;
+  key.resource_format = info.IsCopyingDepth() ? edram.format :
+      uint32_t(host.GetColorResourceFormat(xenos::ColorRenderTargetFormat(edram.format)));
+  key.msaa_samples_log2 = samples;
+  key.scale_x = scale_x;
+  key.scale_y = scale_y;
+  key.is_depth = info.IsCopyingDepth();
+  if (uint64_t(info.source_x) + width > key.pitch_pixels ||
+      uint64_t(info.source_y) + height > UINT32_MAX) return Result::kNeedsLegacy;
+  Rect rectangle{info.source_x, info.source_y, info.source_x + width, info.source_y + height};
+
+  draw_util::ResolveCopyShaderConstants constants;
+  uint32_t groups_x, groups_y;
+  auto copy_shader = info.GetCopyShader(scale_x, scale_y, constants, groups_x, groups_y);
+  if (copy_shader == draw_util::ResolveCopyShaderIndex::kUnknown || !groups_x || !groups_y)
+    return Result::kNeedsLegacy;
+  const auto& shader_info = draw_util::resolve_copy_shader_info[size_t(copy_shader)];
+  ID3D12PipelineState* copy_pipeline = host.resolve_copy_pipelines_[size_t(copy_shader)];
+  if (!copy_pipeline) return Result::kFailed;
+  D3D12RenderTargetCache::DumpPipelineKey dump_key;
+  dump_key.msaa_samples = edram.msaa_samples;
+  dump_key.resource_format = key.resource_format;
+  dump_key.is_depth = key.is_depth;
+  auto dump_shader = impl_->dump_shaders.find(dump_key.key);
+  ID3D12PipelineState* dump_pipeline;
+  if (dump_shader == impl_->dump_shaders.end()) {
+    std::vector<uint32_t> code;
+    dump_pipeline = host.GetOrCreateDumpPipeline(dump_key, &code);
+    dump_shader = impl_->dump_shaders.emplace(dump_key.key, std::move(code)).first;
+  } else {
+    dump_pipeline = host.GetOrCreateDumpPipeline(dump_key);
+  }
+  if (!dump_pipeline) return Result::kFailed;
+
+  // A band is a contiguous logical tile window smaller than scratch capacity.
+  // Dump addressing may wrap inside scratch; its next band is not recorded
+  // until the previous band's packed copy has consumed those samples.
+  uint32_t first_x_tile = (info.source_x << sample_x) / tile_width;
+  uint32_t last_x_tile = (((info.source_x + width) << sample_x) + tile_width - 1) / tile_width;
+  uint32_t width_tiles = last_x_tile - first_x_tile;
+  uint32_t pitch = edram.pitch_tiles;
+  if (!width_tiles || width_tiles > pitch || width_tiles > xenos::kEdramTileCount)
+    return Result::kNeedsLegacy;
+  uint32_t capacity_rows = (xenos::kEdramTileCount - width_tiles) / pitch + 1;
+  std::vector<Band> bands;
+  for (uint32_t offset_y = 0; offset_y < height;) {
+    uint32_t source_y = info.source_y + offset_y;
+    uint32_t row_offset = source_y % tile_height_pixels;
+    uint32_t band_height = std::min(height - offset_y,
+        (capacity_rows * tile_height_pixels - row_offset) & ~7u);
+    if (!band_height) return Result::kNeedsLegacy;
+    uint64_t first_tile = uint64_t(key.base_tiles) + first_x_tile;
+    // Carry the logical row origin in dispatch IDs, outside the physical
+    // tile bit fields. Source addressing stays unbounded; only scratch wraps.
+    if (first_tile >= (1u << (xenos::kEdramBaseTilesBits + 1))) return Result::kNeedsLegacy;
+    Band band;
+    band.offset_y = offset_y;
+    band.height = band_height;
+    band.first_tile = uint32_t(first_tile);
+    band.width_tiles = width_tiles;
+    band.height_tiles = (row_offset + band_height + tile_height_pixels - 1) / tile_height_pixels;
+    band.copy_pipeline = copy_pipeline;
+    band.dump_pipeline = dump_pipeline;
+    uint32_t dump_offset_y = (source_y / tile_height_pixels) *
+                            xenos::kEdramTileHeightSamples * scale_y;
+    if (dump_offset_y) {
+      uint64_t pipeline_key = (1ull << 63) | (uint64_t(dump_key.key) << 32) | dump_offset_y;
+      auto iterator = impl_->stream_pipelines.find(pipeline_key);
+      if (iterator == impl_->stream_pipelines.end()) {
+        std::vector<uint32_t> rebased;
+        if (!RebaseShader(dump_shader->second.data(), dump_shader->second.size() * 4,
+                          dump_offset_y, rebased)) return Result::kFailed;
+        auto* pipeline = ui::d3d12::util::CreateComputePipeline(
+            host.command_processor_.GetD3D12Provider().GetDevice(), rebased.data(),
+            rebased.size() * sizeof(uint32_t),
+            key.is_depth ? host.dump_root_signature_depth_ : host.dump_root_signature_color_);
+        iterator = impl_->stream_pipelines.emplace(pipeline_key, pipeline).first;
+      }
+      band.dump_pipeline = iterator->second;
+      if (!band.dump_pipeline) return Result::kFailed;
+    }
+    if (offset_y) {
+      uint64_t pipeline_key = (uint64_t(copy_shader) << 32) | (offset_y * scale_y);
+      auto iterator = impl_->stream_pipelines.find(pipeline_key);
+      if (iterator == impl_->stream_pipelines.end()) {
+        const auto& code = host.kResolveCopyShaders[size_t(copy_shader)];
+        bool scaled = scale_x != 1 || scale_y != 1;
+        std::vector<uint32_t> rebased;
+        if (!RebaseShader(scaled ? code.scaled : code.unscaled,
+                          scaled ? code.scaled_size : code.unscaled_size,
+                          offset_y * scale_y, rebased)) return Result::kFailed;
+        auto* pipeline = ui::d3d12::util::CreateComputePipeline(
+            host.command_processor_.GetD3D12Provider().GetDevice(), rebased.data(),
+            rebased.size() * sizeof(uint32_t), host.resolve_copy_root_signature_);
+        iterator = impl_->stream_pipelines.emplace(pipeline_key, pipeline).first;
+      }
+      band.copy_pipeline = iterator->second;
+      if (!band.copy_pipeline) return Result::kFailed;
+    }
+    bands.push_back(band);
+    offset_y += band_height;
+  }
+
+  Result prepared = surfaces.PrepareResolveClear(info, aliases, tiling);
+  if (prepared != Result::kHandled) return prepared;
+  SurfaceId source_id;
+  Result result = surfaces.GetOrCreate(key, {rectangle.right, rectangle.bottom}, aliases, source_id);
+  if (result != Result::kHandled) return Result::kFailed;
+  result = aliases.PrepareRead(source_id, rectangle);
+  if (result != Result::kHandled) return Result::kFailed;
+  SurfaceView source;
+  if (!surfaces.GetView(source_id, source) || !source.resource || !source.srv.ptr ||
+      (key.is_depth && !source.stencil_srv.ptr)) return Result::kFailed;
+
+  bool scaled = scale_x != 1 || scale_y != 1;
+  if (uint64_t(info.copy_dest_extent_start) + info.copy_dest_extent_length > (1ull << 29) ||
+      info.copy_dest_extent_start < info.copy_dest_base) return Result::kFailed;
+  bool committed = scaled ?
+      texture_cache.EnsureScaledResolveMemoryCommitted(info.copy_dest_extent_start,
+                                                       info.copy_dest_extent_length) &&
+      texture_cache.MakeScaledResolveRangeCurrent(info.copy_dest_base,
+          info.copy_dest_extent_start - info.copy_dest_base + info.copy_dest_extent_length) :
+      shared_memory.RequestRange(info.copy_dest_extent_start, info.copy_dest_extent_length);
+  if (!committed) return Result::kFailed;
+
+  auto& processor = host.command_processor_;
+  auto* device = processor.GetD3D12Provider().GetDevice();
+  ui::d3d12::util::DescriptorCpuGpuHandlePair descriptors[5];
+  uint32_t descriptor_count = key.is_depth ? 5 : 4;
+  if (!processor.RequestOneUseSingleViewDescriptors(descriptor_count, descriptors))
+    return Result::kFailed;
+  // Destination packing, scratch SRV, native color/depth SRV, scratch UAV,
+  // optional native stencil SRV. One-use descriptors share submission lifetime.
+  if (scaled) {
+    texture_cache.CreateCurrentScaledResolveRangeUintPow2UAV(descriptors[0].first,
+                                                            shader_info.dest_bpe_log2);
+  } else {
+    shared_memory.WriteUintPow2UAVDescriptor(descriptors[0].first, shader_info.dest_bpe_log2);
+  }
+  if (shader_info.source_is_raw) host.WriteEdramRawSRVDescriptor(descriptors[1].first);
+  else host.WriteEdramUintPow2SRVDescriptor(descriptors[1].first, shader_info.source_bpe_log2);
+  device->CopyDescriptorsSimple(1, descriptors[2].first, source.srv,
+                                D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+  host.WriteEdramUintPow2UAVDescriptor(descriptors[3].first, 2 + edram.format_is_64bpp);
+  if (key.is_depth) {
+    device->CopyDescriptorsSimple(1, descriptors[4].first, source.stencil_srv,
+                                  D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+  }
+  if (!surfaces.Transition(source_id, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE))
+    return Result::kFailed;
+  if (scaled) texture_cache.TransitionCurrentScaledResolveRange(D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  else shared_memory.UseForWriting();
+
+  auto& list = processor.GetDeferredCommandList();
+  D3D12RenderTargetCache::DumpPitches dump_pitches;
+  dump_pitches.source_pitch = pitch;
+  dump_pitches.dest_pitch = pitch;
+  for (const Band& band : bands) {
+    host.TransitionEdramBuffer(D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    list.D3DSetComputeRootSignature(key.is_depth ? host.dump_root_signature_depth_ :
+                                                  host.dump_root_signature_color_);
+    list.D3DSetComputeRootDescriptorTable(host.kDumpRootParameterSource, descriptors[2].second);
+    auto pitches_parameter = key.is_depth ? host.kDumpRootParameterDepthPitches :
+                                           host.kDumpRootParameterColorPitches;
+    auto scratch_parameter = key.is_depth ? host.kDumpRootParameterDepthEdram :
+                                           host.kDumpRootParameterColorEdram;
+    list.D3DSetComputeRoot32BitConstants(pitches_parameter, 1, &dump_pitches, 0);
+    list.D3DSetComputeRootDescriptorTable(scratch_parameter, descriptors[3].second);
+    if (key.is_depth)
+      list.D3DSetComputeRootDescriptorTable(host.kDumpRootParameterDepthStencil,
+                                           descriptors[4].second);
+    D3D12RenderTargetCache::DumpOffsets offsets;
+    offsets.source_base_tiles = key.base_tiles;
+    offsets.dispatch_first_tile = band.first_tile;
+    list.D3DSetComputeRoot32BitConstants(host.kDumpRootParameterOffsets, 1, &offsets, 0);
+    processor.SetExternalPipeline(band.dump_pipeline);
+    processor.SubmitBarriers();
+    list.D3DDispatch((band.width_tiles * scale_x) << uint32_t(!edram.format_is_64bpp),
+                     band.height_tiles * scale_y, 1);
+    host.MarkEdramBufferModified();
+    host.TransitionEdramBuffer(D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+
+    list.D3DSetComputeRootSignature(host.resolve_copy_root_signature_);
+    list.D3DSetComputeRootDescriptorTable(1, descriptors[0].second);
+    list.D3DSetComputeRootDescriptorTable(2, descriptors[1].second);
+    list.D3DSetComputeRoot32BitConstants(0,
+        uint32_t(scaled ? sizeof(constants.dest_relative) : sizeof(constants)) / 4,
+        &constants, 0);
+    processor.SetExternalPipeline(band.copy_pipeline);
+    processor.SubmitBarriers();
+    list.D3DDispatch(groups_x, (band.height * scale_y) >> shader_info.group_size_y_log2, 1);
+    if (scaled) texture_cache.MarkCurrentScaledResolveRangeUAVWritesCommitNeeded();
+    else shared_memory.MarkUAVWritesCommitNeeded();
+  }
+
+  // Publish only after every band has produced the authoritative packed bytes.
+  // CacheHostResolve also installs the CPU-write watches for its immutable copy.
+  bool snapshot = false;
+  if (!key.is_depth && samples == 0 &&
+      copy_shader == draw_util::ResolveCopyShaderIndex::kFast32bpp1x2xMSAA) {
+    if (surfaces.Transition(source_id, D3D12_RESOURCE_STATE_COPY_SOURCE)) {
+      D3D12_BOX box{rectangle.left * scale_x, rectangle.top * scale_y, 0,
+                    rectangle.right * scale_x, rectangle.bottom * scale_y, 1};
+      snapshot = texture_cache.CacheHostResolve(info, source.resource, box);
+    }
+  }
+  if (!snapshot) texture_cache.MarkRangeAsResolved(info.copy_dest_extent_start,
+                                                  info.copy_dest_extent_length, scaled);
+  written_address_out = info.copy_dest_extent_start;
+  written_length_out = info.copy_dest_extent_length;
+  result = surfaces.ApplyResolveClear(info, aliases, tiling);
+  if (result != Result::kHandled) {
+    REXGPU_ERROR("Native resolve clear failed after packed resolve publication");
+    return Result::kFailed;
+  }
+  surfaces.InvalidateBindings();
+  return Result::kHandled;
+}
