diff --git a/include/rex/graphics/d3d12/native_rt/aliases.h b/include/rex/graphics/d3d12/native_rt/aliases.h
new file mode 100644
index 0000000..a9ebcf9
--- /dev/null
+++ b/include/rex/graphics/d3d12/native_rt/aliases.h
@@ -0,0 +1,57 @@
+// Logical render target interfaces. GPL-3.0-only.
+#pragma once
+
+#include <memory>
+#include <rex/graphics/d3d12/native_rt/types.h>
+
+namespace rex::graphics::d3d12 {
+class D3D12RenderTargetCache;
+namespace native_rt {
+class SurfaceCache;
+struct TilingMarker;
+
+class AliasCache final {
+ public:
+  AliasCache(D3D12RenderTargetCache& host, SurfaceCache& surfaces);
+  ~AliasCache();
+  bool Initialize();
+  bool BeginCollapsedPass(const TilingMarker& marker);
+  bool EndCollapsedPass(const TilingMarker& marker);
+  void Shutdown();
+  void CompletedSubmissionUpdated();
+  // Materialize the latest overlapping producer only when it is read. Keep
+  // untouched pixels, depth precision, stencil and individual samples intact.
+  Result PrepareRead(SurfaceId destination, Rect rectangle);
+  void NotifyWrite(SurfaceId surface, Rect rectangle);
+  void NotifyClear(SurfaceId surface, Rect rectangle, uint64_t packed_guest_value);
+  struct Counters {
+    uint64_t converted_samples = 0, clear_converted_regions = 0;
+    uint64_t bridge_exports = 0, bridge_imports = 0;
+    // Inclusive steady-clock elapsed time, collected only with frame metrics.
+    uint64_t prepare_read_calls = 0, prepare_read_us = 0;
+    uint64_t notify_write_calls = 0, notify_write_us = 0;
+  };
+  const Counters& counters() const;
+  // Explicit bridge for unsupported operations. Validate ALL spans before
+  // export. Success guarantees the legacy window contains current native data.
+  // A transaction may contain only representable, unambiguous EDRAM windows.
+  Result ExportToLegacy(const LegacySpan* spans, size_t count,
+                        LegacyTransaction& transaction_out);
+  // Import every may_write span from the completed legacy operation, then
+  // invalidate bindings and publish native content versions. Never optional.
+  bool ImportFromLegacy(LegacyTransaction transaction);
+  // Preserves existing native data when an allocation grows or is replaced.
+  Result PreserveContents(const SurfaceView& source, const SurfaceView& destination,
+                          Rect rectangle);
+  // Record an exact same-layout projection without publishing alias ownership.
+  // source_y corresponds to destination_rectangle.top; X coordinates match.
+  // The caller publishes the destination only after all projections succeed.
+  Result ProjectSurface(const SurfaceView& source, const SurfaceView& destination,
+                        uint32_t source_y, Rect destination_rectangle);
+
+ private:
+  class Impl;
+  std::unique_ptr<Impl> impl_;
+};
+}  // namespace native_rt
+}  // namespace rex::graphics::d3d12
diff --git a/include/rex/graphics/d3d12/native_rt/interval_assignment.h b/include/rex/graphics/d3d12/native_rt/interval_assignment.h
new file mode 100644
index 0000000..841a51c
--- /dev/null
+++ b/include/rex/graphics/d3d12/native_rt/interval_assignment.h
@@ -0,0 +1,80 @@
+// Allocation reuse for logical render-target interval updates. GPL-3.0-only.
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <iterator>
+#include <utility>
+
+namespace rex::graphics::d3d12::native_rt {
+
+template <typename Map, typename Range, typename EqualContent>
+void AssignIntervalReusingNodes(Map& ranges, const Range& replacement,
+                                EqualContent equal_content) {
+  if (replacement.first >= replacement.end) return;
+  auto after = ranges.lower_bound({replacement.domain, replacement.first});
+  if (after != ranges.begin()) {
+    auto before = std::prev(after);
+    if (before->second.domain == replacement.domain && before->second.end > replacement.first)
+      after = before;
+  }
+  if (after != ranges.end() && after->second.domain == replacement.domain &&
+      after->second.first <= replacement.first && after->second.end >= replacement.end &&
+      equal_content(after->second, replacement)) return;
+
+  // At most three nodes survive an overwrite: the left edge, replacement and
+  // right edge. Retain storage from removed intervals for those three writes.
+  std::array<typename Map::node_type, 3> reusable;
+  std::size_t saved = 0, consumed = 0;
+  Range left{}, right{};
+  bool keep_left = false, keep_right = false;
+  while (after != ranges.end() && after->second.domain == replacement.domain &&
+         after->second.first < replacement.end) {
+    auto removed = after++;
+    const Range& old = removed->second;
+    if (old.end <= replacement.first) continue;
+    if (old.first < replacement.first) {
+      left = old;
+      left.end = replacement.first;
+      keep_left = true;
+    }
+    if (old.end > replacement.end) {
+      right = old;
+      right.first = replacement.end;
+      keep_right = true;
+    }
+    if (saved < reusable.size()) reusable[saved++] = ranges.extract(removed);
+    else ranges.erase(removed);
+  }
+  auto store = [&](const Range& value) {
+    const auto key = std::make_pair(value.domain, value.first);
+    if (consumed < saved) {
+      auto& node = reusable[consumed++];
+      node.key() = key;
+      node.mapped() = value;
+      return ranges.insert(after, std::move(node));
+    }
+    return ranges.emplace_hint(after, key, value);
+  };
+  if (keep_left) store(left);
+  auto inserted = store(replacement);
+  if (keep_right) store(right);
+
+  if (inserted != ranges.begin()) {
+    auto before = std::prev(inserted);
+    if (before->second.end == inserted->second.first &&
+        equal_content(before->second, inserted->second)) {
+      before->second.end = inserted->second.end;
+      ranges.erase(inserted);
+      inserted = before;
+    }
+  }
+  auto next = std::next(inserted);
+  if (next != ranges.end() && inserted->second.end == next->second.first &&
+      equal_content(inserted->second, next->second)) {
+    inserted->second.end = next->second.end;
+    ranges.erase(next);
+  }
+}
+
+}  // namespace rex::graphics::d3d12::native_rt
