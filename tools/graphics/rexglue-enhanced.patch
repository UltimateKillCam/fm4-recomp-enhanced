+
+class SurfaceCache::Impl {
+ public:
+  explicit Impl(D3D12RenderTargetCache& host_in) : host(host_in) {}
+  struct Entry {
+    SurfaceKey key;
+    Extent extent;
+    void* backing = nullptr;
+  };
+  struct Retired {
+    void* backing;
+    uint64_t submission;
+    SurfaceKey key{};
+    Extent extent{};
+    bool reusable = false;
+  };
+  D3D12RenderTargetCache& host;
+  bool initialized = false;
+  std::vector<Entry> entries;
+  std::unordered_map<SurfaceKey, SurfaceId, KeyHash> by_key;
+  std::vector<Retired> retired;
+  std::vector<Entry> spare;
+  DrawBinding binding;
+  uint32_t write_mask = 0;
+  bool read_coverage_valid = false;
+  DrawBinding read_binding;
+  uint32_t read_write_mask = 0;
+  Rect read_rectangle{};
+  bool batch_eligible = false;
+  std::array<SurfaceId, 5> pending_attachments{};
+  uint32_t pending_write_mask = 0;
+  std::array<std::vector<Rect>, 5> pending_rectangles;
+  bool clear_prepared = false;
+  std::array<uint32_t, 13> clear_signature{};
+  std::array<SurfaceId, 2> clear_ids{};
+  Rect clear_rectangle{};
+  enum class CpuStage { kDraw, kExtent, kSentinel, kGetCreate };
+  struct CpuMetrics {
+    std::chrono::steady_clock::time_point window_start{};
+    uint64_t draw_calls = 0, draw_ns = 0;
+    uint64_t extent_calls = 0, extent_ns = 0;
+    uint64_t sentinel_calls = 0, sentinel_ns = 0;
+    uint64_t get_create_calls = 0, get_create_ns = 0;
+    uint64_t constant_rectangle_hits = 0, direct_vs_calls = 0, direct_vs_indices = 0;
+    uint64_t setup_reuses = 0;
+  } cpu;
+  // Reset interval totals after each log, emitted only by the outer draw
+  // scope. Draw includes extent, extent includes sentinel. Get/create covers
+  // all callers (draws and resolve/clear preparation), not just PrepareDraw.
+  void FlushCpu(std::chrono::steady_clock::time_point now) {
+    if (cpu.window_start == std::chrono::steady_clock::time_point{}) return;
+    auto interval_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+        now - cpu.window_start).count();
+    if (interval_ms < 1000) return;
+    REXGPU_INFO("Native RT surface CPU: interval_ms={} draw_calls={} draw_us={} "
+                "extent_us={} sentinel_calls={} sentinel_us={} get_create_us={} "
+                "extent_calls={} get_create_calls={} constant_rectangle_hits={} "
+                "direct_vs_calls={} direct_vs_indices={} setup_reuses={}",
+                interval_ms, cpu.draw_calls, cpu.draw_ns / 1000,
+                cpu.extent_ns / 1000, cpu.sentinel_calls, cpu.sentinel_ns / 1000,
+                cpu.get_create_ns / 1000, cpu.extent_calls, cpu.get_create_calls,
+                cpu.constant_rectangle_hits, cpu.direct_vs_calls, cpu.direct_vs_indices,
+                cpu.setup_reuses);
+    cpu = {};
+    cpu.window_start = now;
+  }
+  class CpuScope {
+   public:
+    CpuScope(Impl& owner, CpuStage stage) : owner_(owner), stage_(stage),
+        enabled_(fm4::frame_metrics::Get().enabled) {
+      if (!enabled_) return;
+      start_ = std::chrono::steady_clock::now();
+      if (owner_.cpu.window_start == std::chrono::steady_clock::time_point{})
+        owner_.cpu.window_start = start_;
+    }
+    ~CpuScope() {
+      if (!enabled_) return;
+      auto end = std::chrono::steady_clock::now();
+      uint64_t ns = uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(end - start_).count());
+      auto& cpu = owner_.cpu;
+      switch (stage_) {
+        case CpuStage::kDraw: ++cpu.draw_calls; cpu.draw_ns += ns; break;
+        case CpuStage::kExtent: ++cpu.extent_calls; cpu.extent_ns += ns; break;
+        case CpuStage::kSentinel: ++cpu.sentinel_calls; cpu.sentinel_ns += ns; break;
+        case CpuStage::kGetCreate: ++cpu.get_create_calls; cpu.get_create_ns += ns; break;
+      }
+      if (stage_ == CpuStage::kDraw) owner_.FlushCpu(end);
+    }
+    bool enabled() const { return enabled_; }
+   private:
+    Impl& owner_;
+    CpuStage stage_;
+    bool enabled_;
+    std::chrono::steady_clock::time_point start_{};
+  };
+  struct Family {
+    uint64_t domain;
+    uint32_t first, end, pitch, samples, words;
+  };
+  TilingMarker collapsed;
+  bool collapsed_active = false;
+  bool families_locked = false;
+  uint64_t next_domain = 1;
+  std::vector<Family> families;
+  std::vector<size_t> free_entries;
+  Result Stamp(SurfaceKey& key, bool create) {
+    if (!collapsed_active) return key.native_domain ? Result::kNeedsLegacy : Result::kHandled;
+    if (key.native_domain) {
+      for (const auto& family : families) {
+        if (family.domain == key.native_domain) return Result::kHandled;
+      }
+      return Result::kNeedsLegacy;
+    }
+    if (key.msaa_samples_log2 > 2 || !key.pitch_pixels) return Result::kNeedsLegacy;
+    uint32_t words = !key.is_depth && xenos::IsColorRenderTargetFormat64bpp(
+        xenos::ColorRenderTargetFormat(key.resource_format)) ? 2 : 1;
+    uint32_t tile_width = (80 / words) >> uint32_t(key.msaa_samples_log2 >= 2);
+    uint32_t tile_height = 16 >> uint32_t(key.msaa_samples_log2 >= 1);
+    if (key.pitch_pixels % tile_width) return Result::kNeedsLegacy;
+    uint32_t pitch = key.pitch_pixels / tile_width;
+    uint64_t end = uint64_t(key.base_tiles) +
+        uint64_t(pitch) * ((collapsed.max_band_height + tile_height - 1) / tile_height);
+    if (end > xenos::kEdramTileCount) return Result::kNeedsLegacy;
+    for (const auto& family : families) {
+      if (key.base_tiles == family.first) {
+        // A flat full-scene domain is valid only for equal band-local layouts.
+        // Different pitch/bpp/MSAA needs explicit per-band coordinate mapping.
+        if (pitch != family.pitch || key.msaa_samples_log2 != family.samples ||
+            words != family.words) return Result::kNeedsLegacy;
+        key.native_domain = family.domain;
+        return Result::kHandled;
+      }
+      if (key.base_tiles < family.end && family.first < end) return Result::kNeedsLegacy;
+    }
+    if (!create || families_locked) return Result::kNeedsLegacy;
+    key.native_domain = next_domain++;
+    families.push_back({key.native_domain, key.base_tiles, uint32_t(end), pitch,
+                        key.msaa_samples_log2, words});
+    return Result::kHandled;
+  }
+  uint32_t failure_diagnostics = 0;
+  void Diagnose(const char* stage, const char* reason, Result result,
+                const SurfaceKey& key, Extent requested, Rect rectangle,
+                SurfaceId surface = kInvalidSurface) {
+    if (failure_diagnostics >= 32) return;
+    ++failure_diagnostics;
+    Extent current{};
+    if (surface && surface <= entries.size()) current = entries[size_t(surface - 1)].extent;
+    REXGPU_ERROR("Native surface failure: n={} stage={} reason={} result={} surface={} "
+                 "base={} pitch={} format={} depth={} samples_log2={} scale={}x{} "
+                 "requested={}x{} current={}x{} rect={},{},{},{} initialized={} entries={}",
+                 failure_diagnostics, stage, reason, uint32_t(result), surface,
+                 key.base_tiles, key.pitch_pixels, key.resource_format, key.is_depth,
+                 key.msaa_samples_log2, key.scale_x, key.scale_y,
+                 requested.width, requested.height, current.width, current.height,
+                 rectangle.left, rectangle.top, rectangle.right, rectangle.bottom,
+                 initialized, entries.size());
+  }
+};
+
+SurfaceCache::SurfaceCache(D3D12RenderTargetCache& host)
+    : impl_(std::make_unique<Impl>(host)) {}
+
+SurfaceCache::~SurfaceCache() { Shutdown(); }
+
+bool SurfaceCache::Initialize() {
+  impl_->initialized = true;
+  return true;
+}
+
+bool SurfaceCache::BeginCollapsedPass(const TilingMarker& marker, AliasCache& aliases) {
+  FlushPendingWrites(aliases);
+  if (!impl_->initialized || impl_->collapsed_active ||
+      marker.type != TilingMarkerType::kBegin || !IsVerifiedTilingMarker(marker) ||
+      !aliases.BeginCollapsedPass(marker)) return false;
+  impl_->collapsed = marker;
+  impl_->collapsed_active = true;
+  impl_->families_locked = false;
+  impl_->families.clear();
+  impl_->clear_prepared = false;
+  return true;
+}
+
+bool SurfaceCache::IsCollapsedDomain(uint64_t domain) const {
+  if (!domain || !impl_->collapsed_active) return false;
+  return std::any_of(impl_->families.begin(), impl_->families.end(),
+                      [domain](const auto& family) { return family.domain == domain; });
+}
+
+bool SurfaceCache::EndCollapsedPass(const TilingMarker& marker, AliasCache& aliases) {
+  FlushPendingWrites(aliases);
+  if (!impl_->collapsed_active || marker.type != TilingMarkerType::kEnd ||
+      marker.identity != impl_->collapsed.identity || !aliases.EndCollapsedPass(marker)) return false;
+  auto& host = impl_->host;
+  for (size_t index = 0; index < impl_->entries.size(); ++index) {
+    auto& entry = impl_->entries[index];
+    if (!entry.backing || !IsCollapsedDomain(entry.key.native_domain)) continue;
+    impl_->retired.push_back({entry.backing, host.command_processor_.GetCurrentSubmission(),
+                             entry.key, entry.extent, true});
+    impl_->by_key.erase(entry.key);
+    entry.backing = nullptr;
+    impl_->free_entries.push_back(index);
+  }
+  impl_->collapsed_active = false;
+  impl_->families_locked = false;
+  impl_->families.clear();
+  impl_->clear_prepared = false;
+  impl_->binding = {};
+  impl_->write_mask = 0;
+  impl_->pending_write_mask = 0;
+  for (auto& rectangles : impl_->pending_rectangles) rectangles.clear();
+  impl_->read_coverage_valid = false;
+  InvalidateBindings();
+  return true;
+}
+
+void SurfaceCache::Shutdown() {
+  // The host shuts down after its command queue has become idle, as for the
+  // existing render-target cache. Retirement during normal operation is fenced.
+  for (auto& entry : impl_->entries) {
+    delete static_cast<D3D12RenderTargetCache::D3D12RenderTarget*>(entry.backing);
+  }
+  for (auto& retired : impl_->retired) {
+    delete static_cast<D3D12RenderTargetCache::D3D12RenderTarget*>(retired.backing);
+  }
+  for (auto& spare : impl_->spare) {
+    delete static_cast<D3D12RenderTargetCache::D3D12RenderTarget*>(spare.backing);
+  }
+  impl_->entries.clear();
+  impl_->by_key.clear();
+  impl_->retired.clear();
+  impl_->spare.clear();
+  impl_->free_entries.clear();
+  impl_->families.clear();
+  impl_->collapsed_active = false;
+  impl_->families_locked = false;
+  impl_->binding = {};
+  impl_->write_mask = 0;
+  impl_->clear_prepared = false;
+  impl_->initialized = false;
+}
+
+void SurfaceCache::BeginSubmission() { InvalidateBindings(); }
+
+void SurfaceCache::CompletedSubmissionUpdated() {
+  uint64_t completed = impl_->host.command_processor_.GetCompletedSubmission();
+  auto& retired = impl_->retired;
+  for (auto it = retired.begin(); it != retired.end();) {
+    if (it->submission <= completed) {
+      if (it->reusable) {
+        impl_->spare.push_back({it->key, it->extent, it->backing});
+      } else {
+        delete static_cast<D3D12RenderTargetCache::D3D12RenderTarget*>(it->backing);
+      }
+      it = retired.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+
+void SurfaceCache::InvalidateBindings() {
+  impl_->host.are_current_command_list_render_targets_valid_ = false;
+  impl_->read_coverage_valid = false;
+}
+
+const DrawBinding& SurfaceCache::binding() const { return impl_->binding; }
+
+bool SurfaceCache::Find(const SurfaceKey& requested_key, SurfaceId& surface_out) const {
+  SurfaceKey key = requested_key;
+  if (impl_->Stamp(key, false) != Result::kHandled) {
+    surface_out = kInvalidSurface;
+    return false;
+  }
+  auto it = impl_->by_key.find(key);
+  surface_out = it == impl_->by_key.end() ? kInvalidSurface : it->second;
+  return surface_out != kInvalidSurface;
+}
+
+void* SurfaceCache::GetBacking(SurfaceId surface) const {
+  return surface && surface <= impl_->entries.size() ? impl_->entries[size_t(surface - 1)].backing
+                                                    : nullptr;
+}
+
+bool SurfaceCache::GetView(SurfaceId surface, SurfaceView& view_out) const {
+  auto* target = static_cast<D3D12RenderTargetCache::D3D12RenderTarget*>(GetBacking(surface));
+  if (!target) {
+    view_out = {};
+    return false;
+  }
+  const auto& entry = impl_->entries[size_t(surface - 1)];
+  view_out = {};
+  view_out.id = surface;
+  view_out.key = entry.key;
+  view_out.extent = entry.extent;
+  view_out.resource = target->resource();
+  view_out.backend_target = target;
+  view_out.draw = target->descriptor_draw().GetHandle();
+  view_out.srv = target->descriptor_srv().GetHandle();
+  if (target->descriptor_srv_stencil().IsValid()) {
+    view_out.stencil_srv = target->descriptor_srv_stencil().GetHandle();
+  }
+  view_out.host_sample_count = target->resource()->GetDesc().SampleDesc.Count;
+  view_out.resource_state = target->resource_state();
+  return true;
+}
+
+bool SurfaceCache::Transition(SurfaceId surface, D3D12_RESOURCE_STATES state) {
+  auto* target = static_cast<D3D12RenderTargetCache::D3D12RenderTarget*>(GetBacking(surface));
+  if (!target) {
+    return false;
+  }
+  impl_->host.command_processor_.PushTransitionBarrier(target->resource(),
+                                                       target->SetResourceState(state), state);
+  return true;
+}
+
+Result SurfaceCache::GetOrCreate(const SurfaceKey& key, Extent minimum_extent,
+                                 AliasCache& aliases, SurfaceId& surface_out) {
+  return GetOrCreateForDomain(key, minimum_extent, aliases, surface_out, false);
+}
+
+Result SurfaceCache::GetOrCreateGlobal(const SurfaceKey& key, Extent minimum_extent,
+                                       AliasCache& aliases, SurfaceId& surface_out) {
+  return GetOrCreateForDomain(key, minimum_extent, aliases, surface_out, true);
+}
+
+Result SurfaceCache::GetOrCreateForDomain(const SurfaceKey& requested_key, Extent minimum_extent,
+                                          AliasCache& aliases, SurfaceId& surface_out, bool global) {
+  Impl::CpuScope cpu_scope(*impl_, Impl::CpuStage::kGetCreate);
+  SurfaceKey key = requested_key;
+  surface_out = kInvalidSurface;
+  if (global) {
+    key.native_domain = 0;
+  } else if (impl_->Stamp(key, true) != Result::kHandled) {
+    impl_->Diagnose("allocate", "collapsed-layout-domain", Result::kFailed, key, minimum_extent, {});
+    return Result::kFailed;
+  }
+  if (!impl_->initialized || key.msaa_samples_log2 > 2 || !key.scale_x || !key.scale_y ||
+      minimum_extent.width > key.pitch_pixels) {
+    impl_->Diagnose("allocate", "invalid-request", Result::kNeedsLegacy, key, minimum_extent, {});
+    return Result::kNeedsLegacy;
+  }
+  Extent extent = PaddedExtent(key, minimum_extent);
+  if (!ValidExtent(key, extent)) {
+    impl_->Diagnose("allocate", "invalid-padded-extent", Result::kNeedsLegacy, key, extent, {});
+    return Result::kNeedsLegacy;
+  }
+  auto& host = impl_->host;
+  if (key.scale_x != host.draw_resolution_scale_x() ||
+      key.scale_y != host.draw_resolution_scale_y()) {
+    impl_->Diagnose("allocate", "scale-mismatch", Result::kNeedsLegacy, key, extent, {});
+    return Result::kNeedsLegacy;
+  }
+  SurfaceId existing;
+  auto existing_it = impl_->by_key.find(key);
+  existing = existing_it == impl_->by_key.end() ? kInvalidSurface : existing_it->second;
+  if (existing) {
+    const auto& entry = impl_->entries[size_t(existing - 1)];
+    if (entry.extent.height >= extent.height) {
+      surface_out = existing;
+      return Result::kHandled;
+    }
+    FlushPendingWrites(aliases);
+    InvalidateBindings();
+  }
+  RenderTargetCache::RenderTargetKey backend_key;
+  backend_key.base_tiles = key.base_tiles;
+  backend_key.pitch_tiles_at_32bpp =
+      ((key.pitch_pixels << uint32_t(key.msaa_samples_log2 >= 2)) +
+       xenos::kEdramTileWidthSamples - 1) / xenos::kEdramTileWidthSamples;
+  backend_key.msaa_samples = xenos::MsaaSamples(key.msaa_samples_log2);
+  backend_key.is_depth = key.is_depth;
+  backend_key.resource_format = key.resource_format;
+  backend_key.unscaled = 0;
+  D3D12RenderTargetCache::D3D12RenderTarget* replacement = nullptr;
+  if (key.native_domain && !existing) {
+    for (auto it = impl_->spare.begin(); it != impl_->spare.end(); ++it) {
+      SurfaceKey layout = it->key;
+      layout.native_domain = key.native_domain;
+      if (layout == key && it->extent.width == extent.width && it->extent.height >= extent.height) {
+        replacement = static_cast<D3D12RenderTargetCache::D3D12RenderTarget*>(it->backing);
+        extent = it->extent;
+        impl_->spare.erase(it);
+        break;
+      }
+    }
+  }
+  if (!replacement) {
+    replacement = static_cast<D3D12RenderTargetCache::D3D12RenderTarget*>(
+        host.CreateRenderTargetWithExtent(backend_key, extent.width * key.scale_x,
+                                          extent.height * key.scale_y));
+  }
+  if (!replacement) {
+    impl_->Diagnose("allocate", "resource-or-descriptor-creation", Result::kFailed, key, extent, {}, existing);
+    return Result::kFailed;
+  }
+  if (existing) {
+    SurfaceView old_view;
+    GetView(existing, old_view);
+    SurfaceView new_view = old_view;
+    new_view.resource = replacement->resource();
+    new_view.backend_target = replacement;
+    new_view.extent = extent;
+    new_view.draw = replacement->descriptor_draw().GetHandle();
+    new_view.srv = replacement->descriptor_srv().GetHandle();
+    if (replacement->descriptor_srv_stencil().IsValid()) {
+      new_view.stencil_srv = replacement->descriptor_srv_stencil().GetHandle();
+    }
+    new_view.resource_state = replacement->resource_state();
+    Result preserved = aliases.PreserveContents(
+        old_view, new_view, {0, 0, old_view.extent.width, old_view.extent.height});
+    if (preserved != Result::kHandled) {
+      // Keep even a rejected allocation fenced: a conversion may have failed
+      // after recording part of its work, before publishing replacement data.
+      impl_->retired.push_back({replacement, host.command_processor_.GetCurrentSubmission()});
+      impl_->Diagnose("grow", "preserve-contents", preserved, key, extent,
+                      {0, 0, old_view.extent.width, old_view.extent.height}, existing);
+      return preserved;
+    }
+    auto& entry = impl_->entries[size_t(existing - 1)];
+    impl_->retired.push_back({entry.backing, host.command_processor_.GetCurrentSubmission()});
+    entry.backing = replacement;
+    entry.extent = extent;
+    surface_out = existing;
+    InvalidateBindings();
+    return Result::kHandled;
+  }
+  if (impl_->free_entries.empty()) {
+    impl_->entries.push_back({key, extent, replacement});
+    surface_out = SurfaceId(impl_->entries.size());
+  } else {
+    size_t slot = impl_->free_entries.back();
+    impl_->free_entries.pop_back();
+    impl_->entries[slot] = {key, extent, replacement};
+    surface_out = SurfaceId(slot + 1);
+  }
+  impl_->by_key.emplace(key, surface_out);
+  return Result::kHandled;
+}
+
+Result SurfaceCache::PrepareDraw(bool rasterization_done, reg::RB_DEPTHCONTROL depth_control,
+                                 uint32_t color_mask, const Shader& vertex_shader,
+                                 AliasCache& aliases, const TilingState& tiling) {
+  Impl::CpuScope cpu_scope(*impl_, Impl::CpuStage::kDraw);
+  auto& host = impl_->host;
+  const RegisterFile& regs = host.register_file();
+  auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  uint32_t sample_log2 = uint32_t(surface_info.msaa_samples);
+  if (sample_log2 > 2 || surface_info.surface_pitch > xenos::kTexture2DCubeMaxWidthHeight) {
+    SurfaceKey invalid;
+    invalid.pitch_pixels = surface_info.surface_pitch;
+    invalid.msaa_samples_log2 = sample_log2;
+    impl_->Diagnose("prepare-draw", "invalid-surface-register", Result::kNeedsLegacy,
+                    invalid, {}, {});
+    return Result::kNeedsLegacy;
+  }
+  DrawBinding next;
+  next.scale_x = host.draw_resolution_scale_x();
+  next.scale_y = host.draw_resolution_scale_y();
+  uint32_t write_mask = 0;
+  std::array<SurfaceKey, 5> keys{};
+  if (rasterization_done && surface_info.surface_pitch) {
+    if (depth_control.z_enable || depth_control.stencil_enable) {
+      auto depth = regs.Get<reg::RB_DEPTH_INFO>();
+      keys[0].base_tiles = depth.depth_base;
+      keys[0].resource_format = uint32_t(depth.depth_format);
+      keys[0].is_depth = true;
+      next.bound_mask |= 1;
+      if ((depth_control.z_enable && depth_control.z_write_enable) ||
+          depth_control.stencil_enable) {
+        write_mask |= 1;
+      }
+    }
+    for (uint32_t color = 0; color < xenos::kMaxColorRenderTargets; ++color) {
+      if (!(color_mask & (0xFu << (color * 4)))) {
+        continue;
+      }
+      auto info = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[color]);
+      keys[color + 1].base_tiles = info.color_base;
+      keys[color + 1].resource_format = uint32_t(host.GetColorResourceFormat(info.color_format));
+      next.bound_mask |= 1u << (color + 1);
+      write_mask |= 1u << (color + 1);
+    }
+  }
+  // Same priority as the existing backend: earlier color slots win, and color
+  // wins over depth if the guest has left conflicting bindings in its state.
+  for (uint32_t color = 1; color < keys.size(); ++color) {
+    if (!(next.bound_mask & (1u << color))) {
+      continue;
+    }
+    for (uint32_t other = 0; other < keys.size(); ++other) {
+      if ((other == 0 || other > color) && (next.bound_mask & (1u << other)) &&
+          keys[color].base_tiles == keys[other].base_tiles) {
+        next.bound_mask &= ~(1u << other);
+        write_mask &= ~(1u << other);
+      }
+    }
+  }
+  draw_util::Scissor scissor{};
+  draw_util::GetScissor(regs, scissor);
+  Rect rectangle{scissor.offset[0], scissor.offset[1],
+                 scissor.offset[0] + scissor.extent[0],
+                 scissor.offset[1] + scissor.extent[1]};
+  if (next.bound_mask) {
+    Impl::CpuScope extent_scope(*impl_, Impl::CpuStage::kExtent);
+    rectangle.bottom = std::min(rectangle.bottom,
+                                host.draw_extent_estimator_.EstimateMaxY(true, vertex_shader));
+    if (regs.Get<reg::PA_CL_CLIP_CNTL>().clip_disable &&
+        rectangle.bottom >= xenos::kTexture2DCubeMaxWidthHeight) {
+      Impl::CpuScope sentinel_scope(*impl_, Impl::CpuStage::kSentinel);
+      // The general estimator's vertex execution is gated by a legacy global
+      // option. Native resources have no EDRAM height cap to hide an unbounded
+      // 8192 scissor, so determine this draw's actual vertex extent directly.
+      // A viewport is not a clipping bound when guest clipping is disabled.
+      uint32_t constant_rectangle[4];
+      uint32_t vertex_bottom;
+      if (host.draw_extent_estimator_.GetUnclippedRectangle(vertex_shader,
+                                                            constant_rectangle)) {
+        if (sentinel_scope.enabled()) ++impl_->cpu.constant_rectangle_hits;
+        // This proof accepts integral constant-only screen rectangles and
+        // returns a one-pixel inset. Restore its outer edge, then apply the
+        // same half-pixel/MSAA coverage rule as EstimateVertexMaxY.
+        vertex_bottom = constant_rectangle[3] + 1;
+        if (sample_log2 &&
+            regs.Get<reg::PA_SU_VTX_CNTL>().pix_center == xenos::PixelCenter::kD3DZero) {
+          ++vertex_bottom;
+        }
+      } else {
+        if (sentinel_scope.enabled()) {
+          ++impl_->cpu.direct_vs_calls;
+          impl_->cpu.direct_vs_indices += regs.Get<reg::VGT_DRAW_INITIATOR>().num_indices;
+        }
+        vertex_bottom = host.draw_extent_estimator_.EstimateVertexMaxY(vertex_shader);
+      }
+      rectangle.bottom = std::min(rectangle.bottom, vertex_bottom);
+    }
+    tiling.OverrideRasterRectangle(rectangle, false);
+  }
+  rectangle.left = std::min(rectangle.left, uint32_t(surface_info.surface_pitch));
+  rectangle.right = std::min(rectangle.right, uint32_t(surface_info.surface_pitch));
+  next.written_rectangle = rectangle;
+  Extent required{surface_info.surface_pitch, std::max(rectangle.bottom, 1u)};
+  // Reserve the declared viewport rather than the current tight draw scissor.
+  // In tiled playback this can expose the complete scene extent on its first
+  // band. It also avoids repeated MSAA/depth reallocations across ordinary
+  // narrow scissors. Oversized/disabled viewports do not force huge textures.
+  auto viewport_control = regs.Get<reg::PA_CL_VTE_CNTL>();
+  if (next.bound_mask && viewport_control.vport_y_offset_ena &&
+      viewport_control.vport_y_scale_ena && !regs.Get<reg::PA_CL_CLIP_CNTL>().clip_disable) {
+    double viewport_bottom = double(regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET)) +
+                             std::abs(double(regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE)));
+    if (regs.Get<reg::PA_SU_SC_MODE_CNTL>().vtx_window_offset_enable) {
+      viewport_bottom += regs.Get<reg::PA_SC_WINDOW_OFFSET>().window_y_offset;
+    }
+    if (regs.Get<reg::PA_SU_VTX_CNTL>().pix_center == xenos::PixelCenter::kD3DZero) {
+      viewport_bottom += 0.5;
+    }
+    uint32_t max_height = D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION / next.scale_y;
+    if (std::isfinite(viewport_bottom) && viewport_bottom > 0.0 &&
+        viewport_bottom <= double(max_height)) {
+      // Match EstimateMaxY and the host viewport's truncating coverage bound.
+      // Rounding an integer+.5 upward would trigger an unnecessary allocation
+      // growth after an exactly sized clear (720 becomes 721, then 736 padded).
+      required.height = std::max(required.height, uint32_t(viewport_bottom));
+    }
+  }
+  if (tiling.merging()) {
+    required.height = std::max(required.height, tiling.full_extent().height);
+  }
+  if (REXCVAR_GET(m2_draw_core) && impl_->read_coverage_valid && impl_->batch_eligible &&
+      impl_->read_binding.bound_mask == next.bound_mask && impl_->read_write_mask == write_mask &&
+      impl_->read_binding.scale_x == next.scale_x && impl_->read_binding.scale_y == next.scale_y &&
+      Contains(impl_->read_rectangle, rectangle)) {
+    // Keep the per-draw extent proof above. Reuse only attachments that still
+    // fit it, in the same alias domain, with validated read coverage. Clears,
+    // resolves, growth, legacy bridges and submissions invalidate that proof.
+    bool reusable = true;
+    std::array<RenderTargetCache::RenderTarget*, 5> cached_targets{};
+    for (size_t index = 0; index < keys.size(); ++index) {
+      if (!(next.bound_mask & (1u << index))) continue;
+      SurfaceId id = impl_->read_binding.attachments[index];
+      SurfaceKey stamped = keys[index];
+      stamped.pitch_pixels = surface_info.surface_pitch;
+      stamped.msaa_samples_log2 = sample_log2;
+      stamped.scale_x = next.scale_x;
+      stamped.scale_y = next.scale_y;
+      if (!id || id > impl_->entries.size() ||
+          impl_->Stamp(stamped, false) != Result::kHandled) {
+        reusable = false;
+        break;
+      }
+      const auto& entry = impl_->entries[size_t(id - 1)];
+      if (!entry.backing || !(entry.key == stamped) || entry.extent.width < required.width ||
+          entry.extent.height < required.height) {
+        reusable = false;
+        break;
+      }
+      cached_targets[index] = static_cast<D3D12RenderTargetCache::D3D12RenderTarget*>(entry.backing);
+    }
+    if (reusable) {
+      host.SetCommandListRenderTargets(cached_targets.data());
+      impl_->binding = impl_->read_binding;
+      impl_->binding.written_rectangle = rectangle;
+      impl_->write_mask = write_mask;
+      if (cpu_scope.enabled()) ++impl_->cpu.setup_reuses;
+      return Result::kHandled;
+    }
+  }
+  std::array<RenderTargetCache::RenderTarget*, 5> targets{};
+  std::array<SurfaceView, 5> views{};
+  for (size_t index = 0; index < keys.size(); ++index) {
+    if (!(next.bound_mask & (1u << index))) {
+      continue;
+    }
+    auto& key = keys[index];
+    key.pitch_pixels = surface_info.surface_pitch;
+    key.msaa_samples_log2 = sample_log2;
+    key.scale_x = next.scale_x;
+    key.scale_y = next.scale_y;
+    Result created = GetOrCreate(key, required, aliases, next.attachments[index]);
+    if (created != Result::kHandled) {
+      impl_->write_mask = 0;
+      impl_->Diagnose("prepare-draw", "get-or-create", created, key, required, rectangle,
+                      next.attachments[index]);
+      return created;
+    }
+    next.resource_formats[index] = key.resource_format;
+    if (!GetView(next.attachments[index], views[index])) {
+      impl_->write_mask = 0;
+      return Result::kFailed;
+    }
+    targets[index] = static_cast<D3D12RenderTargetCache::D3D12RenderTarget*>(
+        GetBacking(next.attachments[index]));
+  }
+  const bool same_read_binding = impl_->read_coverage_valid && impl_->batch_eligible &&
+      impl_->read_binding.attachments == next.attachments &&
+      impl_->read_binding.bound_mask == next.bound_mask &&
+      impl_->read_binding.scale_x == next.scale_x && impl_->read_binding.scale_y == next.scale_y &&
+      impl_->read_write_mask == write_mask;
+  const bool reuse_reads = same_read_binding && Contains(impl_->read_rectangle, rectangle);
+  if (!reuse_reads) {
+    // Ownership readers must observe every preceding recorded draw. A new read
+    // rectangle starts fresh coverage; never fill the holes with a bounding box.
+    FlushPendingWrites(aliases);
+    impl_->read_coverage_valid = false;
+    impl_->batch_eligible = !AttachmentsMayOverlap(views, next.bound_mask, rectangle);
+    for (size_t index = 0; index < next.attachments.size(); ++index) {
+      if (!next.attachments[index] || Empty(rectangle)) continue;
+      Result loaded = aliases.PrepareRead(next.attachments[index], rectangle);
+      if (loaded != Result::kHandled) {
+        impl_->write_mask = 0;
+        bool log_registers = impl_->failure_diagnostics < 32;
+        impl_->Diagnose("prepare-draw", "prepare-read", loaded, views[index].key, required, rectangle,
+                        next.attachments[index]);
+        if (log_registers) {
+          REXGPU_ERROR("Native draw registers: surface={:08X} depth={:08X} color_mask={:08X} "
+                       "window_offset={:08X} window_tl={:08X} window_br={:08X} "
+                       "screen_tl={:08X} screen_br={:08X} clip={:08X} "
+                       "viewport_yoffset={} viewport_yscale={} attachment={}",
+                       surface_info.value, depth_control.value, color_mask,
+                       regs[XE_GPU_REG_PA_SC_WINDOW_OFFSET], regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL],
+                       regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR], regs[XE_GPU_REG_PA_SC_SCREEN_SCISSOR_TL],
+                       regs[XE_GPU_REG_PA_SC_SCREEN_SCISSOR_BR], regs[XE_GPU_REG_PA_CL_CLIP_CNTL],
+                       regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET),
+                       regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE), index);
+        }
+        return loaded;
+      }
+    }
+    impl_->read_binding = next;
+    impl_->read_write_mask = write_mask;
+    impl_->read_rectangle = rectangle;
+    impl_->read_coverage_valid = impl_->batch_eligible;
+  }
+  host.SetCommandListRenderTargets(targets.data());
+  impl_->binding = next;
+  impl_->write_mask = write_mask;
+  return Result::kHandled;
+}
+
+void SurfaceCache::CommitDraw(AliasCache& aliases) {
+  if (!Empty(impl_->binding.written_rectangle)) {
+    if (!impl_->batch_eligible) {
+      FlushPendingWrites(aliases);
+      // Potential physical attachment overlap preserves the original per-draw
+      // depth/color order, including retained float32 depth provenance.
+      for (size_t index = 0; index < impl_->binding.attachments.size(); ++index) {
+        if (impl_->write_mask & (1u << index))
+          aliases.NotifyWrite(impl_->binding.attachments[index], impl_->binding.written_rectangle);
+      }
+    } else if (impl_->write_mask) {
+      if (impl_->pending_write_mask &&
+          (impl_->pending_attachments != impl_->binding.attachments ||
+           impl_->pending_write_mask != impl_->write_mask)) FlushPendingWrites(aliases);
+      impl_->pending_attachments = impl_->binding.attachments;
+      impl_->pending_write_mask = impl_->write_mask;
+      for (size_t index = 0; index < impl_->binding.attachments.size(); ++index) {
+        if (impl_->write_mask & (1u << index))
+          AddExactRectangle(impl_->pending_rectangles[index], impl_->binding.written_rectangle);
+      }
+    }
+  }
+  impl_->write_mask = 0;
+  if (impl_->collapsed_active) impl_->families_locked = true;
+}
+
+void SurfaceCache::FlushPendingWrites(AliasCache& aliases) {
+  if (!impl_->pending_write_mask) return;
+  const auto attachments = impl_->pending_attachments;
+  const uint32_t write_mask = impl_->pending_write_mask;
+  auto rectangles = std::move(impl_->pending_rectangles);
+  // Detach before notifications: alias read/mutation entrypoints may themselves
+  // request a flush, while NotifyWrite deliberately never does so.
+  impl_->pending_write_mask = 0;
+  impl_->pending_attachments = {};
+  impl_->pending_rectangles = {};
+  for (size_t index = 0; index < attachments.size(); ++index) {
+    if (!(write_mask & (1u << index))) continue;
+    for (Rect rectangle : rectangles[index]) aliases.NotifyWrite(attachments[index], rectangle);
+  }
+}
+
+Result SurfaceCache::CanApplyResolveClear(const draw_util::ResolveInfo& info,
+                                          const TilingState& tiling) const {
+  if (!info.IsClearingDepth() && !info.IsClearingColor()) {
+    return Result::kHandled;
+  }
+  const auto& host = impl_->host;
+  auto surface = host.register_file().Get<reg::RB_SURFACE_INFO>();
+  // Merged tile clears require an explicit band-to-scene mapping; no inferred
+  // whole-scene clear may erase the other bands.
+  if (tiling.merging()) {
+    return Result::kNeedsLegacy;
+  }
+  if (!surface.surface_pitch || surface.surface_pitch > xenos::kTexture2DCubeMaxWidthHeight ||
+      uint32_t(surface.msaa_samples) > 2 || info.source_x > surface.surface_pitch ||
+      uint64_t(info.source_y) + uint64_t(info.height_div_8) * 8 >
+          D3D12_REQ_TEXTURE2D_U_OR_V_DIMENSION / host.draw_resolution_scale_y()) {
+    return Result::kNeedsLegacy;
+  }
+  if (info.IsClearingDepth() &&
+      host.GetDepthResourceDXGIFormat(xenos::DepthRenderTargetFormat(info.depth_edram_info.format)) ==
+          DXGI_FORMAT_UNKNOWN) {
+    return Result::kNeedsLegacy;
+  }
+  if (info.IsClearingColor() &&
+      host.GetColorResourceDXGIFormat(host.GetColorResourceFormat(
+          xenos::ColorRenderTargetFormat(info.color_edram_info.format))) == DXGI_FORMAT_UNKNOWN) {
+    return Result::kNeedsLegacy;
+  }
+  return Result::kHandled;
+}
+
+Result SurfaceCache::PrepareResolveClear(const draw_util::ResolveInfo& info,
+                                         AliasCache& aliases, const TilingState& tiling) {
+  FlushPendingWrites(aliases);
+  impl_->clear_prepared = false;
+  Result preflight = CanApplyResolveClear(info, tiling);
+  if (preflight != Result::kHandled || (!info.IsClearingDepth() && !info.IsClearingColor())) {
+    return preflight;
+  }
+  auto& host = impl_->host;
+  auto surface = host.register_file().Get<reg::RB_SURFACE_INFO>();
+  Rect rectangle{info.source_x, info.source_y,
+                 uint32_t(std::min(uint64_t(surface.surface_pitch),
+                                   uint64_t(info.source_x) + uint64_t(info.coordinate_info.width_div_8) * 8)),
+                 info.source_y + info.height_div_8 * 8};
+  if (Empty(rectangle)) {
+    return Result::kHandled;
+  }
+  std::array<SurfaceId, 2> ids{};
+  for (size_t index = 0; index < ids.size(); ++index) {
+    if (index ? !info.IsClearingColor() : !info.IsClearingDepth()) {
+      continue;
+    }
+    SurfaceKey key;
+    key.base_tiles = index ? info.color_original_base : info.depth_original_base;
+    key.pitch_pixels = surface.surface_pitch;
+    key.resource_format = index ? uint32_t(host.GetColorResourceFormat(
+                                       xenos::ColorRenderTargetFormat(info.color_edram_info.format)))
+                                : uint32_t(info.depth_edram_info.format);
+    key.msaa_samples_log2 = uint32_t(surface.msaa_samples);
+    key.scale_x = host.draw_resolution_scale_x();
+    key.scale_y = host.draw_resolution_scale_y();
+    key.is_depth = index == 0;
+    Result created = GetOrCreate(key, {key.pitch_pixels, rectangle.bottom}, aliases, ids[index]);
+    if (created != Result::kHandled) {
+      return Result::kFailed;
+    }
+    // Only the partially covered boundary tiles need old contents. Fully
+    // overwritten interior tiles must not pay an unnecessary alias conversion.
+    for (Rect edge : ClearPreservationEdges(key, rectangle)) {
+      Result loaded = aliases.PrepareRead(ids[index], edge);
+      if (loaded != Result::kHandled) {
+        return Result::kFailed;
+      }
+    }
+  }
+  impl_->clear_signature = ClearSignature(info, surface.value);
+  impl_->clear_ids = ids;
+  impl_->clear_rectangle = rectangle;
+  impl_->clear_prepared = true;
+  return Result::kHandled;
+}
+
+Result SurfaceCache::ApplyResolveClear(const draw_util::ResolveInfo& info,
+                                       AliasCache& aliases, const TilingState& tiling) {
+  FlushPendingWrites(aliases);
+  Result preflight = CanApplyResolveClear(info, tiling);
+  if (preflight != Result::kHandled || (!info.IsClearingDepth() && !info.IsClearingColor())) {
+    return preflight;
+  }
+  auto& host = impl_->host;
+  auto surface = host.register_file().Get<reg::RB_SURFACE_INFO>();
+  if (!impl_->clear_prepared || impl_->clear_signature != ClearSignature(info, surface.value)) {
+    Result prepared = PrepareResolveClear(info, aliases, tiling);
+    if (prepared != Result::kHandled) {
+      return prepared;
+    }
+  }
+  if (!impl_->clear_prepared) {
+    return Result::kHandled;
+  }
+  auto ids = impl_->clear_ids;
+  Rect rectangle = impl_->clear_rectangle;
+  impl_->clear_prepared = false;
+  std::array<RenderTargetCache::RenderTarget*, 2> targets{};
+  for (size_t index = 0; index < ids.size(); ++index) {
+    if (ids[index]) {
+      targets[index] = static_cast<D3D12RenderTargetCache::D3D12RenderTarget*>(GetBacking(ids[index]));
+    }
+  }
+  const uint64_t values[2] = {
+      info.rb_depth_clear,
+      info.rb_color_clear | (uint64_t(info.rb_color_clear_lo) << 32)};
+  const RenderTargetCache::Transfer::Rectangle clear_rectangle{
+      rectangle.left, rectangle.top, rectangle.right - rectangle.left,
+      rectangle.bottom - rectangle.top};
+  const std::vector<RenderTargetCache::Transfer> transfers[2];
+  if (!host.PerformTransfersAndResolveClears(2, targets.data(), transfers, values, &clear_rectangle)) {
+    return Result::kFailed;
+  }
+  for (size_t index = 0; index < ids.size(); ++index) {
+    if (ids[index]) {
+      aliases.NotifyClear(ids[index], rectangle, values[index]);
+    }
+  }
+  InvalidateBindings();
+  return Result::kHandled;
+}
+
+}  // namespace rex::graphics::d3d12::native_rt
