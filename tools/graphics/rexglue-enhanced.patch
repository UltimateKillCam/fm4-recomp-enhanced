+void D3D12RenderTargetCache::ClearCache() {
+  FlushNativePendingWrites();
+  RenderTargetCache::ClearCache();
+  if (!native_rt_) return;
+  // Logical resources carry persistent content just as legacy current owners
+  // do. Preserve them, reclaim retired allocations, and rebind next draw.
+  CompletedSubmissionUpdated();
+  InvalidateCommandListRenderTargets();
+}
