+  D3D12_CPU_DESCRIPTOR_HANDLE srv{};
+  D3D12_CPU_DESCRIPTOR_HANDLE stencil_srv{};
+  uint32_t host_sample_count = 1;
+  D3D12_RESOURCE_STATES resource_state = D3D12_RESOURCE_STATE_COMMON;
+};
+
+// An explicit mapping between one logical surface and the guest's current
+// physical EDRAM window. No modulo wrapping is implicit in logical rectangles.
+struct LegacySpan {
+  SurfaceId surface = kInvalidSurface;
+  Rect rectangle{};
+  uint32_t legacy_base_tiles = 0;
+  uint32_t legacy_pitch_tiles = 0;
+  uint32_t first_tile = 0, end_tile = 0;
+  bool may_write = false;
+};
+struct LegacyTransaction { uint64_t serial = 0; };
+
+struct DrawBinding {
+  // Depth first, followed by four color attachments, matching the existing PSO.
+  std::array<SurfaceId, 5> attachments{};
+  std::array<uint32_t, 5> resource_formats{};
+  uint32_t bound_mask = 0;
+  uint32_t scale_x = 1, scale_y = 1;
+  Rect written_rectangle{};
+};
+
+}  // namespace rex::graphics::d3d12::native_rt
